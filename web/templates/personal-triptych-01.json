{
  "meta": {
    "id": "personal-triptych-01",
    "name": "Triptych Card",
    "nameI18n": {
      "zh": "三联卡",
      "en": "Triptych Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.09,
      "bottom": 0.3,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.012,
    "shadow": {
      "enabled": true,
      "blur": 0.05,
      "opacity": 0.15,
      "offsetX": 0,
      "offsetY": 0.012
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.0763,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.152
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0014
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Great Vibes",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'YOUR NAME'",
        "fallback": "YOUR NAME",
        "role": "support"
      },
      {
        "expr": "'PARAMS'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "'SIGNATURE'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
