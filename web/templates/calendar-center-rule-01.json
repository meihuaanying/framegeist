{
  "meta": {
    "id": "calendar-center-rule-01",
    "name": "Center Day Rules",
    "nameI18n": {
      "zh": "居中日历",
      "en": "Center Day Rules"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.12,
      "bottom": 0.28,
      "left": 0.12
    },
    "background": {
      "type": "solid",
      "color": "#FAF7F2"
    }
  },
  "layers": [
    {
      "type": "calendar",
      "id": "monthgrid",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.03
      },
      "size": 0.16,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "showWeekdays": true,
      "view": "month",
      "color": "#A39C8D",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter"
      ]
    },
    {
      "type": "shape",
      "id": "rule-left",
      "anchor": "bottom-center",
      "offset": {
        "x": -0.085,
        "y": -0.16
      },
      "shape": "line",
      "size": {
        "width": 0.085,
        "height": 0.0015
      },
      "color": "#D8D2C6"
    },
    {
      "type": "shape",
      "id": "rule-right",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.085,
        "y": -0.16
      },
      "shape": "line",
      "size": {
        "width": 0.085,
        "height": 0.0015
      },
      "color": "#D8D2C6"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('DD', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "date('YYYY年MM月DD日', exif.datetime) · exif.weekday_cn",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
