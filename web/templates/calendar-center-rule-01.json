{
  "meta": {
    "id": "calendar-center-rule-01",
    "name": "Center Day Rules",
    "nameI18n": {
      "zh": "居中日历",
      "en": "Center Day Rules"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.12,
      "bottom": 0.28,
      "left": 0.12
    },
    "background": {
      "type": "solid",
      "color": "#FAF7F2"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.035
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'CALENDAR · FRAMEGEIST'",
          "fallback": null
        }
      ]
    },
    {
      "type": "calendar",
      "id": "monthgrid",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.03
      },
      "size": 0.16,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "showWeekdays": true,
      "view": "month",
      "color": "#A39C8D",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter"
      ]
    },
    {
      "type": "shape",
      "id": "rule-left",
      "anchor": "bottom-center",
      "offset": {
        "x": -0.085,
        "y": -0.16
      },
      "shape": "line",
      "size": {
        "width": 0.085,
        "height": 0.0015
      },
      "color": "#D8D2C6"
    },
    {
      "type": "shape",
      "id": "rule-right",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.085,
        "y": -0.16
      },
      "shape": "line",
      "size": {
        "width": 0.085,
        "height": 0.0015
      },
      "color": "#D8D2C6"
    },
    {
      "type": "text",
      "id": "bigday",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.08
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.18,
        "color": "#1A1A1A",
        "weight": 400
      },
      "letterSpacing": 0.01,
      "align": "center",
      "content": [
        {
          "expr": "date('DD', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "dateweek",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.042
      },
      "font": {
        "family": [
          "LXGW WenKai"
        ],
        "size": 0.0192,
        "color": "#373A40",
        "weight": 400
      },
      "letterSpacing": 0.06,
      "lineHeight": 1.5,
      "align": "center",
      "content": [
        {
          "expr": "date('YYYY年MM月DD日', exif.datetime)",
          "fallback": null
        },
        {
          "expr": "exif.weekday_cn",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.105
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.065
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
