{
  "meta": {
    "id": "colorwalk-round-card-01",
    "name": "Round Card",
    "nameI18n": {
      "zh": "圆角卡片",
      "en": "Round Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.09,
      "bottom": 0.27,
      "left": 0.09
    },
    "background": {
      "type": "tint"
    },
    "radius": 0.045,
    "shadow": {
      "enabled": true,
      "blur": 0.13,
      "opacity": 0.36,
      "offsetX": 0,
      "offsetY": 0.03
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.076,
        "y": 0.038
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.076,
        "y": -0.1427
      },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
