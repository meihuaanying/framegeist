{
  "meta": {
    "id": "festival-gold-frame-01",
    "name": "Gold Frame",
    "nameI18n": {
      "zh": "庆典金框",
      "en": "Gold Frame"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.1,
      "bottom": 0.22,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#C8102E"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "frame-outer",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.008
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 1
      },
      "color": "#F2C94C",
      "strokeWidth": 0.0022
    },
    {
      "type": "shape",
      "id": "frame-inner",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.008
      },
      "shape": "rect",
      "size": {
        "width": 0.96,
        "height": 0.96
      },
      "color": "#F2C94C",
      "strokeWidth": 0.0012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#F2C94C",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'喜乐常在'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
