{
  "meta": {
    "id": "camera-corner-body-03",
    "name": "Corner Body",
    "nameI18n": { "zh": "右上机身", "en": "Corner Body" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.20, "right": 0.08, "bottom": 0.16, "left": 0.08 },
    "background": { "type": "solid", "color": "#EFEAE1" }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-right",
      "offset": { "x": -0.05, "y": 0.030 },
      "asset": "@builtin/frame/camera-body",
      "size": { "height": 0.19 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.055, "y": 0.045 },
      "font": { "family": ["Inter"], "size": 0.020, "color": "#1A1A1A" },
      "letterSpacing": 0.05,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-left",
      "offset": { "x": 0.055, "y": 0.082 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "#6B7280" },
      "letterSpacing": 0.05,
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": { "x": 0.055, "y": -0.045 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.018 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": { "x": -0.055, "y": -0.062 },
      "font": { "family": ["Inter"], "size": 0.0135, "color": "#373A40" },
      "letterSpacing": 0.03,
      "align": "right",
      "content": [{ "expr": "exif.lens", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.055, "y": -0.033 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#8E9298" },
      "letterSpacing": 0.12,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
