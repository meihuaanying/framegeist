{
  "meta": {
    "id": "camera-corner-body-03",
    "name": "Corner Body",
    "nameI18n": {
      "zh": "右上机身",
      "en": "Corner Body"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.2,
      "right": 0.08,
      "bottom": 0.16,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#EFEAE1"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.03
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.19
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.045
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.024,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.082
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.015,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.045
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.062
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0162,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.033
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#8E9298",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
