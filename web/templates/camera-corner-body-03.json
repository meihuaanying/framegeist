{
  "meta": {
    "id": "camera-corner-body-03",
    "name": "Corner Body",
    "nameI18n": {
      "zh": "右上机身",
      "en": "Corner Body"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.2,
      "right": 0.08,
      "bottom": 0.16,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#EFEAE1"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.03
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.19
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.045
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
