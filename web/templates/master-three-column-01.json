{
  "meta": {
    "id": "master-three-column-01",
    "name": "Three Columns",
    "nameI18n": { "zh": "三列数值格", "en": "Three Columns" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "master"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.12, "right": 0.085, "bottom": 0.3, "left": 0.085 },
    "background": { "type": "solid", "color": "#F2F0EC" }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.026 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.026 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": { "x": 0.07265, "y": 0.03 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "top-right",
      "offset": { "x": -0.07265, "y": 0.022 },
      "asset": "@builtin/frame/seal-red",
      "size": { "height": 0.045 },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": { "x": 0.07265, "y": -0.178 },
      "shape": "line",
      "size": { "width": 1.0, "height": 0.0014 },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.165 },
      "font": { "family": ["Inter"], "size": 0.013, "color": "#373A40" },
      "letterSpacing": 0.06,
      "align": "center",
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "iso",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.132 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "align": "center",
      "content": [{ "expr": "fmt('ISO{iso}', exif)", "fallback": "--" }]
    },
    {
      "type": "shape",
      "id": "div-a",
      "anchor": "bottom-left",
      "offset": { "x": 0.345, "y": -0.093 },
      "shape": "rect",
      "size": { "width": 0.0012, "height": 0.075 },
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "div-b",
      "anchor": "bottom-left",
      "offset": { "x": 0.63, "y": -0.093 },
      "shape": "rect",
      "size": { "width": 0.0012, "height": 0.075 },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "val-focal",
      "anchor": "bottom-left",
      "offset": { "x": 0.07265, "y": -0.095 },
      "font": { "family": ["Oswald"], "size": 0.028, "color": "#1A1A1A" },
      "letterSpacing": 0.01,
      "content": [{ "expr": "fmt('{focal}MM', exif)", "fallback": "--" }]
    },
    {
      "type": "text",
      "id": "val-aperture",
      "anchor": "bottom-left",
      "offset": { "x": 0.38, "y": -0.095 },
      "font": { "family": ["Oswald"], "size": 0.028, "color": "#1A1A1A" },
      "letterSpacing": 0.01,
      "content": [{ "expr": "fmt('F{aperture}', exif)", "fallback": "--" }]
    },
    {
      "type": "text",
      "id": "val-shutter",
      "anchor": "bottom-left",
      "offset": { "x": 0.68, "y": -0.095 },
      "font": { "family": ["Oswald"], "size": 0.028, "color": "#1A1A1A" },
      "letterSpacing": 0.01,
      "content": [{ "expr": "exif.shutter", "fallback": "--" }]
    },
    {
      "type": "text",
      "id": "lab-focal",
      "anchor": "bottom-left",
      "offset": { "x": 0.07265, "y": -0.062 },
      "font": { "family": ["Inter"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "content": [{ "expr": "'FL'" }]
    },
    {
      "type": "text",
      "id": "lab-aperture",
      "anchor": "bottom-left",
      "offset": { "x": 0.38, "y": -0.062 },
      "font": { "family": ["Inter"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "content": [{ "expr": "'Aperture'" }]
    },
    {
      "type": "text",
      "id": "lab-shutter",
      "anchor": "bottom-left",
      "offset": { "x": 0.68, "y": -0.062 },
      "font": { "family": ["Inter"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "content": [{ "expr": "'Shutter'" }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
