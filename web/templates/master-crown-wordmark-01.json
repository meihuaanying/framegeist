{
  "meta": {
    "id": "master-crown-wordmark-01",
    "name": "Crown Wordmark",
    "nameI18n": {
      "zh": "顶冠底铭",
      "en": "Crown Wordmark"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "master"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.085,
      "bottom": 0.26,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "script",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.092
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0264,
        "color": "#1A1A1A",
        "weight": 500
      },
      "align": "center",
      "content": [
        {
          "expr": "'with light'"
        }
      ],
      "letterSpacing": 0
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.244,
        "y": -0.13
      },
      "shape": "line",
      "size": {
        "width": 0.6,
        "height": 0.0014
      },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.155
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "wordmark",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.105
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0264,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.22,
      "align": "center",
      "effects": {
        "fill": {
          "mode": "foil",
          "colors": [
            "#8A6A1F",
            "#F6E27A",
            "#D4A017",
            "#FBF0B0"
          ],
          "angle": 100,
          "intensity": 0.9
        },
        "relief": {
          "mode": "emboss",
          "depth": 0.04,
          "highlight": "#FFF7D6",
          "shadow": "#4A3200",
          "opacity": 0.5
        }
      },
      "content": [
        {
          "expr": "'PHOTOGRAPHIC WORKS'"
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.06
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.07265,
        "y": -0.026
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
