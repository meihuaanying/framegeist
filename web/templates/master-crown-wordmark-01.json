{
  "meta": {
    "id": "master-crown-wordmark-01",
    "name": "Crown Wordmark",
    "nameI18n": {
      "zh": "顶冠底铭",
      "en": "Crown Wordmark"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "master"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.085,
      "bottom": 0.26,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.244,
        "y": -0.13
      },
      "shape": "line",
      "size": {
        "width": 0.6,
        "height": 0.0014
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'with light'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'PHOTOGRAPHIC WORKS'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
