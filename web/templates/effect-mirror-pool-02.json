{
  "meta": {
    "id": "effect-mirror-pool-02",
    "name": "Mirror Pool",
    "nameI18n": {
      "zh": "镜池倒影",
      "en": "Mirror Pool"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.1,
      "bottom": 0.44,
      "left": 0.1
    },
    "background": {
      "type": "blur",
      "blur": 80,
      "scale": 1.25
    },
    "radius": 0.045,
    "shadow": {
      "enabled": true,
      "blur": 0.14,
      "opacity": 0.3,
      "offsetX": 0,
      "offsetY": 0.04
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "pool-outer",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.295
      },
      "shape": "rect",
      "size": {
        "width": 0.95,
        "height": 0.16
      },
      "color": "#FFFFFF",
      "opacity": 0.08,
      "radius": 0.5
    },
    {
      "type": "shape",
      "id": "pool-inner",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.295
      },
      "shape": "rect",
      "size": {
        "width": 0.78,
        "height": 0.1
      },
      "color": "#FFFFFF",
      "opacity": 0.05,
      "radius": 0.5
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0204,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.068
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.042
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
