{
  "meta": {
    "id": "phone-camera-ui-01",
    "name": "Camera UI",
    "nameI18n": {
      "zh": "相机界面卡",
      "en": "Camera UI"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.2,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#EDEEF0"
    },
    "radius": 0.015,
    "shadow": {
      "enabled": true,
      "blur": 0.06,
      "opacity": 0.18,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "statusdot",
      "anchor": "top-left",
      "offset": {
        "x": 0.0536,
        "y": 0.025
      },
      "shape": "ellipse",
      "size": {
        "width": 0.008,
        "height": 0.01
      },
      "color": "#E10600"
    },
    {
      "type": "shape",
      "id": "statusrule",
      "anchor": "top-left",
      "offset": {
        "x": 0.0536,
        "y": 0.0485
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#DCDFE3"
    },
    {
      "type": "shape",
      "id": "progressbar",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.0417
      },
      "shape": "rect",
      "size": {
        "width": 0.3,
        "height": 0.0025
      },
      "color": "#9AA0A6",
      "opacity": 0.6
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0536,
        "y": -0.1062
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "exif.shutter",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('F{aperture}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
