{
  "meta": {
    "id": "portfolio-noir-matte-01",
    "name": "Noir Matte",
    "nameI18n": {
      "zh": "黑白展陈",
      "en": "Noir Matte"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.18,
      "right": 0.16,
      "bottom": 0.3,
      "left": 0.16
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "kicker",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.142
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0095,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.24,
      "align": "center",
      "content": [
        {
          "expr": "'MONOCHROME STUDIES'",
          "fallback": null
        }
      ]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.192
      },
      "shape": "line",
      "size": {
        "width": 0.1,
        "height": 0.0015
      },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.168
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.05,
        "color": "#1A1A1A",
        "weight": 600
      },
      "letterSpacing": 0.02,
      "align": "center",
      "content": [
        {
          "expr": "'《寂》'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.04
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
