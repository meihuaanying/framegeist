{
  "meta": {
    "id": "portfolio-noir-matte-01",
    "name": "Noir Matte",
    "nameI18n": { "zh": "黑白展陈", "en": "Noir Matte" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.18, "right": 0.16, "bottom": 0.30, "left": 0.16 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "kicker",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.142 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.24,
      "align": "center",
      "content": [{ "expr": "'MONOCHROME STUDIES'", "fallback": null }]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.192 },
      "shape": "line",
      "size": { "width": 0.10, "height": 0.0015 },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.168 },
      "font": { "family": ["Noto Serif SC"], "size": 0.05, "color": "#1A1A1A" },
      "letterSpacing": 0.05,
      "align": "center",
      "content": [{ "expr": "'《寂》'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#9AA0A6" },
      "letterSpacing": 0.12,
      "align": "center",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.045, "y": -0.045 },
      "font": { "family": ["Inter"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.045, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#9AA0A6" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
