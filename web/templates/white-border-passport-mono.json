{
  "meta": {
    "id": "white-border-passport-mono",
    "name": "Passport Mono",
    "nameI18n": {
      "zh": "档案打字机",
      "en": "Passport Mono"
    },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.3,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.225
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "passportbox",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.022
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.235
      },
      "color": "#D9DCE1",
      "strokeWidth": 0.0015,
      "radius": 0.02
    },
    {
      "type": "text",
      "id": "camline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.084,
        "y": -0.135
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#1A1A1A"
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "fmt('CAMERA — {model_pretty}', exif)",
          "fallback": "CAMERA — UNKNOWN"
        }
      ]
    },
    {
      "type": "text",
      "id": "dateline",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.084,
        "y": -0.135
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "lensline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.084,
        "y": -0.065
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.04,
      "content": [
        {
          "expr": "fmt('LENS — {lens}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "paramline",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.084,
        "y": -0.065
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "lens": {
      "type": "string",
      "source": "exif"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
