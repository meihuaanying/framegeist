{
  "meta": {
    "id": "white-border-passport-mono",
    "name": "Passport Mono",
    "nameI18n": {
      "zh": "档案打字机",
      "en": "Passport Mono"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.3,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.225
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "passportbox",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.022
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.235
      },
      "color": "#D9DCE1",
      "strokeWidth": 0.0015,
      "radius": 0.02
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "lens": {
      "type": "string",
      "source": "exif"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "fmt('CAMERA — {model_pretty}', exif)",
        "fallback": "CAMERA — UNKNOWN",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('LENS — {lens}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
