{
  "meta": {
    "id": "art-gilt-foil",
    "name": "Gilt Foil",
    "nameI18n": {
      "zh": "烫金箔",
      "en": "Gilt Foil"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.045,
      "right": 0.05,
      "bottom": 0.24,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#141414"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "foil-frame",
      "anchor": "middle-center",
      "shape": "rect",
      "size": {
        "width": 0.9,
        "height": 0.9
      },
      "color": "#8A6E2F",
      "opacity": 0.75,
      "strokeWidth": 0.0011,
      "frame": "outer",
      "margin": 0.028,
      "z": -1
    },
    {
      "type": "shape",
      "id": "foil-rule",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.183
      },
      "shape": "line",
      "size": {
        "width": 0.36,
        "height": 0.0012
      },
      "color": "#B8860B",
      "opacity": 0.8,
      "double": true,
      "gap": 0.004
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#F5D67B",
    "font": {
      "family": [
        "Glow Sans SC",
        "Fraunces",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'Gilded Light'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'鎏金时刻'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'Fine Art Edition · Number One'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
