{
  "meta": {
    "id": "art-gilt-foil",
    "name": "Gilt Foil",
    "nameI18n": {
      "zh": "烫金箔",
      "en": "Gilt Foil"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.045,
      "right": 0.05,
      "bottom": 0.24,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#141414"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "foil-frame",
      "anchor": "middle-center",
      "shape": "rect",
      "size": {
        "width": 0.9,
        "height": 0.9
      },
      "color": "#8A6E2F",
      "opacity": 0.75,
      "strokeWidth": 0.0011,
      "frame": "outer",
      "margin": 0.028,
      "z": -1
    },
    {
      "type": "text",
      "id": "foil-overline",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.0175
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#7A6A4A",
        "weight": 500
      },
      "letterSpacing": 0.3,
      "align": "center",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "'Fine Art Edition · Number One'",
          "fallback": null
        }
      ]
    },
    {
      "type": "shape",
      "id": "foil-rule",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.183
      },
      "shape": "line",
      "size": {
        "width": 0.36,
        "height": 0.0012
      },
      "color": "#B8860B",
      "opacity": 0.8,
      "double": true,
      "gap": 0.004
    },
    {
      "type": "text",
      "id": "foil-title",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.135
      },
      "font": {
        "family": [
          "Fraunces"
        ],
        "size": 0.055,
        "color": "#F5D67B",
        "weight": 600
      },
      "letterSpacing": 0.14,
      "effects": {
        "case": "upper",
        "fill": {
          "mode": "foil",
          "colors": [
            "#F5D67B",
            "#B8860B",
            "#FFE9A8"
          ],
          "angle": 105,
          "intensity": 0.9
        },
        "shadow": {
          "offsetX": 0.008,
          "offsetY": 0.018,
          "blur": 0.07,
          "color": "#000000",
          "opacity": 0.55
        }
      },
      "content": [
        {
          "expr": "'Gilded Light'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "foil-title-zh",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.075
      },
      "font": {
        "family": [
          "Glow Sans SC"
        ],
        "size": 0.0264,
        "color": "#C9A24B",
        "weight": 500
      },
      "letterSpacing": 0.34,
      "content": [
        {
          "expr": "'鎏金时刻'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "foil-model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#B8964A",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unsigned Print')",
          "fallback": "Unsigned Print"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "foil-date",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#B8964A",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": "Private Collection"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "foil-params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#B8964A",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "align": "right",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "fmt('{focal}MM · F/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": "Archival Pigment · No. 01"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ]
}
