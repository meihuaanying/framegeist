      },
      "color": "#E8E4DA",
      "opacity": 0.7,
      "rotation": 315
    },
    {
      "type": "shape",
      "id": "ring-mid",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.357
      },
      "shape": "ellipse",
      "size": {
        "width": 0.16,
        "height": 0.24
      },
      "color": "#E8E4DA",
      "opacity": 0.5,
      "strokeWidth": 0.0028
    },
    {
      "type": "shape",
      "id": "ring-inner",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.357
      },
      "shape": "ellipse",
      "size": {
        "width": 0.093,
        "height": 0.14
      },
      "color": "#E8E4DA",
      "opacity": 0.3,
      "strokeWidth": 0.002
    },
    {
      "type": "shape",
      "id": "iris",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.357
      },
      "shape": "ellipse",
      "size": {
        "width": 0.053,
        "height": 0.08
      },
      "color": "#E8C06A",
      "opacity": 0.95
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.13
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.019,
        "color": "#F0EFEA",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.165
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0115,
        "color": "#9BA0A8",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.13
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0125,
        "color": "#C6CAD1",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
