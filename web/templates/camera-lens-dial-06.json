{
  "meta": {
    "id": "camera-lens-dial-06",
    "name": "Lens Dial",
    "nameI18n": {
      "zh": "镜头圈刻度",
      "en": "Lens Dial"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.44,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#131317"
    },
    "radius": 0.025,
    "shadow": {
      "enabled": true,
      "blur": 0.12,
      "opacity": 0.35,
      "offsetX": 0,
      "offsetY": 0.03
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.03
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.016
      },
      "tint": "light"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.055,
        "y": 0.034
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0115,
        "color": "#A7ABB3",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "ring-outer",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.357
      },
      "shape": "ellipse",
      "size": {
        "width": 0.227,
        "height": 0.34
      },
      "color": "#E8E4DA",
      "opacity": 0.85,
      "strokeWidth": 0.004
    },
    {
