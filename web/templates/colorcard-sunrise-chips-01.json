{
  "meta": {
    "id": "colorcard-sunrise-chips-01",
    "name": "Sunrise Chips",
    "nameI18n": {
      "zh": "暖阳色卡",
      "en": "Sunrise Chips"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.08,
      "bottom": 0.26,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F6E8DC"
    },
    "radius": 0.04,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.26,
      "offsetX": 0,
      "offsetY": 0.025
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#7A6A5D",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9A8B7E",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.14
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0204,
        "color": "#4A4038",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.075
      },
      "count": 6,
      "shape": "circle",
      "direction": "horizontal",
      "size": 0.034,
      "gap": 0.014,
      "showHex": true,
      "label": {
        "size": 0.011,
        "color": "#4A4038",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
