{
  "meta": {
    "id": "camera-series-emblem-07",
    "name": "Series Emblem",
    "nameI18n": {
      "zh": "机身系列徽章",
      "en": "Series Emblem"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.24,
      "right": 0.07,
      "bottom": 0.28,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FBF8F1"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.04
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.17
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.115
      },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.078
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.06,
        "y": -0.105
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
