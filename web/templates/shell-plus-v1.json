{
  "meta": {
    "id": "shell-plus-v1",
    "name": "Body Outline 1",
    "nameI18n": {
      "zh": "机身轮廓 1",
      "en": "Body Outline 1"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "frame-shell"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.07,
      "right": 0.06,
      "bottom": 0.14,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#101014"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body-art",
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.34
      },
      "anchor": "middle-right",
      "offset": {
        "x": -0.03,
        "y": 0
      },
      "opacity": 0.14,
      "tint": "light"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.028,
        "weight": 600,
        "color": "#EDEDF0"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.024
      },
      "anchor": "bottom-left",
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.017,
        "weight": 400,
        "color": "#EDEDF0"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.09
      }
    },
    {
      "type": "image",
      "id": "series",
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.024
      },
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.035
      },
      "tint": "light"
    }
  ]
}
