{
  "meta": {
    "id": "sports-finish-line-01",
    "name": "Finish Line",
    "nameI18n": {
      "zh": "终点线",
      "en": "Finish Line"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.07,
      "bottom": 0.1,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "finishline1",
      "anchor": "top-left",
      "offset": {
        "x": 0.0614,
        "y": 0.0605
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0012
      },
      "color": "#1A1A1A"
    },
    {
      "type": "shape",
      "id": "finishline2",
      "anchor": "top-left",
      "offset": {
        "x": 0.0614,
        "y": 0.0661
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0008
      },
      "color": "#1A1A1A",
      "opacity": 0.4
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "weekday": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#373A40",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": "RACE DAY",
        "role": "detail"
      },
      {
        "expr": "'RIVERSIDE LOOP'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
