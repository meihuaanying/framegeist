{
  "meta": {
    "id": "colorwalk-ribbon-01",
    "name": "Ink Ribbon",
    "nameI18n": { "zh": "墨色横带", "en": "Ink Ribbon" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.09, "right": 0.06, "bottom": 0.25, "left": 0.06 },
    "background": { "type": "tint" }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.0536, "y": 0.035 },
      "font": { "family": ["Inter"], "size": 0.016, "color": "auto" },
      "letterSpacing": 0.08,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "day",
      "anchor": "top-right",
      "offset": { "x": -0.0536, "y": 0.035 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.14,
      "opacity": 0.85,
      "align": "right",
      "content": [
        { "expr": "if_empty(exif.weekday, 'UNDATED')", "fallback": "UNDATED" }
      ]
    },
    {
      "type": "shape",
      "id": "band",
      "anchor": "bottom-left",
      "offset": { "x": 0.0536, "y": -0.06 },
      "shape": "rect",
      "size": { "width": 1.0, "height": 0.13 },
      "color": "#17181A",
      "opacity": 0.96,
      "radius": 0.045
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": { "x": 0.082, "y": -0.10 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.164 },
      "font": { "family": ["JetBrains Mono"], "size": 0.013, "color": "auto" },
      "letterSpacing": 0.12,
      "opacity": 0.95,
      "align": "center",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.082, "y": -0.164 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.04,
      "opacity": 0.85,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
