{
  "meta": {
    "id": "festival-moon-full-01",
    "name": "Full Moon",
    "nameI18n": {
      "zh": "中秋月满",
      "en": "Full Moon"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.1,
      "bottom": 0.26,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#221C16"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "moon",
      "anchor": "top-right",
      "offset": {
        "x": -0.06,
        "y": 0.018
      },
      "shape": "ellipse",
      "size": {
        "width": 0.1,
        "height": 0.1
      },
      "color": "#E8C66A"
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.155
      },
      "shape": "line",
      "size": {
        "width": 0.18,
        "height": 0.0015
      },
      "color": "#8A6F3A"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#E8C66A",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'团圆'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'月满人间 · 团圆安康'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
