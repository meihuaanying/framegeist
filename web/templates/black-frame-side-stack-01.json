{
  "meta": {
    "id": "black-frame-side-stack-01",
    "name": "Side Stack",
    "nameI18n": {
      "zh": "右侧参数",
      "en": "Side Stack"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.22,
      "bottom": 0.1,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#1A1A1A"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rail",
      "anchor": "middle-right",
      "offset": {
        "x": -0.23,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.6
      },
      "color": "#33353A"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#EDEDED",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM', exif) · fmt('F{aperture}', exif) · exif.shutter · fmt('ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
