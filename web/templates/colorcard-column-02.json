{
  "meta": {
    "id": "colorcard-column-02",
    "name": "Night Column",
    "nameI18n": {
      "zh": "夜幕色柱",
      "en": "Night Column"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.3,
      "bottom": 0.14,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#1C1C1E"
    },
    "radius": 0.03,
    "shadow": {
      "enabled": true,
      "blur": 0.12,
      "opacity": 0.4,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.07,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "middle-right",
      "offset": {
        "x": -0.1,
        "y": 0.02
      },
      "count": 5,
      "shape": "square",
      "direction": "vertical",
      "size": 0.036,
      "gap": 0.016,
      "showHex": true,
      "label": {
        "size": 0.0095,
        "color": "#C9CCD2",
        "family": [
          "JetBrains Mono"
        ]
      }
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F0EFEA",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
