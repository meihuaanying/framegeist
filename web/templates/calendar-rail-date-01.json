{
  "meta": {
    "id": "calendar-rail-date-01",
    "name": "Side Rail Date",
    "nameI18n": {
      "zh": "右栏日历",
      "en": "Side Rail Date"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.26,
      "bottom": 0.1,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F6F4EF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "divider",
      "anchor": "middle-right",
      "offset": {
        "x": -0.05,
        "y": -0.03
      },
      "shape": "line",
      "size": {
        "width": 0.1,
        "height": 0.0012
      },
      "color": "#D9D4C8"
    },
    {
      "type": "calendar",
      "id": "monthgrid",
      "anchor": "middle-right",
      "offset": {
        "x": -0.03,
        "y": -0.17
      },
      "size": 0.14,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "showWeekdays": true,
      "view": "month",
      "color": "#6B7280",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "right",
    "align": "right",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('DD', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "date('YYYY年MM月DD日', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
