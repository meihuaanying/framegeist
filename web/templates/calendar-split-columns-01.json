{
  "meta": {
    "id": "calendar-split-columns-01",
    "name": "Split Calendar",
    "nameI18n": {
      "zh": "双栏日历",
      "en": "Split Calendar"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.2
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA",
      "autoHide": true
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      },
      "shape": "line",
      "size": {
        "width": 0.0015,
        "height": 0.165
      },
      "color": "#E0E0E0"
    },
    {
      "type": "calendar",
      "id": "daycard",
      "anchor": "bottom-center",
      "offset": {
        "x": -0.25,
        "y": -0.015
      },
      "size": 0.19,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "view": "day",
      "color": "#6B7280",
      "accent": "#1A1A1A",
      "fontFamily": [
        "Inter"
      ]
    },
    {
      "type": "text",
      "id": "cndate",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.25,
        "y": -0.175
      },
      "font": {
        "family": [
          "LXGW WenKai"
        ],
        "size": 0.0192,
        "color": "#373A40",
        "weight": 400
      },
      "letterSpacing": 0.04,
      "align": "center",
      "content": [
        {
          "expr": "date('YYYY年MM月DD日', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "weekday",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.25,
        "y": -0.14
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "exif.weekday_cn",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.25,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.25,
        "y": -0.055
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
