{
  "meta": {
    "id": "drone-skybar-01",
    "name": "Drone Sky Bar",
    "nameI18n": {
      "zh": "航拍白条",
      "en": "Drone Sky Bar"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.075,
      "bottom": 0.22,
      "left": 0.075
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0652,
        "y": -0.162
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0652,
        "y": -0.1275
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0114,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'AERIAL CAPTURE'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "params1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0652,
        "y": -0.085
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0156,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "params2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0652,
        "y": -0.0484
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0652,
        "y": -0.0824
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0652,
        "y": -0.0492
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "geotag",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0652,
        "y": -0.0172
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.06,
      "align": "right",
      "content": [
        {
          "expr": "exif.gps_latlon",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
