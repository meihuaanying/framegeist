{
  "meta": {
    "id": "ticket-vertical-rail-02",
    "name": "Vertical Rail",
    "nameI18n": { "zh": "票根·右侧竖卡", "en": "Vertical Rail" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "ticket"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.07, "right": 0.06, "bottom": 0.14, "left": 0.06 },
    "background": { "type": "solid", "color": "#D5DCD4" }
  },
  "layers": [
    {
      "type": "shape",
      "id": "card",
      "anchor": "top-left",
      "offset": { "x": 0.7143, "y": 0.0579 },
      "shape": "rect",
      "size": { "width": 0.26, "height": 1.0 },
      "color": "#F6F4EE",
      "radius": 0.05
    },
    {
      "type": "shape",
      "id": "perf",
      "anchor": "top-left",
      "offset": { "x": 0.7199, "y": 0.3219 },
      "shape": "line",
      "size": { "width": 0.2475, "height": 0.0008 },
      "color": "#C9CCC6"
    },
    {
      "type": "shape",
      "id": "notch-left",
      "anchor": "top-left",
      "offset": { "x": 0.7056, "y": 0.3116 },
      "shape": "ellipse",
      "size": { "width": 0.0195, "height": 0.026 },
      "color": "#D5DCD4"
    },
    {
      "type": "shape",
      "id": "notch-right",
      "anchor": "top-left",
      "offset": { "x": 0.9377, "y": 0.3116 },
      "shape": "ellipse",
      "size": { "width": 0.0195, "height": 0.026 },
      "color": "#D5DCD4"
    },
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.077 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#82868C" },
      "letterSpacing": 0.22,
      "content": [{ "expr": "'TICKET STUB'", "fallback": "TICKET" }]
    },
    {
      "type": "image",
      "id": "barcode",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.096 },
      "asset": "@builtin/frame/barcode",
      "size": { "height": 0.050 }
    },
    {
      "type": "text",
      "id": "serial",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.148 },
      "font": { "family": ["Bebas Neue"], "size": 0.028, "color": "#26292B" },
      "letterSpacing": 0.06,
      "content": [{ "expr": "'NO. 0917'", "fallback": "TICKET NO." }]
    },
    {
      "type": "text",
      "id": "stubdate",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.190 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#5F656C" },
      "letterSpacing": 0.10,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "route",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.38 },
      "font": { "family": ["Bebas Neue"], "size": 0.046, "color": "#26292B" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "'BEIJING · XIAN'", "fallback": "FROM · TO" }]
    },
    {
      "type": "text",
      "id": "station",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.47 },
      "font": { "family": ["JetBrains Mono"], "size": 0.009, "color": "#82868C" },
      "letterSpacing": 0.20,
      "content": [{ "expr": "'THIS STATION'", "fallback": "STATION" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.58 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#5F656C" },
      "letterSpacing": 0.05,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter}', exif)", "fallback": null }
      ]
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.720 },
      "shape": "line",
      "size": { "width": 0.2125, "height": 0.0008 },
      "color": "#D5D1C8"
    },
    {
      "type": "text",
      "id": "terms",
      "anchor": "top-left",
      "offset": { "x": 0.7277, "y": 0.740 },
      "font": { "family": ["JetBrains Mono"], "size": 0.009, "color": "#82868C" },
      "letterSpacing": 0.16,
      "content": [{ "expr": "'VALID ONE WAY ONLY'", "fallback": "VALID" }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.0625, "y": 0.026 },
      "font": { "family": ["Space Grotesk"], "size": 0.013, "color": "#3A3F46" },
      "letterSpacing": 0.06,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')", "fallback": "UNKNOWN CAMERA" }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": { "x": 0.0625, "y": 0.026 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.020 },
      "attachTo": "model",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "topright",
      "anchor": "top-right",
      "offset": { "x": -0.0625, "y": 0.028 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#6E7468" },
      "letterSpacing": 0.10,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture}', exif)", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" },
    "stock": { "type": "string", "source": "constant" }
  }
}
