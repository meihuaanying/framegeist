{
  "meta": {
    "id": "festival-dragon-boat-01",
    "name": "Dragon Boat Seal",
    "nameI18n": { "zh": "端午印记", "en": "Dragon Boat Seal" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.12, "right": 0.12, "bottom": 0.20, "left": 0.22 },
    "background": { "type": "solid", "color": "#FAF6EC" }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": { "x": 0.04, "y": 0.035 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "content": [{ "expr": "'DUANWU · FRAMEGEIST'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "vertical-phrase",
      "anchor": "middle-left",
      "offset": { "x": 0.035, "y": 0.02 },
      "font": { "family": ["Noto Serif SC"], "size": 0.045, "color": "#1A1A1A" },
      "letterSpacing": 0.06,
      "rotation": 90,
      "align": "center",
      "content": [{ "expr": "'端午安康'", "fallback": null }]
    },
    {
      "type": "image",
      "id": "boat",
      "anchor": "bottom-left",
      "offset": { "x": 0.04, "y": -0.045 },
      "asset": "@builtin/frame/icon-boat",
      "size": { "height": 0.055 },
      "tint": "dark"
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-left",
      "offset": { "x": 0.185, "y": -0.045 },
      "asset": "@builtin/frame/seal-red",
      "size": { "height": 0.07 }
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.045, "y": 0.035 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#9AA0A6" },
      "letterSpacing": 0.1,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": { "x": -0.045, "y": -0.045 },
      "font": { "family": ["Inter"], "size": 0.0125, "color": "#373A40" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.045, "y": -0.08 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
