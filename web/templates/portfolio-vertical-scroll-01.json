{
  "meta": {
    "id": "portfolio-vertical-scroll-01",
    "name": "Vertical Scroll",
    "nameI18n": { "zh": "竖排题名", "en": "Vertical Scroll" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.10, "right": 0.30, "bottom": 0.16, "left": 0.14 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": { "x": 0.05, "y": 0.04 },
      "font": { "family": ["Inter"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "content": [{ "expr": "'PORTFOLIO 2026'", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "top-right",
      "offset": { "x": -0.05, "y": 0.038 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "vertical-title",
      "anchor": "middle-right",
      "offset": { "x": -0.045, "y": 0.02 },
      "font": { "family": ["Noto Serif SC"], "size": 0.05, "color": "#1A1A1A" },
      "letterSpacing": 0.05,
      "rotation": 90,
      "align": "center",
      "content": [{ "expr": "'《山间叙事》'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.095 },
      "font": { "family": ["Inter"], "size": 0.014, "color": "#373A40" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.055 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.05, "y": -0.055 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.1,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
