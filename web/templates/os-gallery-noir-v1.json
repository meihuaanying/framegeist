{
  "meta": {
    "id": "os-gallery-noir-v1",
    "name": "Gallery Noir",
    "nameI18n": {
      "zh": "画廊夜黑",
      "en": "Gallery Noir"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "gallery"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.09,
      "bottom": 0.16,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#101112"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.024,
        "weight": 600,
        "color": "#F2F2F0"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.055
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.02
      },
      "anchor": "bottom-left",
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.015,
        "weight": 400,
        "color": "#B9B9B4"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.03,
        "y": -0.055
      }
    }
  ]
}
