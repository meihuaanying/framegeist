{
  "meta": {
    "id": "calendar-portrait-stack-01",
    "name": "Portrait Stack",
    "nameI18n": {
      "zh": "竖幅日历",
      "en": "Portrait Stack"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.1,
      "bottom": 0.26,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#F5F2EC"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "align": "center",
      "content": [
        {
          "expr": "'FRAMEGEIST CALENDAR'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "calendar",
      "id": "daycard",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.03
      },
      "size": 0.14,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "view": "day",
      "color": "#373A40",
      "accent": "#1A1A1A",
      "fontFamily": [
        "Inter"
      ]
    },
    {
      "type": "text",
      "id": "weekday",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.026
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "exif.weekday_cn",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
