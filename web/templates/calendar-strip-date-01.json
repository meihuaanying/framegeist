{
  "meta": {
    "id": "calendar-strip-date-01",
    "name": "Bottom Strip Date",
    "nameI18n": {
      "zh": "底栏日历",
      "en": "Bottom Strip Date"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.08,
      "bottom": 0.26,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.185
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA",
      "autoHide": true
    },
    {
      "type": "text",
      "id": "bigday",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.055
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.14,
        "color": "#1A1A1A",
        "weight": 400
      },
      "letterSpacing": 0.01,
      "content": [
        {
          "expr": "date('DD', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "yearmonth",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.018
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0115,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('YYYY.MM', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "calendar",
      "id": "strip",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.115
      },
      "size": 0.34,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "view": "strip",
      "color": "#373A40",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter",
        "Noto Serif SC"
      ]
    },
    {
      "type": "text",
      "id": "weekday",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.08
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0135,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "exif.weekday_cn",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.125
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.08
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
