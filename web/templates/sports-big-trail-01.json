{
  "meta": {
    "id": "sports-big-trail-01",
    "name": "Big Trail",
    "nameI18n": {
      "zh": "大标题山径",
      "en": "Big Trail"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.07,
      "right": 0.09,
      "bottom": 0.28,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "eyebrow",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.1706
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0114,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'MOUNTAIN RIDE · 2026'",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "bigword",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.0685
      },
      "font": {
        "family": [
          "Unbounded"
        ],
        "size": 0.115,
        "color": "#1A1A1A",
        "weight": 700
      },
      "letterSpacing": 0.03,
      "effects": {
        "relief": {
          "mode": "letterpress",
          "depth": 0.05,
          "highlight": "#FFFFFF",
          "shadow": "#C9C2B4",
          "opacity": 0.85
        }
      },
      "content": [
        {
          "expr": "'TRAIL'",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0763,
        "y": -0.1022
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.0511
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0763,
        "y": -0.0515
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
