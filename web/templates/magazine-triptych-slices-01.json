{
  "meta": {
    "id": "magazine-triptych-slices-01",
    "name": "Triptych Slices",
    "nameI18n": {
      "zh": "三联切片",
      "en": "Triptych Slices"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "overlay"
  },
  "layers": [
    {
      "type": "shape",
      "id": "slice-1",
      "anchor": "top-left",
      "offset": {
        "x": 0.333,
        "y": 0.16
      },
      "shape": "rect",
      "size": {
        "width": 0.0015,
        "height": 0.68
      },
      "color": "#FFFFFF",
      "opacity": 0.55
    },
    {
      "type": "shape",
      "id": "slice-2",
      "anchor": "top-left",
      "offset": {
        "x": 0.6658,
        "y": 0.16
      },
      "shape": "rect",
      "size": {
        "width": 0.0015,
        "height": 0.68
      },
      "color": "#FFFFFF",
      "opacity": 0.55
    },
    {
      "type": "text",
      "id": "head",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#FFFFFF",
        "weight": 500
      },
      "letterSpacing": 0.45,
      "lineHeight": 1.9,
      "opacity": 0.85,
      "align": "center",
      "content": [
        {
          "expr": "'TRIPTYCH'",
          "fallback": null
        },
        {
          "expr": "'I — II — III'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.035,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.035,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
