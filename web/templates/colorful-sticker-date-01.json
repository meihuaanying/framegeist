{
  "meta": {
    "id": "colorful-sticker-date-01",
    "name": "Sticker Date",
    "nameI18n": { "zh": "贴纸日期", "en": "Sticker Date" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "shape",
      "id": "tag-big",
      "anchor": "middle-center",
      "offset": { "x": -0.29, "y": 0.29 },
      "shape": "rect",
      "size": { "width": 0.34, "height": 0.075 },
      "color": "#F4B942",
      "radius": 0.06,
      "rotation": -5
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": { "x": 0.04, "y": -0.148 },
      "font": { "family": ["Space Grotesk"], "size": 0.017, "color": "auto" },
      "letterSpacing": 0.12,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "shape",
      "id": "tag-small",
      "anchor": "middle-center",
      "offset": { "x": -0.15, "y": -0.3325 },
      "shape": "rect",
      "size": { "width": 0.26, "height": 0.055 },
      "color": "#2A9D8F",
      "radius": 0.08,
      "rotation": 3
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.04, "y": 0.032 },
      "font": { "family": ["Inter"], "size": 0.014, "color": "auto" },
      "letterSpacing": 0.06,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.04, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.04,
      "opacity": 0.9,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": { "x": -0.04, "y": 0.032 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
