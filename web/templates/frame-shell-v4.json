{
  "meta": {
    "id": "frame-shell-v4",
    "name": "Camera Shell V4",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "frame-shell"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.09,
      "bottom": 0.14,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#3A2A1A"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.022
      },
      "offset": {
        "x": 0.03,
        "y": 0.035
      }
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.024,
        "weight": 600,
        "color": "#EDEDED"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.05
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#AAAAAA"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.03,
        "y": -0.055
      }
    }
  ]
}
