{
  "meta": {
    "id": "phone-paper-spec-01",
    "name": "Paper Spec",
    "nameI18n": {
      "zh": "纸感规格",
      "en": "Paper Spec"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.07,
      "right": 0.08,
      "bottom": 0.26,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "specline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.069,
        "y": -0.171
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "dot",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.069,
        "y": -0.1368
      },
      "shape": "ellipse",
      "size": {
        "width": 0.011,
        "height": 0.014
      },
      "color": "#E10600"
    },
    {
      "type": "shape",
      "id": "rule1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.5991,
        "y": -0.0752
      },
      "shape": "rect",
      "size": {
        "width": 0.0008,
        "height": 0.062
      },
      "color": "#DADDE2"
    },
    {
      "type": "shape",
      "id": "rule2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.6939,
        "y": -0.0752
      },
      "shape": "rect",
      "size": {
        "width": 0.0008,
        "height": 0.062
      },
      "color": "#DADDE2"
    },
    {
      "type": "shape",
      "id": "rule3",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.7888,
        "y": -0.0752
      },
      "shape": "rect",
      "size": {
        "width": 0.0008,
        "height": 0.062
      },
      "color": "#DADDE2"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')",
        "fallback": "MOBILE CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('f/{aperture}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
