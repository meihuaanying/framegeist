{
  "meta": {
    "id": "minimal-copyright",
    "name": "Quiet Copyright",
    "nameI18n": {
      "zh": "仅版权微字",
      "en": "Quiet Copyright"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "overlay",
    "background": {
      "type": "none"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "copyright",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.028,
        "y": -0.028
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.8,
      "align": "right",
      "content": [
        {
          "expr": "date('(C) YYYY', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-left",
      "corner": "bottom-left",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.04
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
