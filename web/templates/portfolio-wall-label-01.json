{
  "meta": {
    "id": "portfolio-wall-label-01",
    "name": "Wall Label",
    "nameI18n": {
      "zh": "展览标签",
      "en": "Wall Label"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.08,
      "bottom": 0.1,
      "left": 0.34
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "label-head",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.16
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.0114,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "content": [
        {
          "expr": "'WORK / 作品'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.2
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.0462,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.06,
      "content": [
        {
          "expr": "'《夜色温柔》'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "year",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.28
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.033,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.04,
      "content": [
        {
          "expr": "'2026'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "author",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.345
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0168,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.1,
      "content": [
        {
          "expr": "'FrameGeist'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "medium",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.385
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.0138,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "'数字微喷 · 收藏级'",
          "fallback": null
        }
      ]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.155
      },
      "shape": "line",
      "size": {
        "width": 0.28,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.1
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0168,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.055
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.055
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
