{
  "meta": {
    "id": "polaroid-classic-script-03",
    "name": "Classic Script",
    "nameI18n": {
      "zh": "经典手写白框",
      "en": "Classic Script"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.34,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.062
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#2A2A2A",
    "font": {
      "family": [
        "Great Vibes",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'with love'",
        "fallback": "with love",
        "role": "display"
      },
      {
        "expr": "'SEASIDE'",
        "fallback": "SEASIDE",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
