{
  "meta": {
    "id": "signature-v2",
    "name": "Signature 2",
    "nameI18n": {
      "zh": "签名款 2",
      "en": "Signature 2"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "gallery"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.05,
      "right": 0.06,
      "bottom": 0.18,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FAF6EE"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "signature",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "Great Vibes",
          "Cormorant Garamond"
        ],
        "size": 0.085,
        "weight": 400,
        "color": "#3A332A"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "FrameGeist"
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.075
      },
      "lineHeight": 1
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.015,
        "weight": 400,
        "color": "#8A8175"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.035
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.016
      },
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.012
      }
    }
  ]
}
