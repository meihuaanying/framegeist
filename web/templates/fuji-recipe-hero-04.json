      "letterSpacing": 0.02,
      "content": [
        {
          "expr": "exif.iso",
          "fallback": "200"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.85,
        "y": 0.868
      },
      "font": {
        "family": [
          "Geist Mono"
