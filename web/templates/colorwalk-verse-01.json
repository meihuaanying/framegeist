{
  "meta": {
    "id": "colorwalk-verse-01",
    "name": "Light Verse",
    "nameI18n": {
      "zh": "光影诗行",
      "en": "Light Verse"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.28,
      "left": 0.08
    },
    "background": {
      "type": "tint"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "verse",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.069,
        "y": -0.108
      },
      "font": {
        "family": [
          "Glow Sans SC"
        ],
        "size": 0.033,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.14,
      "lineHeight": 1.75,
      "opacity": 0.95,
      "content": [
        {
          "expr": "'光影入纸'",
          "fallback": null
        },
        {
          "expr": "'山河为证'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.069,
        "y": -0.079
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.85,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.069,
        "y": -0.155
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.069,
        "y": -0.131
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "opacity": 0.8,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.069,
        "y": -0.101
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "opacity": 0.85,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
