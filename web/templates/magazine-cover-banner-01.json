{
  "meta": {
    "id": "magazine-cover-banner-01",
    "name": "Midnight Cover",
    "nameI18n": {
      "zh": "午夜封面",
      "en": "Midnight Cover"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.05,
      "bottom": 0.13,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#101114"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.045,
        "y": 0.112
      },
      "shape": "line",
      "size": {
        "width": 0.34,
        "height": 0.0015
      },
      "color": "#FFFFFF59"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.018
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#FFFFFF",
    "font": {
      "family": [
        "Fraunces",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'LIGHT JOURNAL'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
