{
  "meta": {
    "id": "film-serif-stock-05",
    "name": "Serif Silvergrain",
    "nameI18n": {
      "zh": "衬线卷名",
      "en": "Serif Silvergrain"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F6F1E7"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "edgecode",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.03
      },
      "asset": "@builtin/frame/film-edge",
      "size": {
        "width": 0.45
      },
      "opacity": 0.45
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono",
        "Geist"
      ]
    },
    "lines": [
      {
        "expr": "'SILVERGRAIN 200'",
        "fallback": "SILVERGRAIN",
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
