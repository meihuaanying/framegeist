{
  "meta": {
    "id": "film-positive-print-08",
    "name": "Positive Print",
    "nameI18n": {
      "zh": "黑白正片",
      "en": "Positive Print"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.11,
      "right": 0.1,
      "bottom": 0.22,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "thin-frame",
      "anchor": "top-left",
      "offset": {
        "x": 0.0833,
        "y": 0.0827
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 1
      },
      "color": "#111111",
      "strokeWidth": 0.0015
    },
    {
      "type": "image",
      "id": "edgecode",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.1053
      },
      "asset": "@builtin/frame/film-edge",
      "size": {
        "width": 0.5
      },
      "opacity": 0.3
    },
    {
      "type": "text",
      "id": "stock",
      "anchor": "top-left",
      "offset": {
        "x": 0.0833,
        "y": 0.035
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.024,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.18,
      "content": [
        {
          "expr": "'FG 100'",
          "fallback": "FILM"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.0833,
        "y": 0.042
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.0226
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0192,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
          "fallback": "CAMERA"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.0226
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "attachTo": "model",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.0526
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0833,
        "y": -0.0226
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  }
}
