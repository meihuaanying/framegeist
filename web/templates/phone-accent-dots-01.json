{
  "meta": {
    "id": "phone-accent-dots-01",
    "name": "Accent Dots",
    "nameI18n": { "zh": "点睛彩条", "en": "Accent Dots" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.06, "right": 0.07, "bottom": 0.19, "left": 0.07 },
    "background": { "type": "solid", "color": "#F8F1E7" }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot1",
      "anchor": "bottom-left",
      "offset": { "x": 0.0614, "y": -0.1112 },
      "shape": "ellipse",
      "size": { "width": 0.01, "height": 0.0125 },
      "color": "#E10600"
    },
    {
      "type": "shape",
      "id": "dot2",
      "anchor": "bottom-left",
      "offset": { "x": 0.0814, "y": -0.1112 },
      "shape": "ellipse",
      "size": { "width": 0.01, "height": 0.0125 },
      "color": "#F97316"
    },
    {
      "type": "shape",
      "id": "dot3",
      "anchor": "bottom-left",
      "offset": { "x": 0.1014, "y": -0.1112 },
      "shape": "ellipse",
      "size": { "width": 0.01, "height": 0.0125 },
      "color": "#FBBF24"
    },
    {
      "type": "text",
      "id": "dotnote",
      "anchor": "bottom-left",
      "offset": { "x": 0.121, "y": -0.1124 },
      "font": { "family": ["Inter"], "size": 0.009, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "content": [
        { "expr": "'TRIPLE CAMERA SYSTEM'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.0614, "y": -0.0692 },
      "font": { "family": ["Inter"], "size": 0.018, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')", "fallback": "MOBILE CAMERA" }
      ]
    },
    {
      "type": "text",
      "id": "params1",
      "anchor": "bottom-right",
      "offset": { "x": -0.0614, "y": -0.0872 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.05,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "params2",
      "anchor": "bottom-right",
      "offset": { "x": -0.0614, "y": -0.0512 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.05,
      "align": "right",
      "content": [
        { "expr": "fmt('{shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": { "x": 0.0614, "y": -0.0256 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.016 },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "accentbar",
      "anchor": "top-left",
      "offset": { "x": 0.0614, "y": 0 },
      "shape": "rect",
      "size": { "width": 1.0, "height": 0.01 },
      "color": "#F97316"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
