{
  "meta": {
    "id": "borderless-geo-pin-01",
    "name": "Geo Pin",
    "nameI18n": { "zh": "地理图钉", "en": "Geo Pin" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": { "x": 0.03, "y": 0.028 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.03, "y": 0.072 },
      "font": { "family": ["Inter"], "size": 0.015, "color": "auto" },
      "letterSpacing": 0.12,
      "opacity": 0.9,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-right",
      "offset": { "x": -0.03, "y": 0.03 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "auto" },
      "letterSpacing": 0.1,
      "opacity": 0.85,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.032 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.08,
      "opacity": 0.8,
      "content": [{ "expr": "exif.lens", "fallback": null }]
    },
    {
      "type": "text",
      "id": "geoline",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.066 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.1,
      "opacity": 0.85,
      "content": [{ "expr": "exif.gps_latlon", "fallback": null }]
    },
    {
      "type": "text",
      "id": "altline",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.1 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.1,
      "opacity": 0.8,
      "content": [{ "expr": "exif.gps_alt", "fallback": null }]
    },
    {
      "type": "image",
      "id": "pin",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.066 },
      "asset": "@builtin/frame/icon-pin",
      "size": { "height": 0.018 },
      "tint": "auto",
      "attachTo": "geoline",
      "attachGap": 0.012
    },
    {
      "type": "image",
      "id": "mountain",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.1 },
      "asset": "@builtin/frame/icon-mountain",
      "size": { "height": 0.018 },
      "tint": "auto",
      "attachTo": "altline",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.032 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.14,
      "opacity": 0.88,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "date": { "type": "string", "source": "exif" }
  }
}
