{
  "meta": {
    "id": "calendar-corner-day-01",
    "name": "Corner Day",
    "nameI18n": {
      "zh": "角标日历",
      "en": "Corner Day"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "auto",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('DD', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "date('YYYY年MM月DD日', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('MMM', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
