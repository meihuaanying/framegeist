{
  "meta": {
    "id": "portfolio-credit-still-01",
    "name": "Still Credits",
    "nameI18n": {
      "zh": "片尾小字",
      "en": "Still Credits"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'A PHOTOGRAPH BY FRAMEGEIST'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{model_pretty} · {focal}MM · F{aperture} · {shutter}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "'STILL FRAME 01'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
