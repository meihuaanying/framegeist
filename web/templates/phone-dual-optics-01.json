{
  "meta": {
    "id": "phone-dual-optics-01",
    "name": "Dual Optics",
    "nameI18n": { "zh": "双镜对照", "en": "Dual Optics" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.2, "right": 0.08, "bottom": 0.07, "left": 0.08 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "leftlabel",
      "anchor": "top-left",
      "offset": { "x": 0.069, "y": 0.0236 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "content": [
        { "expr": "'PRIMARY CAMERA'", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": { "x": 0.069, "y": 0.0433 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.02 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.069, "y": 0.0724 },
      "font": { "family": ["Inter"], "size": 0.016, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'MOBILE DEVICE')", "fallback": "MOBILE DEVICE" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-left",
      "offset": { "x": 0.069, "y": 0.0929 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "rightlabel",
      "anchor": "top-right",
      "offset": { "x": -0.069, "y": 0.0236 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "align": "right",
      "content": [
        { "expr": "'AUXILIARY OPTICS'", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "top-right",
      "offset": { "x": -0.069, "y": 0.0409 },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-right",
      "offset": { "x": -0.069, "y": 0.0724 },
      "font": { "family": ["Inter"], "size": 0.0135, "color": "#373A40" },
      "letterSpacing": 0.03,
      "align": "right",
      "content": [
        { "expr": "exif.lens", "fallback": "SECONDARY LENS" }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.069, "y": 0.0929 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.12,
      "align": "right",
      "content": [
        { "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }
      ]
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.0703 },
      "shape": "line",
      "size": { "width": 0.14, "height": 0.0015 },
      "rotation": 90,
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "bottomnote",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.0295 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.22,
      "align": "center",
      "content": [
        { "expr": "'DUAL CAMERA SYSTEM'", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
