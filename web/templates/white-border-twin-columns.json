{
  "meta": {
    "id": "white-border-twin-columns",
    "name": "Twin Columns",
    "nameI18n": {
      "zh": "双栏档案",
      "en": "Twin Columns"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.07,
      "bottom": 0.26,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F4"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "divider",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.172
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.135
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.014,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "lineHeight": 1.45,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture}', exif)",
          "fallback": null
        },
        {
          "expr": "fmt('{shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
