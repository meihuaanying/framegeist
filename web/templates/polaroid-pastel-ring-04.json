{
  "meta": {
    "id": "polaroid-pastel-ring-04",
    "name": "Pastel Ring",
    "nameI18n": {
      "zh": "粉彩圆环",
      "en": "Pastel Ring"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.26,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#DCE8E4"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "ring",
      "anchor": "top-left",
      "offset": {
        "x": 0.0536,
        "y": 0.0455
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 1
      },
      "color": "#FFFFFF",
      "strokeWidth": 0.003
    },
    {
      "type": "shape",
      "id": "circle",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.075,
        "y": -0.02
      },
      "shape": "ellipse",
      "size": {
        "width": 0.1275,
        "height": 0.17
      },
      "color": "#FFFFFF",
      "strokeWidth": 0.0025
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.07
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#2F3E3A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('DD', exif.datetime)",
        "fallback": "09",
        "role": "display"
      },
      {
        "expr": "date('MMMM YYYY', exif.datetime)",
        "fallback": "SEPTEMBER 2026",
        "role": "support"
      },
      {
        "expr": "'BY THE SEA'",
        "fallback": "SEASIDE",
        "role": "detail"
      }
    ]
  }
}
