{
  "meta": {
    "id": "os-card-param-v1",
    "name": "Card · Param",
    "nameI18n": {
      "zh": "卡片·参数",
      "en": "Card · Param"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.03,
      "right": 0.03,
      "bottom": 0.16,
      "left": 0.03
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.03,
        "weight": 700,
        "color": "#141414"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm', exif)",
          "fallback": "35mm"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.1
      }
    },
    {
      "type": "text",
      "id": "meta",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#444444"
      },
      "content": [
        {
          "expr": "fmt('f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": "f/2.8  1/250s  ISO200"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.024
      },
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.055
      },
      "tint": "dark"
    }
  ]
}
