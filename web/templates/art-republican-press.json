{
  "meta": {
    "id": "art-republican-press",
    "name": "Republican Letterpress",
    "nameI18n": {
      "zh": "民国杂志铅字",
      "en": "Republican Letterpress"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.06,
      "bottom": 0.2,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#F5F1E8"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rep-red-block",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.02
      },
      "shape": "rect",
      "size": {
        "width": 0.045,
        "height": 0.008
      },
      "color": "#B3271E",
      "opacity": 1
    },
    {
      "type": "text",
      "id": "rep-masthead",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.028
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.0528,
        "color": "#23201B",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "content": [
        {
          "expr": "'拾光画报'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "rep-masthead-en",
      "anchor": "top-right",
      "offset": {
        "x": -0.06,
        "y": 0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#6B655C",
        "weight": 500
      },
      "letterSpacing": 0.3,
      "align": "right",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "'The Light Pictorial · Monthly'",
          "fallback": null
        }
      ]
    },
    {
      "type": "shape",
      "id": "rep-red-rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.85
      },
      "shape": "line",
      "size": {
        "width": 0.1,
        "height": 0.003
      },
      "color": "#B3271E",
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "rep-divider",
      "anchor": "middle-left",
      "offset": {
        "x": 0.385,
        "y": 0.414
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.16
      },
      "color": "#C9C2B4",
      "opacity": 1,
      "autoHide": true
    },
    {
      "type": "text",
      "id": "rep-column-zh",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.862
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.0186,
        "color": "#3A3630",
        "weight": 500
      },
      "lineHeight": 1.7,
      "letterSpacing": 0.05,
      "width": 0.22,
      "content": [
        {
          "expr": "'一台旧相机，一卷慢风景；把光收进纸页，留给以后慢慢翻看。'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "rep-column-en",
      "anchor": "top-left",
      "offset": {
        "x": 0.43,
        "y": 0.862
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#555046",
        "weight": 500
      },
      "lineHeight": 1.9,
      "letterSpacing": 0.08,
      "width": 0.28,
      "content": [
        {
          "expr": "'Pictures gathered slowly, printed on warm paper, kept for the years ahead.'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "rep-model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.025
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#555046",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Editorial Desk')",
          "fallback": "Editorial Desk"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "rep-date",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.025
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#555046",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": "First Issue"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "rep-params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.06,
        "y": -0.025
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#555046",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "align": "right",
      "effects": {
        "case": "upper"
      },
      "content": [
        {
          "expr": "fmt('{focal}MM · F/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": "Letterpress · Two Columns"
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ]
}
