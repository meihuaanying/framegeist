{
  "meta": {
    "id": "white-border-editorial-01",
    "name": "Editorial White",
    "nameI18n": {
      "zh": "杂志白边",
      "en": "Editorial White"
    },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.085,
      "bottom": 0.3,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F4"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.073,
        "y": 0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.014,
        "color": "#9AA0A6"
      },
      "letterSpacing": 0.16,
      "content": [
        {
          "expr": "fmt('{focal}MM — {aperture} — {shutter} — ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.068
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.02
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.132
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.02,
        "color": "#1A1A1A"
      },
      "letterSpacing": 0.04,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Unknown Camera"
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.176
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.073,
        "y": -0.132
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#373A40"
      },
      "letterSpacing": 0.03,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.073,
        "y": -0.176
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#9AA0A6"
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": null
        }
      ]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.112
      },
      "shape": "line",
      "size": {
        "width": 1.0,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}