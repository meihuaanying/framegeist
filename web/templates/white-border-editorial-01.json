{
  "meta": {
    "id": "white-border-editorial-01",
    "name": "Editorial White",
    "nameI18n": {
      "zh": "杂志白边",
      "en": "Editorial White"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.085,
      "bottom": 0.3,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F4"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.068
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.073,
        "y": -0.112
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM — {aperture} — {shutter} — ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
