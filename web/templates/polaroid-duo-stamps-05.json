{
  "meta": {
    "id": "polaroid-duo-stamps-05",
    "name": "Duo Stamps",
    "nameI18n": {
      "zh": "双邮票",
      "en": "Duo Stamps"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.07,
      "bottom": 0.28,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#F6F2EA"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "stamp-back",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.075,
        "y": -0.075
      },
      "asset": "@builtin/frame/stamp-card",
      "size": {
        "height": 0.16
      }
    },
    {
      "type": "image",
      "id": "stamp-front",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0526,
        "y": -0.03
      },
      "asset": "@builtin/frame/stamp-card",
      "size": {
        "height": 0.17
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.0526,
        "y": 0.048
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('YYYY', exif.datetime)",
        "fallback": "2026",
        "role": "display"
      },
      {
        "expr": "'SUMMER'",
        "fallback": "SUMMER",
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
