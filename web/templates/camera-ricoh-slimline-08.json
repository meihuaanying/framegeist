{
  "meta": {
    "id": "camera-ricoh-slimline-08",
    "name": "Slimline Bar",
    "nameI18n": {
      "zh": "顶置细条参数",
      "en": "Slimline Bar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.06,
      "bottom": 0.14,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#F7F4EE"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "bar",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.03
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.045
      },
      "color": "#101010",
      "radius": 0.12
    },
    {
      "type": "shape",
      "id": "bar-dot",
      "anchor": "top-left",
      "offset": {
        "x": 0.07,
        "y": 0.0435
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.01
      },
      "color": "#C8102E"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.045
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
