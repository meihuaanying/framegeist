{
  "meta": {
    "id": "drone-geoblock-01",
    "name": "Drone Geo Block",
    "nameI18n": { "zh": "坐标块", "en": "Drone Geo Block" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.09, "right": 0.09, "bottom": 0.24, "left": 0.09 },
    "background": { "type": "solid", "color": "#F2F0EC" }
  },
  "layers": [
    {
      "type": "image",
      "id": "droneicon",
      "anchor": "top-left",
      "offset": { "x": 0.0763, "y": 0.0211 },
      "asset": "@builtin/frame/icon-drone",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": { "x": -0.0763, "y": 0.0211 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.02 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "topdate",
      "anchor": "top-right",
      "offset": { "x": -0.0763, "y": 0.0466 },
      "font": { "family": ["JetBrains Mono"], "size": 0.01, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "align": "right",
      "content": [
        { "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.0763, "y": -0.1173 },
      "font": { "family": ["Inter"], "size": 0.018, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'AERIAL UNIT')", "fallback": "AERIAL UNIT" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.0763, "y": -0.0872 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "footdate",
      "anchor": "bottom-left",
      "offset": { "x": 0.0763, "y": -0.0564 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "content": [
        { "expr": "'AERIAL SURVEY UNIT'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "geoblock",
      "anchor": "bottom-right",
      "offset": { "x": -0.0763, "y": -0.0935 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#373A40" },
      "letterSpacing": 0.03,
      "lineHeight": 1.6,
      "align": "right",
      "content": [
        { "expr": "exif.gps_latlon", "fallback": null },
        { "expr": "fmt('ALT {gps_alt}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "geomicro",
      "anchor": "bottom-right",
      "offset": { "x": -0.0763, "y": -0.0628 },
      "font": { "family": ["Inter"], "size": 0.009, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "align": "right",
      "content": [
        { "expr": "'GEO RECORD'", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
