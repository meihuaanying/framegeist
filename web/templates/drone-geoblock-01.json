{
  "meta": {
    "id": "drone-geoblock-01",
    "name": "Drone Geo Block",
    "nameI18n": {
      "zh": "坐标块",
      "en": "Drone Geo Block"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.09,
      "bottom": 0.24,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#F2F0EC"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "droneicon",
      "anchor": "top-left",
      "offset": {
        "x": 0.0763,
        "y": 0.0211
      },
      "asset": "@builtin/frame/icon-drone",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.0763,
        "y": 0.0211
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'AERIAL UNIT')",
        "fallback": "AERIAL UNIT",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "exif.gps_latlon · fmt('ALT {gps_alt}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
