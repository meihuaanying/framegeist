{
  "meta": {
    "id": "borderless-signoff-block-01",
    "name": "Sign-off Block",
    "nameI18n": { "zh": "右下落款", "en": "Sign-off Block" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.138 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.096 },
      "font": { "family": ["Inter"], "size": 0.015, "color": "auto" },
      "letterSpacing": 0.1,
      "opacity": 0.9,
      "align": "right",
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.06 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.08,
      "opacity": 0.85,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.028 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.14,
      "opacity": 0.8,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-left",
      "offset": { "x": 0.03, "y": 0.03 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.08,
      "opacity": 0.8,
      "content": [{ "expr": "exif.lens", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "date": { "type": "string", "source": "exif" }
  }
}
