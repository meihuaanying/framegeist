{
  "meta": {
    "id": "os-instax-v1",
    "name": "Instax Wide",
    "nameI18n": {
      "zh": "宽白拍立得",
      "en": "Instax Wide"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.04,
      "right": 0.04,
      "bottom": 0.24,
      "left": 0.04
    },
    "background": {
      "type": "solid",
      "color": "#FBF9F4"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#5A5A5A"
      },
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": "2026.09.12"
        }
      ],
      "offset": {
        "x": -0.04,
        "y": -0.045
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.02
      },
      "anchor": "bottom-left",
      "offset": {
        "x": 0.04,
        "y": -0.042
      },
      "tint": "dark"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.02,
        "weight": 600,
        "color": "#2E2E2E"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "FrameGeist"
        }
      ],
      "offset": {
        "x": 0.04,
        "y": -0.1
      }
    }
  ]
}
