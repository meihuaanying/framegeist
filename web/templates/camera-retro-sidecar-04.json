{
  "meta": {
    "id": "camera-retro-sidecar-04",
    "name": "Retro Sidecar",
    "nameI18n": {
      "zh": "复古侧挂机身",
      "en": "Retro Sidecar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.12,
      "left": 0.34
    },
    "background": {
      "type": "solid",
      "color": "#E8DDC4"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.075
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.25
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "dot",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.336
      },
      "shape": "ellipse",
      "size": {
        "width": 0.008,
        "height": 0.008
      },
      "color": "#A33B2A"
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.438
      },
      "shape": "line",
      "size": {
        "width": 0.145,
        "height": 0.001
      },
      "color": "#C9B99A"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.05
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#2A2118",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "'Analogue Notes'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
