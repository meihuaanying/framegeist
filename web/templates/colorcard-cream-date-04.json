{
  "meta": {
    "id": "colorcard-cream-date-04",
    "name": "Cream Date",
    "nameI18n": {
      "zh": "奶油大日期",
      "en": "Cream Date"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.08,
      "bottom": 0.34,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F6F1E7"
    },
    "radius": 0.04,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.24,
      "offsetX": 0,
      "offsetY": 0.03
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.042
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "#9A9288",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "bigdate",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.135
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.108,
        "color": "#1A1A1A",
        "weight": 400
      },
      "letterSpacing": 0.02,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1,
        "y": -0.03
      },
      "count": 4,
      "shape": "square",
      "direction": "vertical",
      "size": 0.03,
      "gap": 0.012,
      "showHex": true,
      "label": {
        "size": 0.009,
        "color": "#8A8177",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
