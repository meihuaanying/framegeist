{
  "meta": {
    "id": "ticket-park-pass-04",
    "name": "Park Pass",
    "nameI18n": {
      "zh": "公园通行证",
      "en": "Park Pass"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "ticket"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.22,
      "right": 0.06,
      "bottom": 0.24,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#E7E4DA"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "card",
      "anchor": "top-left",
      "offset": {
        "x": 0.0536,
        "y": 0.0137
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.2
      },
      "color": "#FDFCF9",
      "radius": 0.05
    },
    {
      "type": "image",
      "id": "icon",
      "anchor": "top-left",
      "offset": {
        "x": 0.067,
        "y": 0.0331
      },
      "asset": "@builtin/frame/icon-mountain",
      "size": {
        "height": 0.055
      }
    },
    {
      "type": "image",
      "id": "barcode",
      "anchor": "top-left",
      "offset": {
        "x": 0.112,
        "y": 0.095
      },
      "asset": "@builtin/frame/barcode",
      "size": {
        "height": 0.034
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.045
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#2A2E2A",
    "font": {
      "family": [
        "Bricolage Grotesque",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'NATIONAL PARK PASS'",
        "fallback": "PARK PASS",
        "role": "support"
      },
      {
        "expr": "'NO. 0231'",
        "fallback": "TICKET NO.",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
