{
  "meta": {
    "id": "blur-bg-card-03",
    "name": "Soft Card",
    "nameI18n": {
      "zh": "柔焦卡片",
      "en": "Soft Card"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "blur-bg"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.12,
      "bottom": 0.24,
      "left": 0.12
    },
    "background": {
      "type": "blur",
      "blur": 85,
      "scale": 1.3
    },
    "radius": 0.07,
    "shadow": {
      "enabled": true,
      "blur": 0.16,
      "opacity": 0.38,
      "offsetX": 0,
      "offsetY": 0.045
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "date",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.038
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "center",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.135
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0216,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.1
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.058
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
