{
  "meta": {
    "id": "colorwalk-top-field-01",
    "name": "Top Field",
    "nameI18n": { "zh": "顶部色域", "en": "Top Field" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.15, "right": 0.07, "bottom": 0.20, "left": 0.07 },
    "background": { "type": "tint" }
  },
  "layers": [
    {
      "type": "shape",
      "id": "field",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.081 },
      "shape": "rect",
      "size": { "width": 1.0, "height": 0.028 },
      "color": "#FFFFFF2E",
      "radius": 0.03
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.05 },
      "font": { "family": ["Space Grotesk"], "size": 0.019, "color": "auto" },
      "letterSpacing": 0.20,
      "opacity": 0.95,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.0614, "y": -0.0917 },
      "font": { "family": ["Inter"], "size": 0.017, "color": "auto" },
      "letterSpacing": 0.05,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.0917 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "auto" },
      "letterSpacing": 0.06,
      "opacity": 0.9,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.0614, "y": -0.0945 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
