{
  "meta": {
    "id": "colorwalk-top-field-01",
    "name": "Top Field",
    "nameI18n": {
      "zh": "顶部色域",
      "en": "Top Field"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.15,
      "right": 0.07,
      "bottom": 0.2,
      "left": 0.07
    },
    "background": {
      "type": "tint"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "field",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.081
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.028
      },
      "color": "#FFFFFF2E",
      "radius": 0.03
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.05
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0228,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.95,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.0917
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0204,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.0917
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "opacity": 0.9,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.0945
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
