{
  "meta": {
    "id": "camera-stencil-mono-05",
    "name": "Stencil Mono",
    "nameI18n": {
      "zh": "丝印极简机身",
      "en": "Stencil Mono"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.055,
      "bottom": 0.16,
      "left": 0.055
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.032
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "stencil",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.062
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#C2C6CB",
        "weight": 500
      },
      "letterSpacing": 0.22,
      "content": [
        {
          "expr": "'STENCIL 05'",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.036
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0138,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "body",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.032
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.1
      },
      "opacity": 0.9,
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.062
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0192,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.1,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.03
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0138,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
