{
  "meta": {
    "id": "colorwalk-vbar-01",
    "name": "Side Column",
    "nameI18n": {
      "zh": "左侧色柱",
      "en": "Side Column"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.1,
      "bottom": 0.16,
      "left": 0.17
    },
    "background": {
      "type": "tint"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "vbar",
      "anchor": "middle-left",
      "offset": {
        "x": 0.0354,
        "y": -0.031
      },
      "shape": "rect",
      "size": {
        "width": 0.02,
        "height": 0.52
      },
      "color": "#17181A",
      "opacity": 0.9
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0787,
        "y": -0.093
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('FOCAL {focal}MM', exif) · fmt('F {aperture}', exif) · exif.shutter · fmt('ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
