{
  "meta": {
    "id": "colorwalk-vbar-01",
    "name": "Side Column",
    "nameI18n": {
      "zh": "左侧色柱",
      "en": "Side Column"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.1,
      "bottom": 0.16,
      "left": 0.17
    },
    "background": {
      "type": "tint"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "vbar",
      "anchor": "middle-left",
      "offset": {
        "x": 0.0354,
        "y": -0.031
      },
      "shape": "rect",
      "size": {
        "width": 0.02,
        "height": 0.52
      },
      "color": "#17181A",
      "opacity": 0.9
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.0354,
        "y": 0.035
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.85,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "paramstack",
      "anchor": "middle-left",
      "offset": {
        "x": 0.0693,
        "y": -0.031
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "lineHeight": 1.95,
      "opacity": 0.85,
      "content": [
        {
          "expr": "fmt('FOCAL {focal}MM', exif)",
          "fallback": null
        },
        {
          "expr": "fmt('F {aperture}', exif)",
          "fallback": null
        },
        {
          "expr": "exif.shutter",
          "fallback": null
        },
        {
          "expr": "fmt('ISO{iso}', exif)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0693,
        "y": -0.093
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0787,
        "y": -0.093
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
