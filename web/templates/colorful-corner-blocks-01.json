{
  "meta": {
    "id": "colorful-corner-blocks-01",
    "name": "Corner Blocks",
    "nameI18n": { "zh": "四角色块", "en": "Corner Blocks" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "shape",
      "id": "block-tl",
      "anchor": "top-left",
      "offset": { "x": 0.03, "y": 0.03 },
      "shape": "rect",
      "size": { "width": 0.024, "height": 0.024 },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "block-tr",
      "anchor": "top-right",
      "offset": { "x": -0.03, "y": 0.03 },
      "shape": "rect",
      "size": { "width": 0.024, "height": 0.024 },
      "color": "#F4B942"
    },
    {
      "type": "shape",
      "id": "block-bl",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.03 },
      "shape": "rect",
      "size": { "width": 0.024, "height": 0.024 },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "block-br",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.03 },
      "shape": "rect",
      "size": { "width": 0.024, "height": 0.024 },
      "color": "#457B9D"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": { "x": 0.03, "y": 0.068 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.16,
      "opacity": 0.9,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": { "x": -0.03, "y": 0.068 },
      "font": { "family": ["Inter"], "size": 0.014, "color": "auto" },
      "letterSpacing": 0.06,
      "align": "right",
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "camera",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.085 },
      "font": { "family": ["Inter"], "size": 0.017, "color": "auto" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.055 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.04,
      "opacity": 0.85,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.03, "y": -0.075 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.02 },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
