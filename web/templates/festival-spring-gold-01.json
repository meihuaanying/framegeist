{
  "meta": {
    "id": "festival-spring-gold-01",
    "name": "Spring Gold",
    "nameI18n": {
      "zh": "新春金岁",
      "en": "Spring Gold"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.1,
      "bottom": 0.3,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#C8102E"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "seal-patch",
      "anchor": "top-right",
      "offset": {
        "x": -0.045,
        "y": 0.012
      },
      "shape": "ellipse",
      "size": {
        "width": 0.09,
        "height": 0.09
      },
      "color": "#FAF7F0"
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "top-right",
      "offset": {
        "x": -0.0525,
        "y": 0.019
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.075
      }
    },
    {
      "type": "image",
      "id": "lantern-left",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.045
      },
      "asset": "@builtin/frame/icon-lantern",
      "size": {
        "height": 0.042
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "lantern-right",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.045
      },
      "asset": "@builtin/frame/icon-lantern",
      "size": {
        "height": 0.042
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#F2C94C",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'新春'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "date('YYYY', exif.datetime)",
        "fallback": "2026",
        "role": "display"
      },
      {
        "expr": "'SPRING FESTIVAL'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
