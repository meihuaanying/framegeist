{
  "meta": {
    "id": "colorful-rainbow-lines-01",
    "name": "Spectrum Rules",
    "nameI18n": {
      "zh": "彩虹刻度",
      "en": "Spectrum Rules"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.22,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "line-1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1574
      },
      "shape": "line",
      "size": {
        "width": 0.3,
        "height": 0.0038
      },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "line-2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1467
      },
      "shape": "line",
      "size": {
        "width": 0.26,
        "height": 0.0038
      },
      "color": "#F4A261"
    },
    {
      "type": "shape",
      "id": "line-3",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.136
      },
      "shape": "line",
      "size": {
        "width": 0.22,
        "height": 0.0038
      },
      "color": "#E9C46A"
    },
    {
      "type": "shape",
      "id": "line-4",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1253
      },
      "shape": "line",
      "size": {
        "width": 0.18,
        "height": 0.0038
      },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "line-5",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1146
      },
      "shape": "line",
      "size": {
        "width": 0.14,
        "height": 0.0038
      },
      "color": "#457B9D"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0536,
        "y": -0.062
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
