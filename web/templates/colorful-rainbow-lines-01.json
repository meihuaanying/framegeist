{
  "meta": {
    "id": "colorful-rainbow-lines-01",
    "name": "Spectrum Rules",
    "nameI18n": {
      "zh": "彩虹刻度",
      "en": "Spectrum Rules"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.22,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "kicker",
      "anchor": "top-left",
      "offset": {
        "x": 0.0536,
        "y": 0.033
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.26,
      "content": [
        {
          "expr": "'SPECTRUM'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.0536,
        "y": 0.033
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#1A1A1A",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "line-1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1574
      },
      "shape": "line",
      "size": {
        "width": 0.3,
        "height": 0.0038
      },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "line-2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1467
      },
      "shape": "line",
      "size": {
        "width": 0.26,
        "height": 0.0038
      },
      "color": "#F4A261"
    },
    {
      "type": "shape",
      "id": "line-3",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.136
      },
      "shape": "line",
      "size": {
        "width": 0.22,
        "height": 0.0038
      },
      "color": "#E9C46A"
    },
    {
      "type": "shape",
      "id": "line-4",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1253
      },
      "shape": "line",
      "size": {
        "width": 0.18,
        "height": 0.0038
      },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "line-5",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.1146
      },
      "shape": "line",
      "size": {
        "width": 0.14,
        "height": 0.0038
      },
      "color": "#457B9D"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.348,
        "y": -0.105
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0216,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.348,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0536,
        "y": -0.062
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
