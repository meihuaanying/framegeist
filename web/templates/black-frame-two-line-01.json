{
  "meta": {
    "id": "black-frame-two-line-01",
    "name": "Two Lines",
    "nameI18n": { "zh": "黑框双行", "en": "Two Lines" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.06, "right": 0.07, "bottom": 0.24, "left": 0.07 },
    "background": { "type": "solid", "color": "#111214" }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-right",
      "offset": { "x": -0.05, "y": 0.02 },
      "font": { "family": ["Inter"], "size": 0.009, "color": "#6E6E6E" },
      "letterSpacing": 0.2,
      "align": "right",
      "content": [{ "expr": "'BLACK FRAME · 2026'", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-right",
      "offset": { "x": -0.05, "y": -0.145 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.13 },
      "font": { "family": ["Inter"], "size": 0.018, "color": "#F2F2F2" },
      "letterSpacing": 0.02,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.075 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "#A0A0A0" },
      "letterSpacing": 0.06,
      "content": [{ "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.05, "y": -0.075 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#8A8A8A" },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
