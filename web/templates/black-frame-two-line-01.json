{
  "meta": {
    "id": "black-frame-two-line-01",
    "name": "Two Lines",
    "nameI18n": {
      "zh": "黑框双行",
      "en": "Two Lines"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.07,
      "bottom": 0.24,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#111214"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.145
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F2F2F2",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
