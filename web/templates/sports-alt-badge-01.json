{
  "meta": {
    "id": "sports-alt-badge-01",
    "name": "Altitude Badge",
    "nameI18n": {
      "zh": "海拔徽章",
      "en": "Altitude Badge"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.07,
      "bottom": 0.24,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.1833
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "mountain",
      "anchor": "bottom-left",
      "asset": "@builtin/frame/icon-mountain",
      "size": {
        "height": 0.026
      },
      "tint": "auto",
      "attachGap": 0.014
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.1254
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "weekday": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.gps_alt, 'SUMMIT')",
        "fallback": "SUMMIT",
        "role": "display"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
