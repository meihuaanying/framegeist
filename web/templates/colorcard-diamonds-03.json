{
  "meta": {
    "id": "colorcard-diamonds-03",
    "name": "Diamond Row",
    "nameI18n": {
      "zh": "菱形色列",
      "en": "Diamond Row"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.05,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.22,
      "offsetX": 0,
      "offsetY": 0.025
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.036
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.015
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.16
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.017,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.09
      },
      "count": 5,
      "shape": "diamond",
      "direction": "horizontal",
      "size": 0.045,
      "gap": 0.02,
      "showHex": true,
      "label": {
        "size": 0.011,
        "color": "#6B7280",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.05
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#B9BEC6",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
