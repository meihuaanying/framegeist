{
  "meta": {
    "id": "film-darkroom-pillar-03",
    "name": "Darkroom Pillar",
    "nameI18n": {
      "zh": "暗房立柱",
      "en": "Darkroom Pillar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.24,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#EFE8DC"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "pillar-left",
      "anchor": "top-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.06,
        "height": 1
      },
      "color": "#101010"
    },
    {
      "type": "shape",
      "id": "pillar-right",
      "anchor": "top-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.06,
        "height": 1
      },
      "color": "#101010"
    },
    {
      "type": "shape",
      "id": "pillar-left-base",
      "anchor": "top-left",
      "offset": {
        "x": 0,
        "y": 0.7519
      },
      "shape": "rect",
      "size": {
        "width": 0.06,
        "height": 0.09
      },
      "color": "#101010"
    },
    {
      "type": "shape",
      "id": "pillar-right-base",
      "anchor": "top-right",
      "offset": {
        "x": 0,
        "y": 0.7519
      },
      "shape": "rect",
      "size": {
        "width": 0.06,
        "height": 0.09
      },
      "color": "#101010"
    },
    {
      "type": "shape",
      "id": "plate",
      "anchor": "bottom-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.24
      },
      "color": "#101010"
    },
    {
      "type": "shape",
      "id": "plate-tab",
      "anchor": "bottom-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.12,
        "height": 0.24
      },
      "color": "#101010"
    },
    {
      "type": "image",
      "id": "edgecode",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.12
      },
      "asset": "@builtin/frame/film-edge",
      "size": {
        "width": 0.82
      },
      "opacity": 0.75
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1,
        "y": -0.018
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F1ECDF",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'FG 400'",
        "fallback": "FILM",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
