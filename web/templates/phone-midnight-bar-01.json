{
  "meta": {
    "id": "phone-midnight-bar-01",
    "name": "Midnight Bar",
    "nameI18n": {
      "zh": "午夜黑条",
      "en": "Midnight Bar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.055,
      "right": 0.07,
      "bottom": 0.185,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#101216"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.139
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#FFFFFF2E"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.0847
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F5F5F7",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')",
        "fallback": "MOBILE CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
