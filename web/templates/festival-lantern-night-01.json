{
  "meta": {
    "id": "festival-lantern-night-01",
    "name": "Night Lanterns",
    "nameI18n": {
      "zh": "灯会之夜",
      "en": "Night Lanterns"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
