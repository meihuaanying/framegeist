        "width": 0.94,
        "height": 0.94
      },
      "color": "#D4A017",
      "strokeWidth": 0.0018
    },
    {
      "type": "image",
      "id": "lantern-1",
      "anchor": "top-left",
      "offset": {
        "x": 0.035,
        "y": 0.035
