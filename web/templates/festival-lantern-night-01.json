      "asset": "@builtin/frame/icon-lantern",
      "size": {
        "height": 0.038
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "lantern-2",
      "anchor": "top-left",
      "offset": {
        "x": 0.083,
        "y": 0.035
      },
      "asset": "@builtin/frame/icon-lantern",
      "size": {
        "height": 0.038
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "lantern-3",
      "anchor": "top-left",
      "offset": {
        "x": 0.131,
        "y": 0.035
      },
      "asset": "@builtin/frame/icon-lantern",
      "size": {
        "height": 0.038
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.04,
        "y": -0.045
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.06
      }
    }
  ],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "auto",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'灯会'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'LANTERN NIGHT · FRAMEGEIST'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
