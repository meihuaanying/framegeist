{
  "meta": {
    "id": "game-zzz-v1",
    "name": "Zenless Zone Zero · Hero Frame",
    "nameI18n": {
      "zh": "绝区零 · 主题边框",
      "en": "Zenless Zone Zero · Hero Frame"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "game",
    "notice": "Unofficial fan-made design; game names and trademarks belong to their respective owners."
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.05,
      "bottom": 0.16,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#101012"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "game-mark",
      "asset": "@builtin/game/zzz",
      "size": {
        "height": 0.06
      },
      "anchor": "top-left",
      "offset": {
        "x": 0.03,
        "y": 0.035
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.06
      },
      "anchor": "bottom-left",
      "attachGap": 0.01
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F2E55C",
    "font": {
      "family": [
        "Bricolage Grotesque",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "exif.model_pretty · exif.lens",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
        "fallback": "framegeist",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": "2026.09.12",
        "role": "detail"
      }
    ]
  }
}
