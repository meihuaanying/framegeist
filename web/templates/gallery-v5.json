{
  "meta": {
    "id": "gallery-v5",
    "name": "Gallery Mat V5",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "gallery"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.128,
      "right": 0.128,
      "bottom": 0.20800000000000002,
      "left": 0.128
    },
    "background": {
      "type": "solid",
      "color": "#EFEEEA"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "artist",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.024,
        "weight": 600,
        "color": "#2B2B2B"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.025,
        "y": -0.06
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.02
      },
      "attachTo": "artist",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "series",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#6A6A6A"
      },
      "content": [
        {
          "expr": "fmt('Gallery Series 05', exif)",
          "fallback": "Gallery Series"
        }
      ],
      "offset": {
        "x": -0.025,
        "y": -0.06
      }
    }
  ]
}
