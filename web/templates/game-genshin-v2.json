    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 500,
        "color": "auto"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.025,
        "y": -0.095
      }
    }
  ]
}
