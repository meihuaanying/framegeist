{
  "meta": {
    "id": "camera-baseplate-02",
    "name": "Base Plate",
    "nameI18n": {
      "zh": "底盖机身",
      "en": "Base Plate"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.07,
      "right": 0.07,
      "bottom": 0.4,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#17171B"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.05
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.22
      },
      "tint": "light"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "light"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.055,
        "y": 0.03
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0138,
        "color": "#A7ABB3",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.733
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0012
      },
      "color": "#FFFFFF30"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.055,
        "y": -0.245
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0216,
        "color": "#F4F4F2",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.245
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.015,
        "color": "#C3C7CE",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
