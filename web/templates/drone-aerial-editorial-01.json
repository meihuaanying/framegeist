{
  "meta": {
    "id": "drone-aerial-editorial-01",
    "name": "Aerial Editorial",
    "nameI18n": {
      "zh": "航拍编辑",
      "en": "Aerial Editorial"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.24,
      "right": 0.13,
      "bottom": 0.16,
      "left": 0.13
    },
    "background": {
      "type": "solid",
      "color": "#EDF1F5"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule1",
      "anchor": "top-left",
      "offset": {
        "x": 0.1032,
        "y": 0.1
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0012
      },
      "color": "#1A1A1A"
    },
    {
      "type": "shape",
      "id": "rule2",
      "anchor": "top-left",
      "offset": {
        "x": 0.1082,
        "y": 0.105
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0008
      },
      "color": "#1A1A1A",
      "opacity": 0.35
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1032,
        "y": -0.0364
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "weekday": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'AERIAL'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'AERIAL UNIT')",
        "fallback": "AERIAL UNIT",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
