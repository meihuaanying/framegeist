{
  "meta": {
    "id": "camera-topdeck-bar-01",
    "name": "Top Deck Plate",
    "nameI18n": {
      "zh": "顶盖机身条",
      "en": "Top Deck Plate"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.34,
      "right": 0.07,
      "bottom": 0.1,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#F3F0E9"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.03
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.21
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.055,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.936
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0012
      },
      "color": "#DDD6C8",
      "autoHide": true
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
