{
  "meta": {
    "id": "camera-topdeck-bar-01",
    "name": "Top Deck Plate",
    "nameI18n": { "zh": "顶盖机身条", "en": "Top Deck Plate" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.34, "right": 0.07, "bottom": 0.10, "left": 0.07 },
    "background": { "type": "solid", "color": "#F3F0E9" }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.030 },
      "asset": "@builtin/frame/camera-body",
      "size": { "height": 0.21 },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": { "x": 0.055, "y": 0.028 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.017 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.055, "y": 0.034 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#8E9298" },
      "letterSpacing": 0.14,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "top-center",
      "offset": { "x": 0, "y": 0.936 },
      "shape": "line",
      "size": { "width": 1.0, "height": 0.0012 },
      "color": "#DDD6C8"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.055, "y": -0.035 },
      "font": { "family": ["Inter"], "size": 0.018, "color": "#1A1A1A" },
      "letterSpacing": 0.06,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.055, "y": -0.035 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
