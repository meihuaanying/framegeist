{
  "meta": {
    "id": "borderless-v5",
    "name": "Borderless 5",
    "nameI18n": {
      "zh": "无边框 5",
      "en": "Borderless 5"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "overlay",
    "background": {
      "type": "none"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "middle-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.03,
        "weight": 600,
        "color": "auto"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.025,
        "y": 0
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.026
      },
      "anchor": "middle-left",
      "offset": {
        "x": 0.025,
        "y": 0.05
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "middle-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.017,
        "weight": 400,
        "color": "auto"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0.025,
        "y": 0.085
      }
    }
  ]
}
