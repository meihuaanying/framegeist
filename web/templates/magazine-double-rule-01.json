{
  "meta": {
    "id": "magazine-double-rule-01",
    "name": "Double Rule",
    "nameI18n": {
      "zh": "双线刊头",
      "en": "Double Rule"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.17,
      "right": 0.1,
      "bottom": 0.3,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "frame-outer",
      "anchor": "top-left",
      "offset": {
        "x": 0.1,
        "y": 0.1293
      },
      "shape": "rect",
      "size": {
        "width": 0.96,
        "height": 0.96
      },
      "color": "#1A1A1A",
      "strokeWidth": 0.0018
    },
    {
      "type": "shape",
      "id": "frame-inner",
      "anchor": "top-left",
      "offset": {
        "x": 0.1125,
        "y": 0.1395
      },
      "shape": "rect",
      "size": {
        "width": 0.93,
        "height": 0.93
      },
      "color": "#1A1A1A",
      "strokeWidth": 0.001,
      "opacity": 0.55
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1,
        "y": -0.1
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter",
        "Fraunces"
      ]
    },
    "lines": [
      {
        "expr": "'FRAME & LIGHT'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
