{
  "meta": {
    "id": "magazine-double-rule-01",
    "name": "Double Rule",
    "nameI18n": {
      "zh": "双线刊头",
      "en": "Double Rule"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.17,
      "right": 0.1,
      "bottom": 0.3,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "masthead",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.035
      },
      "font": {
        "family": [
          "Fraunces"
        ],
        "size": 0.052,
        "color": "#1A1A1A",
        "weight": 600
      },
      "letterSpacing": 0.1,
      "content": [
        {
          "expr": "'FRAME & LIGHT'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "issue",
      "anchor": "top-right",
      "offset": {
        "x": -0.1,
        "y": 0.042
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "lineHeight": 1.6,
      "align": "right",
      "content": [
        {
          "expr": "'Nº 01 — PHOTOGRAPHY'",
          "fallback": null
        },
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "frame-outer",
      "anchor": "top-left",
      "offset": {
        "x": 0.1,
        "y": 0.1293
      },
      "shape": "rect",
      "size": {
        "width": 0.96,
        "height": 0.96
      },
      "color": "#1A1A1A",
      "strokeWidth": 0.0018
    },
    {
      "type": "shape",
      "id": "frame-inner",
      "anchor": "top-left",
      "offset": {
        "x": 0.1125,
        "y": 0.1395
      },
      "shape": "rect",
      "size": {
        "width": 0.93,
        "height": 0.93
      },
      "color": "#1A1A1A",
      "strokeWidth": 0.001,
      "opacity": 0.55
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1,
        "y": -0.101
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1,
        "y": -0.057
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1,
        "y": -0.1
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "slogan",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1,
        "y": -0.057
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.24,
      "align": "right",
      "content": [
        {
          "expr": "'LIGHT, HELD STILL'",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
