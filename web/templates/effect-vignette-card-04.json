{
  "meta": {
    "id": "effect-vignette-card-04",
    "name": "Vignette Card",
    "nameI18n": {
      "zh": "暗角卡片",
      "en": "Vignette Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.05,
      "bottom": 0.16,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#121212"
    },
    "radius": 0.035,
    "shadow": {
      "enabled": true,
      "blur": 0.12,
      "opacity": 0.4,
      "offsetX": 0,
      "offsetY": 0.03
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "band-top",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.3409
      },
      "shape": "rect",
      "size": {
        "width": 0.95,
        "height": 0.1
      },
      "color": "#000000",
      "opacity": 0.38
    },
    {
      "type": "shape",
      "id": "band-bottom",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.3409
      },
      "shape": "rect",
      "size": {
        "width": 0.95,
        "height": 0.1
      },
      "color": "#000000",
      "opacity": 0.38
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
