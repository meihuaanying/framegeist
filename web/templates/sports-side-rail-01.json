{
  "meta": {
    "id": "sports-side-rail-01",
    "name": "Trail Rail",
    "nameI18n": {
      "zh": "侧栏竖排",
      "en": "Trail Rail"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.05,
      "bottom": 0.06,
      "left": 0.13
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "railrule",
      "anchor": "middle-center",
      "offset": {
        "x": -0.392,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.6,
        "height": 0.0015
      },
      "rotation": 90,
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.017,
        "y": -0.0277
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.gps_alt, 'TRAIL')",
        "fallback": "TRAIL",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": "TRAIL DAY",
        "role": "detail"
      }
    ]
  }
}
