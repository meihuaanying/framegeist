{
  "meta": {
    "id": "white-border-linen-dot",
    "name": "Linen Dot",
    "nameI18n": {
      "zh": "亚麻朱点",
      "en": "Linen Dot"
    },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.07,
      "bottom": 0.26,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#F2F0EC"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.101
      },
      "shape": "ellipse",
      "size": {
        "width": 0.012,
        "height": 0.016
      },
      "color": "#E10600"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.088,
        "y": -0.098
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.019,
        "color": "#1A1A1A"
      },
      "letterSpacing": 0.04,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Unknown Camera"
        }
      ]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.098
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.052
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#9AA0A6"
      },
      "letterSpacing": 0.12,
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0614,
        "y": -0.052
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.05,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
