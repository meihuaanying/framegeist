{
  "meta": {
    "id": "technical-v5",
    "name": "Technical Plate V5",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "technical"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.045,
      "right": 0.045,
      "bottom": 0.11,
      "left": 0.045
    },
    "background": {
      "type": "solid",
      "color": "#1E1408"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "plate",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.02,
        "weight": 400,
        "color": "#FFD37F"
      },
      "content": [
        {
          "expr": "fmt('CAM: {model}', exif)",
          "fallback": "CAM: n/a"
        },
        {
          "expr": "fmt('LNS: {lens}', exif)",
          "fallback": "LNS: n/a"
        },
        {
          "expr": "fmt('EXP: f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "EXP: n/a"
        }
      ],
      "lineHeight": 1.5,
      "offset": {
        "x": 0.02,
        "y": -0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.022
      },
      "attachTo": "plate",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "meta",
      "anchor": "top-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.014,
        "weight": 400,
        "color": "#FFD37F"
      },
      "content": [
        {
          "expr": "date('YYYY/MM/DD HH:mm', exif.datetime)",
          "fallback": "no date"
        }
      ],
      "offset": {
        "x": -0.02,
        "y": 0.03
      }
    }
  ]
}
