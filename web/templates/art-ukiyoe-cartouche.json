{
  "meta": {
    "id": "art-ukiyoe-cartouche",
    "name": "Ukiyo-e Cartouche",
    "nameI18n": {
      "zh": "浮世绘题签",
      "en": "Ukiyo-e Cartouche"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.26,
      "bottom": 0.1,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#F6EFDF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "ukiyo-panel",
      "anchor": "middle-right",
      "offset": {
        "x": -0.058,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.155,
        "height": 0.6
      },
      "color": "#FBF6E8",
      "opacity": 1,
      "radius": 0.04
    },
    {
      "type": "shape",
      "id": "ukiyo-panel-line",
      "anchor": "middle-right",
      "offset": {
        "x": -0.058,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.155,
        "height": 0.6
      },
      "color": "#3A342A",
      "opacity": 0.9,
      "radius": 0.04,
      "strokeWidth": 0.0012
    },
    {
      "type": "shape",
      "id": "ukiyo-cloud-top",
      "anchor": "middle-center",
      "offset": {
        "x": 0.383,
        "y": -0.275
      },
      "shape": "line",
      "size": {
        "width": 0.15,
        "height": 0.0012
      },
      "color": "#9C8B6B",
      "opacity": 0.95,
      "double": true,
      "gap": 0.004
    },
    {
      "type": "shape",
      "id": "ukiyo-cloud-bottom",
      "anchor": "middle-center",
      "offset": {
        "x": 0.383,
        "y": 0.278
      },
      "shape": "line",
      "size": {
        "width": 0.15,
        "height": 0.0012
      },
      "color": "#9C8B6B",
      "opacity": 0.95,
      "double": true,
      "gap": 0.004
    },
    {
      "type": "image",
      "id": "ukiyo-seal",
      "anchor": "middle-center",
      "offset": {
        "x": 0.383,
        "y": 0.19
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.058
      },
      "opacity": 1,
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#2B241C",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'潮' · '汐' · '绘' · '卷'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'The Floating World'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Provincial Camera')",
        "fallback": "Provincial Camera",
        "role": "detail"
      }
    ]
  }
}
