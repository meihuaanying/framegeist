{
  "meta": {
    "id": "lens-icon-v3",
    "name": "Lens Badge 3",
    "nameI18n": {
      "zh": "镜头徽章 3",
      "en": "Lens Badge 3"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "technical"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.05,
      "bottom": 0.12,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#101820"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "series",
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.07
      },
      "anchor": "top-left",
      "offset": {
        "x": 0.025,
        "y": 0.04
      },
      "tint": "light"
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.032
      },
      "anchor": "top-right",
      "offset": {
        "x": -0.025,
        "y": 0.045
      }
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.022,
        "weight": 500,
        "color": "#9AD1FF"
      },
      "content": [
        {
          "expr": "exif.lens",
          "fallback": "Unknown Lens"
        }
      ],
      "offset": {
        "x": 0.025,
        "y": -0.06
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#9AD1FF"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.025,
        "y": -0.06
      }
    }
  ]
}
