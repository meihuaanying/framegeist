{
  "meta": {
    "id": "film-v2",
    "name": "Film V2",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.12,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#101010"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "filmstock",
      "anchor": "top-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.018,
        "weight": 400,
        "color": "#D8B24A"
      },
      "content": [
        {
          "expr": "'KODAK 400 2'",
          "fallback": "FILM"
        }
      ],
      "offset": {
        "x": 0.015,
        "y": 0.02
      }
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.026,
        "weight": 600,
        "color": "#D8B24A"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.02,
        "y": -0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.022
      },
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.018,
        "weight": 400,
        "color": "#D8B24A"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.02,
        "y": -0.055
      }
    }
  ]
}
