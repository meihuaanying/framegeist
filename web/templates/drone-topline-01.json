{
  "meta": {
    "id": "drone-topline-01",
    "name": "Drone Topline",
    "nameI18n": {
      "zh": "顶部航标",
      "en": "Drone Topline"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.075,
      "bottom": 0.075,
      "left": 0.075
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F4"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.0652,
        "y": 0.0178
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "toprule",
      "anchor": "top-left",
      "offset": {
        "x": 0.0652,
        "y": 0.1093
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA",
      "autoHide": true
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "weekday": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "#373A40",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'AERIAL UNIT')",
        "fallback": "AERIAL UNIT",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
