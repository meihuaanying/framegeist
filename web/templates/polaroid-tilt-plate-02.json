{
  "meta": {
    "id": "polaroid-tilt-plate-02",
    "name": "Tilt Plate",
    "nameI18n": {
      "zh": "斜置日期卡",
      "en": "Tilt Plate"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.09,
      "bottom": 0.3,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#E8DFD2"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "plate",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1,
        "y": -0.055
      },
      "shape": "rect",
      "size": {
        "width": 0.58,
        "height": 0.2
      },
      "color": "#FFFFFF",
      "radius": 0.02,
      "rotation": -2.5
    },
    {
      "type": "image",
      "id": "stamp",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.09,
        "y": -0.05
      },
      "asset": "@builtin/frame/stamp-card",
      "size": {
        "height": 0.18
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.076,
        "y": 0.05
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('YYYY', exif.datetime) · date('MM.DD', exif.datetime)",
        "fallback": "2026",
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      },
      {
        "expr": "'SHANGHAI, CN'",
        "fallback": "CITY",
        "role": "detail"
      }
    ]
  }
}
