{
  "meta": {
    "id": "phone-studio-card-01",
    "name": "Studio Card",
    "nameI18n": { "zh": "影棚白卡", "en": "Studio Card" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.09, "right": 0.1, "bottom": 0.24, "left": 0.1 },
    "background": { "type": "solid", "color": "#F5F5F7" },
    "radius": 0.02,
    "shadow": { "enabled": true, "blur": 0.08, "opacity": 0.22, "offsetX": 0, "offsetY": 0.015 }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandtop",
      "anchor": "top-left",
      "offset": { "x": 0.0833, "y": 0.028 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.02 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.0833, "y": 0.034 },
      "font": { "family": ["JetBrains Mono"], "size": 0.01, "color": "#9AA0A6" },
      "letterSpacing": 0.18,
      "align": "right",
      "content": [
        { "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.1015 },
      "font": { "family": ["Inter"], "size": 0.02, "color": "#1A1A1A" },
      "letterSpacing": 0.02,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Device')", "fallback": "Unknown Device" }
      ]
    },
    {
      "type": "text",
      "id": "camera",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.0741 },
      "font": { "family": ["JetBrains Mono"], "size": 0.013, "color": "#6B7280" },
      "letterSpacing": 0.06,
      "content": [
        { "expr": "exif.lens", "fallback": "MAIN CAMERA" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.0462 },
      "font": { "family": ["JetBrains Mono"], "size": 0.013, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brandfoot",
      "anchor": "bottom-right",
      "offset": { "x": -0.0833, "y": -0.0466 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.016 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "copyright",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.0156 },
      "font": { "family": ["Inter"], "size": 0.0088, "color": "#9AA0A6" },
      "letterSpacing": 0.12,
      "content": [
        { "expr": "'© 2026 FRAMEGEIST'", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
