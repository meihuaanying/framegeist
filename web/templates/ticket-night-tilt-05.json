{
  "meta": {
    "id": "ticket-night-tilt-05",
    "name": "Night Tilt",
    "nameI18n": {
      "zh": "夜行票·斜卡",
      "en": "Night Tilt"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "ticket"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.34,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#14161A"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "card",
      "anchor": "top-left",
      "offset": {
        "x": 0.1,
        "y": 0.6
      },
      "shape": "rect",
      "size": {
        "width": 0.72,
        "height": 0.2
      },
      "color": "#F7F5F0",
      "radius": 0.04,
      "rotation": -6
    },
    {
      "type": "image",
      "id": "barcode",
      "anchor": "top-left",
      "offset": {
        "x": 0.135,
        "y": 0.8
      },
      "asset": "@builtin/frame/barcode",
      "size": {
        "height": 0.042
      }
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "top-left",
      "offset": {
        "x": 0.78,
        "y": 0.79
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.075
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.069,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1C1F23",
    "font": {
      "family": [
        "Bricolage Grotesque",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'CHENGDU · LHASA'",
        "fallback": "FROM · TO",
        "role": "support"
      },
      {
        "expr": "'NO. 0007'",
        "fallback": "TICKET NO.",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
