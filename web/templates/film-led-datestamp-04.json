{
  "meta": {
    "id": "film-led-datestamp-04",
    "name": "LED Datestamp",
    "nameI18n": {
      "zh": "橙红日期章",
      "en": "LED Datestamp"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.07,
      "bottom": 0.26,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#121212"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "strip-corner",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.035
      },
      "asset": "@builtin/frame/film-strip",
      "size": {
        "width": 0.62
      }
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.1486
      },
      "shape": "line",
      "size": {
        "width": 0.34,
        "height": 0.0015
      },
      "color": "#3A3632"
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.018
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "#FF5A2D",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "date('YYYY', exif.datetime) · date('MM  DD', exif.datetime)",
        "fallback": "2026",
        "role": "display"
      },
      {
        "expr": "'FG 800'",
        "fallback": "FILM",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
