{
  "meta": {
    "id": "effect-duotone-wash-03",
    "name": "Duotone Wash",
    "nameI18n": {
      "zh": "双色晕染",
      "en": "Duotone Wash"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.22,
      "left": 0.08
    },
    "background": {
      "type": "tint"
    },
    "radius": 0.03,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.28,
      "offsetX": 0,
      "offsetY": 0.025
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "wash-a",
      "anchor": "middle-center",
      "offset": {
        "x": 0.08,
        "y": 0
      },
      "shape": "ellipse",
      "size": {
        "width": 0.75,
        "height": 0.85
      },
      "color": "#1F5C4C",
      "opacity": 0.2
    },
    {
      "type": "shape",
      "id": "wash-b",
      "anchor": "middle-center",
      "offset": {
        "x": -0.15,
        "y": 0.1
      },
      "shape": "ellipse",
      "size": {
        "width": 0.5,
        "height": 0.5
      },
      "color": "#D97757",
      "opacity": 0.14
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.036
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
