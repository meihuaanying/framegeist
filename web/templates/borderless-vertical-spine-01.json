{
  "meta": {
    "id": "borderless-vertical-spine-01",
    "name": "Vertical Spine",
    "nameI18n": {
      "zh": "左轴竖排",
      "en": "Vertical Spine"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "overlay"
  },
  "layers": [
    {
      "type": "text",
      "id": "spine",
      "anchor": "middle-left",
      "offset": {
        "x": -0.03,
        "y": 0
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "opacity": 0.85,
      "rotation": 90,
      "content": [
        {
          "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.072
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "opacity": 0.9,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "tail",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "lineHeight": 1.6,
      "opacity": 0.8,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        },
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
