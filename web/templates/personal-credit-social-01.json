{
  "meta": {
    "id": "personal-credit-social-01",
    "name": "Credit Social",
    "nameI18n": {
      "zh": "署名社交",
      "en": "Credit Social"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.09,
      "bottom": 0.28,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#F2F0EC"
    },
    "radius": 0.01,
    "shadow": {
      "enabled": true,
      "blur": 0.05,
      "opacity": 0.16,
      "offsetX": 0,
      "offsetY": 0.012
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.0763,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.16
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.024,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "credit",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.112
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.18,
      "content": [
        {
          "expr": "'PHOTOGRAPHY BY YOUR NAME · @INSTAGRAM'",
          "fallback": "PHOTOGRAPHY BY YOUR NAME"
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.06
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "stamp",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0763,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('YYYY.MM.DD · WW', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
