{
  "meta": {
    "id": "minimal-portrait-line",
    "name": "Portrait Line",
    "nameI18n": { "zh": "竖构图单行", "en": "Portrait Line" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.05, "right": 0.05, "bottom": 0.075, "left": 0.05 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "line",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.026 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0135, "color": "#373A40" },
      "letterSpacing": 0.05,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{model_pretty} — {focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
