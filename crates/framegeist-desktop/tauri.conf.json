{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameGeist",
  "version": "0.1.1",
  "identifier": "app.framegeist.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "FrameGeist · 框灵",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' https://api.github.com; manifest-src 'self'; worker-src 'self'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}

