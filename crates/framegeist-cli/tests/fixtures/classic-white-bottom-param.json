{
  "meta": {
    "id": "classic-white-bottom-param",
    "name": "Classic White - Bottom Params",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "classic-white"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.06, "right": 0.06, "bottom": 0.14, "left": 0.06 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "primary",
      "anchor": "bottom-left",
      "offset": { "x": 0.02, "y": -0.05 },
      "font": { "family": ["JetBrains Mono"], "size": 0.028, "weight": 600, "color": "#111111" },
      "lineHeight": 1.3,
      "content": [
        { "expr": "exif.model_pretty", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.02, "y": -0.05 },
      "font": { "family": ["JetBrains Mono"], "size": 0.022, "weight": 400, "color": "#666666" },
      "content": [
        { "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-left",
      "offset": { "x": 0.02, "y": -0.09 },
      "font": { "family": ["JetBrains Mono"], "size": 0.02, "weight": 400, "color": "#999999" },
      "content": [
        { "expr": "exif.lens", "fallback": null }
      ]
    }
  ]
}

