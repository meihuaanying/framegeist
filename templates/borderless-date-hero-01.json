{
  "meta": {
    "id": "borderless-date-hero-01",
    "name": "Date Hero",
    "nameI18n": {
      "zh": "日期主角",
      "en": "Date Hero"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
