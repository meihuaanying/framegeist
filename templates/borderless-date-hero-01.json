{
  "meta": {
    "id": "borderless-date-hero-01",
    "name": "Date Hero",
    "nameI18n": {
      "zh": "日期主角",
      "en": "Date Hero"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "overlay"
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.185
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.16,
      "opacity": 0.85,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.152
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.1,
      "opacity": 0.78,
      "content": [
        {
          "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "daynumber",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.114,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0.015,
      "opacity": 0.9,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
