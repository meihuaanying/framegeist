{
  "meta": {
    "id": "borderless-date-hero-01",
    "name": "Date Hero",
    "nameI18n": { "zh": "日期主角", "en": "Date Hero" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": { "x": -0.03, "y": 0.028 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.185 },
      "font": { "family": ["Inter"], "size": 0.015, "color": "auto" },
      "letterSpacing": 0.16,
      "opacity": 0.85,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.152 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.1,
      "opacity": 0.78,
      "content": [
        { "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "daynumber",
      "anchor": "bottom-left",
      "offset": { "x": 0.03, "y": -0.032 },
      "font": { "family": ["Bebas Neue"], "size": 0.095, "color": "auto" },
      "letterSpacing": 0.015,
      "opacity": 0.9,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "date": { "type": "string", "source": "exif" }
  }
}
