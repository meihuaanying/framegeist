{
  "meta": {
    "id": "calendar-portrait-stack-01",
    "name": "Portrait Stack",
    "nameI18n": {
      "zh": "竖幅日历",
      "en": "Portrait Stack"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.1,
      "bottom": 0.26,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#F5F2EC"
    }
  },
  "layers": [
    {
      "type": "calendar",
      "id": "daycard",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.03
      },
      "size": 0.14,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "view": "day",
      "color": "#373A40",
      "accent": "#1A1A1A",
      "fontFamily": [
        "Inter"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#6B7280",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "exif.weekday_cn",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
