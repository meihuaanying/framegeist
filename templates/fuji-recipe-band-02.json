{
  "meta": {
    "id": "fuji-recipe-band-02",
    "name": "Recipe Band",
    "nameI18n": {
      "zh": "奶白配方格",
      "en": "Recipe Band"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "fuji"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.07,
      "bottom": 0.34,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#F4EFE6"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "band-left",
      "anchor": "top-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.12
      },
      "color": "#17181A"
    },
    {
      "type": "shape",
      "id": "band-right",
      "anchor": "top-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.14,
        "height": 0.12
      },
      "color": "#17181A"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.1,
        "y": 0.03
      },
      "asset": "@builtin/brand/fujifilm",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1B1C1E",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'NOSTALGIC NEG'",
        "fallback": "RECIPE",
        "role": "support"
      },
      {
        "expr": "'AUTO'",
        "fallback": "AUTO",
        "role": "support"
      },
      {
        "expr": "'DR100'",
        "fallback": "DR",
        "role": "support"
      }
    ]
  }
}
