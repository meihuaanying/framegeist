{
  "meta": {
    "id": "art-letterpress-relief",
    "name": "Letterpress Relief",
    "nameI18n": {
      "zh": "压印浮雕",
      "en": "Letterpress Relief"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.07,
      "bottom": 0.22,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "press-frame",
      "anchor": "middle-center",
      "shape": "rect",
      "size": {
        "width": 0.9,
        "height": 0.9
      },
      "color": "#D9D2C4",
      "opacity": 1,
      "strokeWidth": 0.0009,
      "frame": "outer",
      "margin": 0.035
    },
    {
      "type": "shape",
      "id": "press-rule-dark",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.1525
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0015
      },
      "color": "#C9C2B4",
      "opacity": 0.95
    },
    {
      "type": "shape",
      "id": "press-rule-light",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.148
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0015
      },
      "color": "#FFFFFF",
      "opacity": 0.95
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#373A40",
    "font": {
      "family": [
        "Glow Sans SC",
        "Geist",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'Pressed Light'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'纸上年华'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Press No. 03')",
        "fallback": "Press No. 03",
        "role": "detail"
      }
    ]
  }
}
