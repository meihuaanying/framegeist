{
  "meta": {
    "id": "os-expo-left-v1",
    "name": "Expo Left",
    "nameI18n": {
      "zh": "展览左栏",
      "en": "Expo Left"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "gallery"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.3,
      "bottom": 0.08,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FAFAF8"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "middle-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.022,
        "weight": 600,
        "color": "#1A1A1A"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": 0.03
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "middle-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.014,
        "weight": 400,
        "color": "#666666"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.005
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.02
      },
      "anchor": "middle-left",
      "offset": {
        "x": 0.03,
        "y": -0.04
      },
      "tint": "dark"
    }
  ]
}
