{
  "meta": {
    "id": "magazine-index-column-01",
    "name": "Lumen Index",
    "nameI18n": { "zh": "索引栏目", "en": "Lumen Index" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.11, "right": 0.36, "bottom": 0.13, "left": 0.08 },
    "background": { "type": "solid", "color": "#FAF8F3" }
  },
  "layers": [
    {
      "type": "text",
      "id": "masthead",
      "anchor": "top-left",
      "offset": { "x": 0.778, "y": 0.032 },
      "font": { "family": ["Playfair Display"], "size": 0.026, "color": "#1A1A1A" },
      "letterSpacing": 0.12,
      "content": [{ "expr": "'LUMEN INDEX'", "fallback": null }]
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": { "x": 0.7604, "y": 0.05 },
      "shape": "rect",
      "size": { "width": 0.0012, "height": 0.62 },
      "color": "#D9D4CA"
    },
    {
      "type": "text",
      "id": "entries",
      "anchor": "top-left",
      "offset": { "x": 0.778, "y": 0.085 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#373A40" },
      "letterSpacing": 0.06,
      "lineHeight": 1.85,
      "content": [
        { "expr": "fmt('01 — CAMERA · {model_pretty}', exif)", "fallback": null },
        { "expr": "fmt('02 — LENS · {lens}', exif)", "fallback": null },
        { "expr": "fmt('03 — FRAME · {focal}mm · f/{aperture}', exif)", "fallback": null },
        { "expr": "fmt('04 — EXPOSURE · {shutter} · ISO{iso}', exif)", "fallback": null },
        { "expr": "'05 — LIGHT · STUDIO NOTES'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": { "x": 0.778, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#9AA0A6" },
      "letterSpacing": 0.20,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": { "x": 0.0556, "y": -0.045 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.0556, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
