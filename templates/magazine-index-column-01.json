{
  "meta": {
    "id": "magazine-index-column-01",
    "name": "Lumen Index",
    "nameI18n": {
      "zh": "索引栏目",
      "en": "Lumen Index"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.11,
      "right": 0.36,
      "bottom": 0.13,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.7604,
        "y": 0.05
      },
      "shape": "rect",
      "size": {
        "width": 0.0012,
        "height": 0.62
      },
      "color": "#D9D4CA"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0556,
        "y": -0.045
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'LUMEN INDEX'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('01 — CAMERA · {model_pretty}', exif) · fmt('02 — LENS · {lens}', exif) · fmt('03 — FRAME · {focal}mm · f/{aperture}', exif) · fmt('04 — EXPOSURE · {shutter} · ISO{iso}', exif) · '05 — LIGHT · STUDIO NOTES'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
