{
  "meta": {
    "id": "colorcard-column-02",
    "name": "Night Column",
    "nameI18n": {
      "zh": "夜幕色柱",
      "en": "Night Column"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.3,
      "bottom": 0.14,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#1C1C1E"
    },
    "radius": 0.03,
    "shadow": {
      "enabled": true,
      "blur": 0.12,
      "opacity": 0.4,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "#9BA0A8",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.07,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "middle-right",
      "offset": {
        "x": -0.1,
        "y": 0.02
      },
      "count": 5,
      "shape": "square",
      "direction": "vertical",
      "size": 0.036,
      "gap": 0.016,
      "showHex": true,
      "label": {
        "size": 0.0095,
        "color": "#C9CCD2",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.06
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "#F0EFEA",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#9BA0A8",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
