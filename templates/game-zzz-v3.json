{
  "meta": {
    "id": "game-zzz-v3",
    "name": "Zenless Zone Zero · Poster Card",
    "nameI18n": {
      "zh": "绝区零 · 海报卡",
      "en": "Zenless Zone Zero · Poster Card"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "game",
    "notice": "Unofficial fan-made design; game names and trademarks belong to their respective owners."
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.09,
      "bottom": 0.2,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#101012"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "game-mark",
      "asset": "@builtin/game/zzz",
      "size": {
        "height": 0.065
      },
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.05
      }
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "Bricolage Grotesque"
        ],
        "size": 0.0264,
        "weight": 500,
        "color": "#F2E55C"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.08
      },
      "features": [
        "tnum"
      ],
      "letterSpacing": 0
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.06
      },
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "weight": 500,
        "color": "#8A8F98"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.012
      },
      "letterSpacing": 0.08
    }
  ]
}
