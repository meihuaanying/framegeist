{
  "meta": {
    "id": "personal-cn-inscription-01",
    "name": "Ink Inscription",
    "nameI18n": {
      "zh": "墨色题记",
      "en": "Ink Inscription"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.12,
      "bottom": 0.3,
      "left": 0.12
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    },
    "radius": 0.01,
    "shadow": {
      "enabled": true,
      "blur": 0.05,
      "opacity": 0.15,
      "offsetX": 0,
      "offsetY": 0.012
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0968,
        "y": -0.052
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.055
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'光影手记'",
        "fallback": "光影手记",
        "role": "display"
      },
      {
        "expr": "date('YYYY年MM月DD日', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
