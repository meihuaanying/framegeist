{
  "meta": {
    "id": "colorful-sticker-date-01",
    "name": "Sticker Date",
    "nameI18n": {
      "zh": "贴纸日期",
      "en": "Sticker Date"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "tag-big",
      "anchor": "middle-center",
      "offset": {
        "x": -0.29,
        "y": 0.29
      },
      "shape": "rect",
      "size": {
        "width": 0.34,
        "height": 0.075
      },
      "color": "#F4B942",
      "radius": 0.06,
      "rotation": -5
    },
    {
      "type": "shape",
      "id": "tag-small",
      "anchor": "middle-center",
      "offset": {
        "x": -0.15,
        "y": -0.3325
      },
      "shape": "rect",
      "size": {
        "width": 0.26,
        "height": 0.055
      },
      "color": "#2A9D8F",
      "radius": 0.08,
      "rotation": 3
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.04,
        "y": 0.032
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
