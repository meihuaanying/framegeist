{
  "meta": {
    "id": "calendar-strip-date-01",
    "name": "Bottom Strip Date",
    "nameI18n": {
      "zh": "底栏日历",
      "en": "Bottom Strip Date"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.08,
      "bottom": 0.26,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.185
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA",
      "autoHide": true
    },
    {
      "type": "calendar",
      "id": "strip",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.115
      },
      "size": 0.34,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "view": "strip",
      "color": "#373A40",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter",
        "Noto Serif SC"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('DD', exif.datetime)",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "exif.weekday_cn",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
