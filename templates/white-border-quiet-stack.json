{
  "meta": {
    "id": "white-border-quiet-stack",
    "name": "Quiet Stack",
    "nameI18n": {
      "zh": "三行静置",
      "en": "Quiet Stack"
    },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.07,
      "bottom": 0.3,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.18
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.125
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "color": "#1A1A1A"
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Unknown Camera"
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.082
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.045
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#9AA0A6"
      },
      "letterSpacing": 0.14,
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
