{
  "meta": {
    "id": "colorful-pastel-card-01",
    "name": "Pastel Card",
    "nameI18n": { "zh": "粉彩卡", "en": "Pastel Card" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.12, "right": 0.11, "bottom": 0.26, "left": 0.11 },
    "background": { "type": "solid", "color": "#F6E7D8" },
    "radius": 0.035,
    "shadow": { "enabled": true, "blur": 0.10, "opacity": 0.25, "offsetX": 0, "offsetY": 0.02 }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.09, "y": 0.04 },
      "font": { "family": ["Inter"], "size": 0.017, "color": "#1A1A1A" },
      "letterSpacing": 0.05,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "shape",
      "id": "dot",
      "anchor": "top-right",
      "offset": { "x": -0.09, "y": 0.045 },
      "shape": "ellipse",
      "size": { "width": 0.012, "height": 0.016 },
      "color": "#E63946"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.09, "y": -0.155 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.09, "y": -0.095 },
      "font": { "family": ["JetBrains Mono"], "size": 0.013, "color": "#6B7280" },
      "letterSpacing": 0.12,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.09, "y": -0.095 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "kicker",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.045 },
      "font": { "family": ["Inter"], "size": 0.0105, "color": "#9AA0A6" },
      "letterSpacing": 0.28,
      "content": [{ "expr": "'PASTEL NOTES'", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
