{
  "meta": {
    "id": "colorful-pastel-card-01",
    "name": "Pastel Card",
    "nameI18n": {
      "zh": "粉彩卡",
      "en": "Pastel Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.11,
      "bottom": 0.26,
      "left": 0.11
    },
    "background": {
      "type": "solid",
      "color": "#F6E7D8"
    },
    "radius": 0.035,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.25,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot",
      "anchor": "top-right",
      "offset": {
        "x": -0.09,
        "y": 0.045
      },
      "shape": "ellipse",
      "size": {
        "width": 0.012,
        "height": 0.016
      },
      "color": "#E63946"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.09,
        "y": -0.155
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
