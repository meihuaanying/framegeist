{
  "meta": {
    "id": "portfolio-double-rule-01",
    "name": "Double Rule",
    "nameI18n": {
      "zh": "双线题签",
      "en": "Double Rule"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.13,
      "right": 0.09,
      "bottom": 0.3,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#F7F5F0"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rail-l",
      "anchor": "bottom-center",
      "offset": {
        "x": -0.16,
        "y": -0.15
      },
      "shape": "line",
      "size": {
        "width": 0.0015,
        "height": 0.055
      },
      "color": "#B9B2A4"
    },
    {
      "type": "shape",
      "id": "rail-r",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.16,
        "y": -0.15
      },
      "shape": "line",
      "size": {
        "width": 0.0015,
        "height": 0.055
      },
      "color": "#B9B2A4"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-left",
      "corner": "top-left",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'《光年》'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
