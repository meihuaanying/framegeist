{
  "meta": {
    "id": "effect-vignette-card-04",
    "name": "Vignette Card",
    "nameI18n": {
      "zh": "暗角卡片",
      "en": "Vignette Card"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.05,
      "bottom": 0.16,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#121212"
    },
    "radius": 0.035,
    "shadow": {
      "enabled": true,
      "blur": 0.12,
      "opacity": 0.4,
      "offsetX": 0,
      "offsetY": 0.03
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "band-top",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.3409
      },
      "shape": "rect",
      "size": {
        "width": 0.95,
        "height": 0.1
      },
      "color": "#000000",
      "opacity": 0.38
    },
    {
      "type": "shape",
      "id": "band-bottom",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.3409
      },
      "shape": "rect",
      "size": {
        "width": 0.95,
        "height": 0.1
      },
      "color": "#000000",
      "opacity": 0.38
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.05
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0228,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.05
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
