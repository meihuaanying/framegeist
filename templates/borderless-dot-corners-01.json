{
  "meta": {
    "id": "borderless-dot-corners-01",
    "name": "Dot Corners",
    "nameI18n": {
      "zh": "细点四角",
      "en": "Dot Corners"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot-tl",
      "anchor": "top-left",
      "offset": {
        "x": 0.028,
        "y": 0.032
      },
      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#9AA0A6",
      "opacity": 0.9
    },
    {
      "type": "shape",
      "id": "dot-tr",
      "anchor": "top-right",
      "offset": {
        "x": -0.028,
        "y": 0.032
      },
      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#9AA0A6",
      "opacity": 0.9
    },
    {
      "type": "shape",
      "id": "dot-bl",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.028,
        "y": -0.04
      },
      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#9AA0A6",
      "opacity": 0.9
    },
    {
      "type": "shape",
      "id": "dot-br",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.028,
        "y": -0.04
      },
      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#9AA0A6",
      "opacity": 0.9
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.046,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM F{aperture}', exif) · fmt('{shutter} ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
