{
  "meta": {
    "id": "borderless-center-caption-01",
    "name": "Center Caption",
    "nameI18n": {
      "zh": "居中铭牌",
      "en": "Center Caption"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "cameraicon",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.05
      },
      "asset": "@builtin/frame/icon-camera",
      "size": {
        "height": 0.018
      },
      "tint": "auto",
      "attachGap": 0.014
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "fmt('SHOT ON {model_pretty}', exif)",
        "fallback": "SHOT ON CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
