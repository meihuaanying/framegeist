{
  "meta": {
    "id": "blur-bg-center-01",
    "name": "Center Bloom",
    "nameI18n": {
      "zh": "居中晕影",
      "en": "Center Bloom"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "blur-bg"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.11,
      "bottom": 0.1,
      "left": 0.11
    },
    "background": {
      "type": "blur",
      "blur": 90,
      "scale": 1.3
    },
    "shadow": {
      "enabled": false
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.055,
        "y": -0.025
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
