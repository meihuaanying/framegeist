{
  "meta": {
    "id": "minimal-brand-right",
    "name": "Brand Right",
    "nameI18n": {
      "zh": "右下品牌",
      "en": "Brand Right"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "overlay",
    "background": {
      "type": "none"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.032,
        "y": -0.138
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.1,
      "opacity": 0.85,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'FRAMEGEIST')",
          "fallback": "FRAMEGEIST"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.032,
        "y": -0.085
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.032,
        "y": -0.036
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.9,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
