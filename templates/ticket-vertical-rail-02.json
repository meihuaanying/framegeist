      "size": {
        "width": 0.0195,
        "height": 0.026
      },
      "color": "#D5DCD4"
    },
    {
      "type": "image",
      "id": "barcode",
      "anchor": "top-left",
      "offset": {
        "x": 0.7277,
        "y": 0.096
