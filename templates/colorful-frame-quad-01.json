{
  "meta": {
    "id": "colorful-frame-quad-01",
    "name": "Quad Frame",
    "nameI18n": { "zh": "彩框四边", "en": "Quad Frame" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": { "mode": "overlay" },
  "layers": [
    {
      "type": "shape",
      "id": "bar-top",
      "anchor": "top-left",
      "offset": { "x": 0, "y": 0 },
      "shape": "rect",
      "size": { "width": 1.0, "height": 0.012 },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "bar-bottom",
      "anchor": "bottom-left",
      "offset": { "x": 0, "y": 0 },
      "shape": "rect",
      "size": { "width": 1.0, "height": 0.012 },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "bar-left",
      "anchor": "top-left",
      "offset": { "x": 0, "y": 0 },
      "shape": "rect",
      "size": { "width": 0.009, "height": 1.0 },
      "color": "#F4B942"
    },
    {
      "type": "shape",
      "id": "bar-right",
      "anchor": "top-right",
      "offset": { "x": 0, "y": 0 },
      "shape": "rect",
      "size": { "width": 0.009, "height": 1.0 },
      "color": "#457B9D"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": { "x": 0.038, "y": 0.032 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.16,
      "opacity": 0.9,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": { "x": -0.038, "y": 0.032 },
      "font": { "family": ["Inter"], "size": 0.013, "color": "auto" },
      "letterSpacing": 0.06,
      "align": "right",
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.038, "y": -0.036 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "auto" },
      "letterSpacing": 0.04,
      "opacity": 0.9,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": { "x": 0.038, "y": -0.032 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
