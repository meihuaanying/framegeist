      "anchor": "top-left",
      "offset": {
        "x": 0.045,
        "y": 0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.18,
      "content": [
        {
          "expr": "'PORTFOLIO · FRAMEGEIST'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "plateno",
      "anchor": "top-right",
      "offset": {
        "x": -0.045,
        "y": 0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.18,
      "align": "right",
      "content": [
        {
          "expr": "'PLATE NO. 01'",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.205
      },
      "shape": "line",
      "size": {
        "width": 0.9,
        "height": 0.0016
      },
      "color": "#E4E6EA",
      "autoHide": true
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.165
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.052,
        "color": "#1A1A1A",
        "weight": 600
      },
      "letterSpacing": 0.02,
      "content": [
        {
          "expr": "'《静物·晚餐》'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "author",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.165
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.018,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.06,
      "align": "right",
      "content": [
        {
          "expr": "'摄影 / FrameGeist'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.088
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.016,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.088
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.045,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.04
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
