{
  "meta": {
    "id": "minimal-letterbox",
    "name": "Letterbox",
    "nameI18n": {
      "zh": "上下细带",
      "en": "Letterbox"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.055,
      "right": 0.05,
      "bottom": 0.105,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.018
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0156,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'FRAMEGEIST')",
          "fallback": "FRAMEGEIST"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0156,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
