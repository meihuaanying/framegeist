{
  "meta": {
    "id": "magazine-triptych-slices-01",
    "name": "Triptych Slices",
    "nameI18n": {
      "zh": "三联切片",
      "en": "Triptych Slices"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "slice-1",
      "anchor": "top-left",
      "offset": {
        "x": 0.333,
        "y": 0.16
      },
      "shape": "rect",
      "size": {
        "width": 0.0015,
        "height": 0.68
      },
      "color": "#FFFFFF",
      "opacity": 0.55
    },
    {
      "type": "shape",
      "id": "slice-2",
      "anchor": "top-left",
      "offset": {
        "x": 0.6658,
        "y": 0.16
      },
      "shape": "rect",
      "size": {
        "width": 0.0015,
        "height": 0.68
      },
      "color": "#FFFFFF",
      "opacity": 0.55
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
