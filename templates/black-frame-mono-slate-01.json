{
  "meta": {
    "id": "black-frame-mono-slate-01",
    "name": "Mono Slate",
    "nameI18n": {
      "zh": "黑框参数",
      "en": "Mono Slate"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.045,
      "right": 0.045,
      "bottom": 0.15,
      "left": 0.045
    },
    "background": {
      "type": "solid",
      "color": "#111214"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.041,
        "y": 0.012
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0095,
        "color": "#6E6E6E",
        "weight": 500
      },
      "letterSpacing": 0.22,
      "content": [
        {
          "expr": "'FRAMEGEIST'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.041,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.014,
        "color": "#E8E8E8",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.041,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#9A9A9A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.041,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0115,
        "color": "#9A9A9A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.041,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#7A7A7A",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.04
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
