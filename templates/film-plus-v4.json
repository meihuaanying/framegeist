{
  "meta": {
    "id": "film-plus-v4",
    "name": "Film Plus 4",
    "nameI18n": {
      "zh": "胶片加强 4",
      "en": "Film Plus 4"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.10400000000000001,
      "right": 0.07400000000000001,
      "bottom": 0.164,
      "left": 0.07400000000000001
    },
    "background": {
      "type": "solid",
      "color": "#0B0B0D"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "strip-top",
      "asset": "@builtin/frame/film-strip",
      "size": {
        "height": 0.02
      },
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.01
      },
      "tint": "light"
    },
    {
      "type": "image",
      "id": "strip-bottom",
      "asset": "@builtin/frame/film-strip",
      "size": {
        "height": 0.02
      },
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.008
      },
      "tint": "light"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.026,
        "weight": 600,
        "color": "#DDBB66"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.025,
        "y": -0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.022
      },
      "anchor": "bottom-left",
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.017,
        "weight": 400,
        "color": "#DDBB66"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.025,
        "y": -0.055
      }
    },
    {
      "type": "text",
      "id": "stock",
      "anchor": "top-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.014,
        "weight": 400,
        "color": "#DDBB66"
      },
      "content": [
        {
          "expr": "'FILM 400-4'",
          "fallback": "FILM"
        }
      ],
      "offset": {
        "x": 0.025,
        "y": 0.035
      }
    }
  ]
}
