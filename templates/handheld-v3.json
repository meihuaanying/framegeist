{
  "meta": {
    "id": "handheld-v3",
    "name": "Handheld 3",
    "nameI18n": {
      "zh": "手持相框 3",
      "en": "Handheld 3"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "frame-shell"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.05,
      "right": 0.34,
      "bottom": 0.1,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#0F0F12"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "device",
      "asset": "@builtin/frame/phone-frame",
      "size": {
        "height": 0.62
      },
      "anchor": "middle-right",
      "offset": {
        "x": -0.02,
        "y": 0
      },
      "opacity": 0.9,
      "tint": "light"
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.028,
        "weight": 600,
        "color": "#EDEDED"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.06
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.022
      },
      "anchor": "bottom-left",
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.018,
        "weight": 400,
        "color": "#EDEDED"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.095
      }
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.015,
        "weight": 400,
        "color": "#EDEDED"
      },
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": "2026.09.12"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": 0.04
      }
    }
  ]
}
