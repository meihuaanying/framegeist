{
  "meta": {
    "id": "magazine-poster-manifesto-01",
    "name": "Quiet Manifesto",
    "nameI18n": {
      "zh": "静默宣言",
      "en": "Quiet Manifesto"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.15,
      "bottom": 0.34,
      "left": 0.15
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "kicker",
      "anchor": "top-left",
      "offset": {
        "x": 0.115,
        "y": 0.028
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.24,
      "content": [
        {
          "expr": "'POSTER Nº 09'",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.115,
        "y": 0.028
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.115,
        "y": -0.2144
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0016
      },
      "color": "#1A1A1A",
      "opacity": 0.8
    },
    {
      "type": "text",
      "id": "slogan-en",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.115,
        "y": -0.128
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0374,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.04,
      "content": [
        {
          "expr": "'LET LIGHT SPEAK.'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "slogan-cn",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.115,
        "y": -0.075
      },
      "font": {
        "family": [
          "Noto Serif SC"
        ],
        "size": 0.024,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "content": [
        {
          "expr": "'光影自有主张'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.115,
        "y": -0.17
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.018,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.115,
        "y": -0.125
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.115,
        "y": -0.075
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
