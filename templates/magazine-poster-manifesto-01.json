{
  "meta": {
    "id": "magazine-poster-manifesto-01",
    "name": "Quiet Manifesto",
    "nameI18n": {
      "zh": "静默宣言",
      "en": "Quiet Manifesto"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.15,
      "bottom": 0.34,
      "left": 0.15
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.115,
        "y": -0.2144
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0016
      },
      "color": "#1A1A1A",
      "opacity": 0.8
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.115,
        "y": -0.075
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'LET LIGHT SPEAK.'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'光影自有主张'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
