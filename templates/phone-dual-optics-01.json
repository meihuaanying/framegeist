{
  "meta": {
    "id": "phone-dual-optics-01",
    "name": "Dual Optics",
    "nameI18n": {
      "zh": "双镜对照",
      "en": "Dual Optics"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.2,
      "right": 0.08,
      "bottom": 0.07,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.069,
        "y": 0.0433
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "top-right",
      "offset": {
        "x": -0.069,
        "y": 0.0409
      },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.0703
      },
      "shape": "line",
      "size": {
        "width": 0.14,
        "height": 0.0015
      },
      "rotation": 90,
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'MOBILE DEVICE')",
        "fallback": "MOBILE DEVICE",
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": "SECONDARY LENS",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
