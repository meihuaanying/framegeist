{
  "meta": {
    "id": "phone-side-rail-01",
    "name": "Side Rail",
    "nameI18n": {
      "zh": "侧栏竖标",
      "en": "Side Rail"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.05,
      "right": 0.11,
      "bottom": 0.05,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "railrule",
      "anchor": "middle-center",
      "offset": {
        "x": 0.399,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.55,
        "height": 0.0015
      },
      "rotation": 90,
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "raildot",
      "anchor": "top-center",
      "offset": {
        "x": 0.452,
        "y": 0.034
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.013
      },
      "color": "#E10600"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0948,
        "y": -0.0173
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')",
        "fallback": "MOBILE CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": "MOBILE IMAGING",
        "role": "detail"
      }
    ]
  }
}
