{
  "meta": {
    "id": "minimal-model-stack",
    "name": "Model Stack",
    "nameI18n": {
      "zh": "机型两行",
      "en": "Model Stack"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.04,
      "right": 0.04,
      "bottom": 0.13,
      "left": 0.04
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "attachTo": "model",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0648,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.037,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0156,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.037,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0156,
        "color": "#9AA0A6",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
