{
  "meta": {
    "id": "drone-altitude-hero-01",
    "name": "Altitude Hero",
    "nameI18n": { "zh": "高度主角", "en": "Altitude Hero" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.08, "right": 0.1, "bottom": 0.32, "left": 0.1 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "text",
      "id": "caption",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.1895 },
      "font": { "family": ["Inter"], "size": 0.0095, "color": "#9AA0A6" },
      "letterSpacing": 0.22,
      "content": [
        { "expr": "'AERIAL RECORD'", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "droneicon",
      "anchor": "bottom-left",
      "asset": "@builtin/frame/icon-drone",
      "size": { "height": 0.018 },
      "tint": "auto",
      "attachTo": "caption",
      "attachGap": 0.012
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.1745 },
      "shape": "line",
      "size": { "width": 1.0, "height": 0.0015 },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "alt",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.075 },
      "font": { "family": ["Bebas Neue"], "size": 0.16, "color": "#1A1A1A" },
      "letterSpacing": 0.02,
      "content": [
        { "expr": "if_empty(exif.gps_alt, 'ALTITUDE')", "fallback": "ALTITUDE" }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.0833, "y": -0.1243 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.0496 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#6B7280" },
      "letterSpacing": 0.1,
      "content": [
        { "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.0833, "y": -0.0171 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#9AA0A6" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    }
  ],
  "fields": {
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
