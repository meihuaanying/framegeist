{
  "meta": {
    "id": "drone-altitude-hero-01",
    "name": "Altitude Hero",
    "nameI18n": {
      "zh": "高度主角",
      "en": "Altitude Hero"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.1,
      "bottom": 0.32,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "caption",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.1895
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0095,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.22,
      "content": [
        {
          "expr": "'AERIAL RECORD'",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "droneicon",
      "anchor": "bottom-left",
      "asset": "@builtin/frame/icon-drone",
      "size": {
        "height": 0.018
      },
      "tint": "auto",
      "attachTo": "caption",
      "attachGap": 0.012
    },
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.1745
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA"
    },
    {
      "type": "text",
      "id": "alt",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.075
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.16,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.02,
      "effects": {
        "relief": {
          "mode": "emboss",
          "depth": 0.05,
          "highlight": "#FFFFFF",
          "shadow": "#B9B2A4",
          "opacity": 0.8
        }
      },
      "content": [
        {
          "expr": "if_empty(exif.gps_alt, 'ALTITUDE')",
          "fallback": "ALTITUDE"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0833,
        "y": -0.1243
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.022
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.0496
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.011,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0,
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0833,
        "y": -0.0171
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
