{
  "meta": {
    "id": "phone-accent-dots-01",
    "name": "Accent Dots",
    "nameI18n": {
      "zh": "点睛彩条",
      "en": "Accent Dots"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.07,
      "bottom": 0.19,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#F8F1E7"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.1112
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.0125
      },
      "color": "#E10600"
    },
    {
      "type": "shape",
      "id": "dot2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0814,
        "y": -0.1112
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.0125
      },
      "color": "#F97316"
    },
    {
      "type": "shape",
      "id": "dot3",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1014,
        "y": -0.1112
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.0125
      },
      "color": "#FBBF24"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0614,
        "y": -0.0256
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "accentbar",
      "anchor": "top-left",
      "offset": {
        "x": 0.0614,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.01
      },
      "color": "#F97316"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')",
        "fallback": "MOBILE CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
