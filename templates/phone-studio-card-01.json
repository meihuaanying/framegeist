{
  "meta": {
    "id": "phone-studio-card-01",
    "name": "Studio Card",
    "nameI18n": {
      "zh": "影棚白卡",
      "en": "Studio Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.1,
      "bottom": 0.24,
      "left": 0.1
    },
    "background": {
      "type": "solid",
      "color": "#F5F5F7"
    },
    "radius": 0.02,
    "shadow": {
      "enabled": true,
      "blur": 0.08,
      "opacity": 0.22,
      "offsetX": 0,
      "offsetY": 0.015
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandtop",
      "anchor": "top-left",
      "offset": {
        "x": 0.0833,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "brandfoot",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0833,
        "y": -0.0466
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Device')",
        "fallback": "Unknown Device",
        "role": "support"
      },
      {
        "expr": "exif.lens",
        "fallback": "MAIN CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
