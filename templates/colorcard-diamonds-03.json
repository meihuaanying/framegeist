{
  "meta": {
    "id": "colorcard-diamonds-03",
    "name": "Diamond Row",
    "nameI18n": {
      "zh": "菱形色列",
      "en": "Diamond Row"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.05,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.22,
      "offsetX": 0,
      "offsetY": 0.025
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.036
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.09
      },
      "count": 5,
      "shape": "diamond",
      "direction": "horizontal",
      "size": 0.045,
      "gap": 0.02,
      "showHex": true,
      "label": {
        "size": 0.011,
        "color": "#6B7280",
        "family": [
          "JetBrains Mono"
        ]
      }
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
