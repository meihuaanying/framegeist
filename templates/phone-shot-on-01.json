{
  "meta": {
    "id": "phone-shot-on-01",
    "name": "Shot On Center",
    "nameI18n": {
      "zh": "居中出品",
      "en": "Shot On Center"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "overlay"
  },
  "layers": [
    {
      "type": "text",
      "id": "shoton",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.1445
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0132,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.3,
      "opacity": 0.85,
      "align": "center",
      "content": [
        {
          "expr": "'SHOT ON'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.089
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0242,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.06,
      "opacity": 0.95,
      "align": "center",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')",
          "fallback": "MOBILE CAMERA"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.049
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "opacity": 0.85,
      "align": "center",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
