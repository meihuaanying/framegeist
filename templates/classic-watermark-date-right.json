{
  "meta": {
    "id": "classic-watermark-date-right",
    "name": "Date Right",
    "nameI18n": {
      "zh": "日期右置",
      "en": "Date Right"
    },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "classic-watermark"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0,
      "right": 0,
      "bottom": 0.11,
      "left": 0
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.042
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#1A1A1A"
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Unknown Camera"
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.056
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.014,
        "color": "#373A40"
      },
      "letterSpacing": 0.1,
      "align": "right",
      "content": [
        {
          "expr": "date('YYYY.MM.DD', exif.datetime)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.027
      },
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.013,
        "color": "#6B7280"
      },
      "letterSpacing": 0.05,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
