{
  "meta": {
    "id": "borderless-v4",
    "name": "Borderless 4",
    "nameI18n": {
      "zh": "无边框 4",
      "en": "Borderless 4"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "overlay",
    "background": {
      "type": "none"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "top-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.03,
        "weight": 600,
        "color": "auto"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": -0.025,
        "y": 0.04
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.026
      },
      "anchor": "top-right",
      "offset": {
        "x": -0.025,
        "y": 0.09
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "top-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.017,
        "weight": 400,
        "color": "auto"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.025,
        "y": 0.125
      }
    }
  ]
}
