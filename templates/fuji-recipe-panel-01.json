{
  "meta": {
    "id": "fuji-recipe-panel-01",
    "name": "Recipe Panel",
    "nameI18n": {
      "zh": "配方暗板",
      "en": "Recipe Panel"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "fuji"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.07,
      "bottom": 0.38,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#101011"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "panel-left",
      "anchor": "bottom-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.38
      },
      "color": "#1B1C1F"
    },
    {
      "type": "shape",
      "id": "panel-right",
      "anchor": "bottom-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.14,
        "height": 0.38
      },
      "color": "#1B1C1F"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.0526,
        "y": 0.026
      },
      "asset": "@builtin/brand/fujifilm",
      "size": {
        "height": 0.06
      }
    },
    {
      "type": "shape",
      "id": "panel-rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.0526,
        "y": 0.905
      },
      "shape": "line",
      "size": {
        "width": 0.8947,
        "height": 0.0012
      },
      "color": "#2A2B2E"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#F2EFE9",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'CLASSIC CHROME'",
        "fallback": "RECIPE",
        "role": "support"
      },
      {
        "expr": "'AUTO'",
        "fallback": "AUTO",
        "role": "support"
      },
      {
        "expr": "'DR200'",
        "fallback": "DR",
        "role": "support"
      }
    ]
  }
}
