{
  "meta": {
    "id": "black-frame-side-stack-01",
    "name": "Side Stack",
    "nameI18n": { "zh": "右侧参数", "en": "Side Stack" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.06, "right": 0.22, "bottom": 0.10, "left": 0.08 },
    "background": { "type": "solid", "color": "#1A1A1A" }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rail",
      "anchor": "middle-right",
      "offset": { "x": -0.23, "y": 0 },
      "shape": "line",
      "size": { "width": 0.0012, "height": 0.6 },
      "color": "#33353A"
    },
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": { "x": 0.05, "y": 0.03 },
      "font": { "family": ["Inter"], "size": 0.009, "color": "#6E6E6E" },
      "letterSpacing": 0.22,
      "content": [{ "expr": "'FRAMEGEIST'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-left",
      "offset": { "x": 0.05, "y": 0.065 },
      "font": { "family": ["Inter"], "size": 0.0105, "color": "#8A8A8A" },
      "letterSpacing": 0.03,
      "content": [{ "expr": "exif.lens", "fallback": null }]
    },
    {
      "type": "text",
      "id": "paramstack",
      "anchor": "middle-right",
      "offset": { "x": -0.06, "y": 0 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "#C9C9C9" },
      "letterSpacing": 0.06,
      "lineHeight": 1.7,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}MM', exif)", "fallback": null },
        { "expr": "fmt('F{aperture}', exif)", "fallback": null },
        { "expr": "exif.shutter", "fallback": null },
        { "expr": "fmt('ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.06, "y": -0.04 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#8A8A8A" },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.045 },
      "font": { "family": ["Inter"], "size": 0.014, "color": "#EDEDED" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
