{
  "meta": {
    "id": "black-frame-side-stack-01",
    "name": "Side Stack",
    "nameI18n": {
      "zh": "右侧参数",
      "en": "Side Stack"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "black-frame"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.22,
      "bottom": 0.1,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#1A1A1A"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rail",
      "anchor": "middle-right",
      "offset": {
        "x": -0.23,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.6
      },
      "color": "#33353A"
    },
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0114,
        "color": "#6E6E6E",
        "weight": 500
      },
      "letterSpacing": 0.22,
      "content": [
        {
          "expr": "'FRAMEGEIST'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.065
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0126,
        "color": "#8A8A8A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "paramstack",
      "anchor": "middle-right",
      "offset": {
        "x": -0.06,
        "y": 0
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.015,
        "color": "#C9C9C9",
        "weight": 400
      },
      "letterSpacing": 0.06,
      "lineHeight": 1.7,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}MM', exif)",
          "fallback": null
        },
        {
          "expr": "fmt('F{aperture}', exif)",
          "fallback": null
        },
        {
          "expr": "exif.shutter",
          "fallback": null
        },
        {
          "expr": "fmt('ISO{iso}', exif)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.06,
        "y": -0.04
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.012,
        "color": "#8A8A8A",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0168,
        "color": "#EDEDED",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
