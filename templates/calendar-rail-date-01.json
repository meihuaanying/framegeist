{
  "meta": {
    "id": "calendar-rail-date-01",
    "name": "Side Rail Date",
    "nameI18n": {
      "zh": "右栏日历",
      "en": "Side Rail Date"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.26,
      "bottom": 0.1,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F6F4EF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.045,
        "y": 0.035
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'CALENDAR · FRAMEGEIST'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "bigday",
      "anchor": "middle-right",
      "offset": {
        "x": -0.05,
        "y": 0.06
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.2,
        "color": "#1A1A1A",
        "weight": 400
      },
      "letterSpacing": 0.01,
      "align": "right",
      "content": [
        {
          "expr": "date('DD', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "middle-right",
      "offset": {
        "x": -0.05,
        "y": -0.03
      },
      "shape": "line",
      "size": {
        "width": 0.1,
        "height": 0.0012
      },
      "color": "#D9D4C8"
    },
    {
      "type": "calendar",
      "id": "monthgrid",
      "anchor": "middle-right",
      "offset": {
        "x": -0.03,
        "y": -0.17
      },
      "size": 0.14,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "showLunar": true,
      "showWeekdays": true,
      "view": "month",
      "color": "#6B7280",
      "accent": "#C8552B",
      "fontFamily": [
        "Inter"
      ]
    },
    {
      "type": "text",
      "id": "cndate",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.04
      },
      "font": {
        "family": [
          "LXGW WenKai"
        ],
        "size": 0.014,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [
        {
          "expr": "date('YYYY年MM月DD日', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.045
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.013,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.08
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0105,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
