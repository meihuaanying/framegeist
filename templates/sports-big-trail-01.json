{
  "meta": {
    "id": "sports-big-trail-01",
    "name": "Big Trail",
    "nameI18n": {
      "zh": "大标题山径",
      "en": "Big Trail"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.07,
      "right": 0.09,
      "bottom": 0.28,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0763,
        "y": -0.1022
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter",
        "Unbounded"
      ]
    },
    "lines": [
      {
        "expr": "'TRAIL'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
