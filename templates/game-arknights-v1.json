{
  "meta": {
    "id": "game-arknights-v1",
    "name": "Arknights · Hero Frame",
    "nameI18n": {
      "zh": "明日方舟 · 主题边框",
      "en": "Arknights · Hero Frame"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "game",
    "notice": "Unofficial fan-made design; game names and trademarks belong to their respective owners."
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.05,
      "bottom": 0.16,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#121212"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "game-mark",
      "asset": "@builtin/game/arknights",
      "size": {
        "height": 0.06
      },
      "anchor": "top-left",
      "offset": {
        "x": 0.03,
        "y": 0.035
      }
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "Bricolage Grotesque"
        ],
        "size": 0.027,
        "weight": 500,
        "color": "#E8E8E8"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.05
      },
      "features": [
        "tnum"
      ],
      "letterSpacing": 0
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}-light",
      "size": {
        "height": 0.06
      },
      "anchor": "bottom-left",
      "attachTo": "title",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0204,
        "weight": 500,
        "color": "#E8E8E8"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": -0.03,
        "y": -0.055
      },
      "letterSpacing": 0.08
    },
    {
      "type": "text",
      "id": "accent",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.014,
        "weight": 400,
        "color": "#E4572E"
      },
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": "2026.09.12"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.095
      },
      "features": [
        "tnum"
      ],
      "letterSpacing": 0
    }
  ]
}
