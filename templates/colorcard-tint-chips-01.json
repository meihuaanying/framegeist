{
  "meta": {
    "id": "colorcard-tint-chips-01",
    "name": "Chromatic Edge",
    "nameI18n": {
      "zh": "主色卡片",
      "en": "Chromatic Edge"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.13,
      "right": 0.1,
      "bottom": 0.26,
      "left": 0.1
    },
    "background": {
      "type": "tint"
    },
    "radius": 0.035,
    "shadow": {
      "enabled": true,
      "blur": 0.09,
      "opacity": 0.3,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-left",
      "offset": {
        "x": 0,
        "y": -0.075
      },
      "count": 5,
      "shape": "circle",
      "direction": "horizontal",
      "size": 0.034,
      "gap": 0.014,
      "showHex": true,
      "label": {
        "size": 0.011,
        "color": "#FFFFFF",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-left",
      "corner": "bottom-left",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#FFFFFF",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.weekday, 'A DAY TO REMEMBER')",
        "fallback": "A DAY TO REMEMBER",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
