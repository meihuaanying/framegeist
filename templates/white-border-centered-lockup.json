{
  "meta": {
    "id": "white-border-centered-lockup",
    "name": "Centered Lockup",
    "nameI18n": {
      "zh": "中轴锁排",
      "en": "Centered Lockup"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "accentrule",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.17
      },
      "shape": "line",
      "size": {
        "width": 0.05,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.132
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
