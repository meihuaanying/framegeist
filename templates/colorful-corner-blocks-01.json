{
  "meta": {
    "id": "colorful-corner-blocks-01",
    "name": "Corner Blocks",
    "nameI18n": {
      "zh": "四角色块",
      "en": "Corner Blocks"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "block-tl",
      "anchor": "top-left",
      "offset": {
        "x": 0.03,
        "y": 0.03
      },
      "shape": "rect",
      "size": {
        "width": 0.024,
        "height": 0.024
      },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "block-tr",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.03
      },
      "shape": "rect",
      "size": {
        "width": 0.024,
        "height": 0.024
      },
      "color": "#F4B942"
    },
    {
      "type": "shape",
      "id": "block-bl",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.03
      },
      "shape": "rect",
      "size": {
        "width": 0.024,
        "height": 0.024
      },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "block-br",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.03
      },
      "shape": "rect",
      "size": {
        "width": 0.024,
        "height": 0.024
      },
      "color": "#457B9D"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.075
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
