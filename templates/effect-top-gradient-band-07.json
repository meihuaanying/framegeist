{
  "meta": {
    "id": "effect-top-gradient-band-07",
    "name": "Top Gradient Band",
    "nameI18n": {
      "zh": "顶部渐隐带",
      "en": "Top Gradient Band"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.09,
      "bottom": 0.16,
      "left": 0.09
    },
    "background": {
      "type": "tint"
    },
    "radius": 0.03,
    "shadow": {
      "enabled": true,
      "blur": 0.1,
      "opacity": 0.25,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "band-solid",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.3561
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.06
      },
      "color": "#14181C",
      "opacity": 0.4
    },
    {
      "type": "shape",
      "id": "band-fade",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.2803
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.14
      },
      "color": "#14181C",
      "opacity": 0.15
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.05,
        "y": 0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
