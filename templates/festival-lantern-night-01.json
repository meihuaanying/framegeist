      "size": { "height": 0.038 },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "lantern-2",
      "anchor": "top-left",
      "offset": { "x": 0.083, "y": 0.035 },
      "asset": "@builtin/frame/icon-lantern",
      "size": { "height": 0.038 },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "lantern-3",
      "anchor": "top-left",
      "offset": { "x": 0.131, "y": 0.035 },
      "asset": "@builtin/frame/icon-lantern",
      "size": { "height": 0.038 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-right",
      "offset": { "x": -0.04, "y": 0.038 },
