      "opacity": 0.85,
      "align": "right",
      "content": [{ "expr": "'LANTERN NIGHT · FRAMEGEIST'", "fallback": null }]
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-left",
      "offset": { "x": 0.04, "y": -0.045 },
