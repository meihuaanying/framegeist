      "size": { "height": 0.06 }
    },
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-right",
      "offset": { "x": -0.04, "y": -0.10 },
      "font": { "family": ["Ma Shan Zheng"], "size": 0.05, "color": "auto" },
      "letterSpacing": 0.04,
      "opacity": 0.95,
      "align": "right",
      "content": [{ "expr": "'灯会'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": { "x": -0.04, "y": -0.04 },
      "font": { "family": ["Bebas Neue"], "size": 0.038, "color": "auto" },
      "letterSpacing": 0.06,
      "opacity": 0.9,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    }
