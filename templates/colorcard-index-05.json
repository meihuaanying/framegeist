{
  "meta": {
    "id": "colorcard-index-05",
    "name": "Index Row",
    "nameI18n": {
      "zh": "索引色带",
      "en": "Index Row"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.08,
      "bottom": 0.28,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#EDF1F5"
    },
    "radius": 0.035,
    "shadow": {
      "enabled": true,
      "blur": 0.09,
      "opacity": 0.22,
      "offsetX": 0,
      "offsetY": 0.02
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": 0.33
      },
      "shape": "rect",
      "size": {
        "width": 0.5,
        "height": 0.0018
      },
      "color": "#AEB7C2",
      "opacity": 0.95
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.075
      },
      "count": 7,
      "shape": "circle",
      "direction": "horizontal",
      "size": 0.032,
      "gap": 0.013,
      "showHex": true,
      "label": {
        "size": 0.01,
        "color": "#6B7280",
        "family": [
          "JetBrains Mono"
        ]
      }
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#6B7280",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "'PALETTE 05'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
