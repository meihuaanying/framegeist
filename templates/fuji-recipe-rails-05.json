{
  "meta": {
    "id": "fuji-recipe-rails-05",
    "name": "Recipe Rails",
    "nameI18n": {
      "zh": "右侧配方栏",
      "en": "Recipe Rails"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "fuji"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.32,
      "bottom": 0.08,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#E9E3D8"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "column-top",
      "anchor": "top-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.32,
        "height": 1
      },
      "color": "#17181A"
    },
    {
      "type": "shape",
      "id": "column-bottom",
      "anchor": "bottom-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 0.32,
        "height": 0.16
      },
      "color": "#17181A"
    },
    {
      "type": "shape",
      "id": "accent",
      "anchor": "top-right",
      "offset": {
        "x": -0.035,
        "y": 0.098
      },
      "shape": "rect",
      "size": {
        "width": 0.012,
        "height": 0.006
      },
      "color": "#0B8A3E"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.035,
        "y": 0.026
      },
      "asset": "@builtin/brand/fujifilm",
      "size": {
        "height": 0.06
      }
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "#F1EDE6",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'PROVIA'",
        "fallback": "RECIPE",
        "role": "detail"
      },
      {
        "expr": "'5200K'",
        "fallback": "WB",
        "role": "detail"
      },
      {
        "expr": "'DR200'",
        "fallback": "DR",
        "role": "detail"
      }
    ]
  }
}
