{
  "meta": {
    "id": "festival-dragon-boat-01",
    "name": "Dragon Boat Seal",
    "nameI18n": {
      "zh": "端午印记",
      "en": "Dragon Boat Seal"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "festival"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.12,
      "bottom": 0.2,
      "left": 0.22
    },
    "background": {
      "type": "solid",
      "color": "#FAF6EC"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "boat",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.04,
        "y": -0.045
      },
      "asset": "@builtin/frame/icon-boat",
      "size": {
        "height": 0.055
      },
      "tint": "dark"
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.185,
        "y": -0.045
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.07
      }
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "left",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'端午安康'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
