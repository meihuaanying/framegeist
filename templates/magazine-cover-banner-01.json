{
  "meta": {
    "id": "magazine-cover-banner-01",
    "name": "Midnight Cover",
    "nameI18n": { "zh": "午夜封面", "en": "Midnight Cover" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.16, "right": 0.05, "bottom": 0.13, "left": 0.05 },
    "background": { "type": "solid", "color": "#101114" }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "top-left",
      "offset": { "x": 0.045, "y": 0.028 },
      "font": { "family": ["Playfair Display"], "size": 0.055, "color": "#FFFFFF" },
      "letterSpacing": 0.06,
      "content": [{ "expr": "'LIGHT JOURNAL'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "sub",
      "anchor": "top-left",
      "offset": { "x": 0.045, "y": 0.088 },
      "font": { "family": ["Inter"], "size": 0.0105, "color": "#B9BDC4" },
      "letterSpacing": 0.26,
      "content": [{ "expr": "'PHOTOGRAPHY QUARTERLY'", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.045, "y": 0.088 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#B9BDC4" },
      "letterSpacing": 0.18,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": { "x": 0.045, "y": 0.112 },
      "shape": "line",
      "size": { "width": 0.34, "height": 0.0015 },
      "color": "#FFFFFF59"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.045, "y": -0.06 },
      "font": { "family": ["Inter"], "size": 0.016, "color": "#F5F5F7" },
      "letterSpacing": 0.05,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'Unknown Camera')", "fallback": "Unknown Camera" }
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-left",
      "offset": { "x": 0.045, "y": -0.026 },
      "font": { "family": ["Inter"], "size": 0.0115, "color": "#8A8F98" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "exif.lens", "fallback": null }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.045, "y": -0.058 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0105, "color": "#8A8F98" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.045, "y": -0.018 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.022 },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
}
