{
  "meta": {
    "id": "colorcard-cream-date-04",
    "name": "Cream Date",
    "nameI18n": { "zh": "奶油大日期", "en": "Cream Date" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorcard"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.12, "right": 0.08, "bottom": 0.34, "left": 0.08 },
    "background": { "type": "solid", "color": "#F6F1E7" },
    "radius": 0.04,
    "shadow": { "enabled": true, "blur": 0.10, "opacity": 0.24, "offsetX": 0, "offsetY": 0.03 }
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": { "x": 0.05, "y": 0.04 },
      "font": { "family": ["Inter"], "size": 0.016, "color": "#1A1A1A" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.05, "y": 0.042 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "#9A9288" },
      "letterSpacing": 0.14,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "bigdate",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.135 },
      "font": { "family": ["Bebas Neue"], "size": 0.09, "color": "#1A1A1A" },
      "letterSpacing": 0.02,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.05,
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    },
    {
      "type": "palette",
      "id": "chips",
      "anchor": "bottom-right",
      "offset": { "x": -0.10, "y": -0.03 },
      "count": 4,
      "shape": "square",
      "direction": "vertical",
      "size": 0.030,
      "gap": 0.012,
      "showHex": true,
      "label": { "size": 0.009, "color": "#8A8177", "family": ["JetBrains Mono"] }
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
