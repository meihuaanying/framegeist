{
  "meta": {
    "id": "colorful-dot-cluster-01",
    "name": "Dot Cluster",
    "nameI18n": {
      "zh": "圆点群落",
      "en": "Dot Cluster"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "bottom": 0.26
    },
    "background": {
      "type": "solid",
      "color": "#101418"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot-1",
      "anchor": "top-left",
      "offset": {
        "x": 0.8,
        "y": 0.62
      },
      "shape": "ellipse",
      "size": {
        "width": 0.012,
        "height": 0.016
      },
      "color": "#E63946"
    },
    {
      "type": "shape",
      "id": "dot-2",
      "anchor": "top-left",
      "offset": {
        "x": 0.845,
        "y": 0.655
      },
      "shape": "ellipse",
      "size": {
        "width": 0.018,
        "height": 0.024
      },
      "color": "#F4A261"
    },
    {
      "type": "shape",
      "id": "dot-3",
      "anchor": "top-left",
      "offset": {
        "x": 0.885,
        "y": 0.7
      },
      "shape": "ellipse",
      "size": {
        "width": 0.014,
        "height": 0.0187
      },
      "color": "#E9C46A"
    },
    {
      "type": "shape",
      "id": "dot-4",
      "anchor": "top-left",
      "offset": {
        "x": 0.925,
        "y": 0.745
      },
      "shape": "ellipse",
      "size": {
        "width": 0.021,
        "height": 0.028
      },
      "color": "#2A9D8F"
    },
    {
      "type": "shape",
      "id": "dot-5",
      "anchor": "top-left",
      "offset": {
        "x": 0.955,
        "y": 0.8
      },
      "shape": "ellipse",
      "size": {
        "width": 0.011,
        "height": 0.0147
      },
      "color": "#457B9D"
    },
    {
      "type": "shape",
      "id": "dot-6",
      "anchor": "top-left",
      "offset": {
        "x": 0.9,
        "y": 0.85
      },
      "shape": "ellipse",
      "size": {
        "width": 0.016,
        "height": 0.0213
      },
      "color": "#1A1A1A"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.035,
        "y": 0.028
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
