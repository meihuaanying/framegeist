{
  "meta": {
    "id": "drone-aerial-editorial-01",
    "name": "Aerial Editorial",
    "nameI18n": {
      "zh": "航拍编辑",
      "en": "Aerial Editorial"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "drone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.24,
      "right": 0.13,
      "bottom": 0.16,
      "left": 0.13
    },
    "background": {
      "type": "solid",
      "color": "#EDF1F5"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "bigword",
      "anchor": "top-left",
      "offset": {
        "x": 0.1032,
        "y": 0.0536
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0495,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.42,
      "content": [
        {
          "expr": "'AERIAL'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "weekday",
      "anchor": "top-right",
      "offset": {
        "x": -0.1032,
        "y": 0.0586
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "exif.weekday",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "rule1",
      "anchor": "top-left",
      "offset": {
        "x": 0.1032,
        "y": 0.1
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0012
      },
      "color": "#1A1A1A"
    },
    {
      "type": "shape",
      "id": "rule2",
      "anchor": "top-left",
      "offset": {
        "x": 0.1082,
        "y": 0.105
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0008
      },
      "color": "#1A1A1A",
      "opacity": 0.35
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-left",
      "offset": {
        "x": 0.1032,
        "y": 0.12
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.018,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'AERIAL UNIT')",
          "fallback": "AERIAL UNIT"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "anchor": "top-left",
      "offset": {
        "x": 0.1032,
        "y": 0.1414
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0114,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'AERIAL PHOTOGRAPHY · FLIGHT RECORD'",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1032,
        "y": -0.0729
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1032,
        "y": -0.0736
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "geotag",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.1032,
        "y": -0.0407
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.05,
      "content": [
        {
          "expr": "exif.gps_latlon",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.1032,
        "y": -0.0364
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "weekday": {
      "type": "string",
      "source": "exif"
    }
  }
}
