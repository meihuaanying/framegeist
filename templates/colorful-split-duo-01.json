{
  "meta": {
    "id": "colorful-split-duo-01",
    "name": "Duo Split",
    "nameI18n": {
      "zh": "双色分割",
      "en": "Duo Split"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorful"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.18,
      "right": 0,
      "bottom": 0.16,
      "left": 0
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "block",
      "anchor": "top-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.18
      },
      "color": "#E63946"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.045,
        "y": 0.056
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "light"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "'COLOR DIARY'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
