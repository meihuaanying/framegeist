{
  "meta": {
    "id": "film-sprocket-01",
    "name": "Sprocket Classic",
    "nameI18n": {
      "zh": "齿孔边码",
      "en": "Sprocket Classic"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.13,
      "right": 0.065,
      "bottom": 0.26,
      "left": 0.065
    },
    "background": {
      "type": "solid",
      "color": "#0E0E0E"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "strip-top",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.0144
      },
      "asset": "@builtin/frame/film-strip",
      "size": {
        "width": 1
      }
    },
    {
      "type": "image",
      "id": "strip-bottom",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/frame/film-strip",
      "size": {
        "width": 1
      }
    },
    {
      "type": "image",
      "id": "edgecode",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.1151
      },
      "asset": "@builtin/frame/film-edge",
      "size": {
        "width": 1
      },
      "opacity": 0.9
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.058,
        "y": -0.1266
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#EFE9DC",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'FG 400'",
        "fallback": "FILM",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
