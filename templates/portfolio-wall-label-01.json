{
  "meta": {
    "id": "portfolio-wall-label-01",
    "name": "Wall Label",
    "nameI18n": {
      "zh": "展览标签",
      "en": "Wall Label"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.08,
      "bottom": 0.1,
      "left": 0.34
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.05,
        "y": -0.155
      },
      "shape": "line",
      "size": {
        "width": 0.28,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'《夜色温柔》'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'2026'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "'FrameGeist'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
