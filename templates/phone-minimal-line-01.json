{
  "meta": {
    "id": "phone-minimal-line-01",
    "name": "Minimal Line",
    "nameI18n": {
      "zh": "极简单行",
      "en": "Minimal Line"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.05,
      "right": 0.05,
      "bottom": 0.075,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "attachGap": 0.014
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#6B7280",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": "MOBILE IMAGING",
        "role": "detail"
      }
    ]
  }
}
