{
  "meta": {
    "id": "blur-bg-card-03",
    "name": "Soft Card",
    "nameI18n": {
      "zh": "柔焦卡片",
      "en": "Soft Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "blur-bg"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.14,
      "right": 0.12,
      "bottom": 0.24,
      "left": 0.12
    },
    "background": {
      "type": "blur",
      "blur": 85,
      "scale": 1.3
    },
    "radius": 0.07,
    "shadow": {
      "enabled": true,
      "blur": 0.16,
      "opacity": 0.38,
      "offsetX": 0,
      "offsetY": 0.045
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.058
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
