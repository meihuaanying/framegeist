{
  "meta": {
    "id": "minimal-center-line",
    "name": "Center Line",
    "nameI18n": { "zh": "中轴参数行", "en": "Center Line" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.045, "right": 0.045, "bottom": 0.115, "left": 0.045 },
    "background": { "type": "solid", "color": "#FFFFFF" }
  },
  "layers": [
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.070 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.018 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "offset": { "x": 0, "y": -0.030 },
      "font": { "family": ["JetBrains Mono"], "size": 0.013, "color": "#6B7280" },
      "letterSpacing": 0.06,
      "align": "center",
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    }
  ],
  "fields": {
    "params": { "type": "string", "source": "exif" }
  }
}
