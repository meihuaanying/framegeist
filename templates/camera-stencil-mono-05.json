{
  "meta": {
    "id": "camera-stencil-mono-05",
    "name": "Stencil Mono",
    "nameI18n": {
      "zh": "丝印极简机身",
      "en": "Stencil Mono"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.055,
      "bottom": 0.16,
      "left": 0.055
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.05,
        "y": 0.032
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "image",
      "id": "body",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.032
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.1
      },
      "opacity": 0.9,
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
