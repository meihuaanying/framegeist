{
  "meta": {
    "id": "polaroid-classic-script-03",
    "name": "Classic Script",
    "nameI18n": {
      "zh": "经典手写白框",
      "en": "Classic Script"
    },
    "version": "1.1.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "polaroid"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.34,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": {
        "x": 0.07,
        "y": 0.022
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.01,
        "color": "#9A9A9A",
        "weight": 500
      },
      "letterSpacing": 0.24,
      "content": [
        {
          "expr": "'INSTANT PRINT'",
          "fallback": "INSTANT"
        }
      ]
    },
    {
      "type": "text",
      "id": "index",
      "anchor": "top-right",
      "offset": {
        "x": -0.07,
        "y": 0.022
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.01,
        "color": "#9A9A9A",
        "weight": 500
      },
      "letterSpacing": 0.16,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · ISO{iso}', exif)",
          "fallback": "35mm · f/2.8"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "signature",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.155
      },
      "font": {
        "family": [
          "Great Vibes"
        ],
        "size": 0.085,
        "color": "#2A2A2A",
        "weight": 600
      },
      "letterSpacing": -0.02,
      "content": [
        {
          "expr": "'with love'",
          "fallback": "with love"
        }
      ]
    },
    {
      "type": "text",
      "id": "place",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.016,
        "color": "#2A2A2A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "'SEASIDE'",
          "fallback": "SEASIDE"
        }
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.07,
        "y": -0.095
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#8A8A8A",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.062
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.011,
        "color": "#8A8A8A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
          "fallback": "CAMERA"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.062
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.018
      },
      "attachTo": "model",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.01,
        "color": "#A6A6A6",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  }
}
