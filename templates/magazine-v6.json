{
  "meta": {
    "id": "magazine-v6",
    "name": "Magazine V6",
    "version": "0.1.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.02,
      "right": 0.02,
      "bottom": 0.1,
      "left": 0.02
    },
    "background": {
      "type": "solid",
      "color": "#F5F5F5"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "headline",
      "anchor": "top-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.03,
        "weight": 600,
        "color": "#222222"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "FRAMEGEIST"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": 0.04
      }
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.024
      },
      "attachTo": "headline",
      "attachGap": 0.01
    },
    {
      "type": "text",
      "id": "issue",
      "anchor": "top-right",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.014,
        "weight": 400,
        "color": "#888888"
      },
      "content": [
        {
          "expr": "'ISSUE 2026-09'",
          "fallback": "ISSUE"
        }
      ],
      "offset": {
        "x": -0.03,
        "y": 0.045
      }
    },
    {
      "type": "text",
      "id": "credits",
      "anchor": "bottom-left",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.016,
        "weight": 400,
        "color": "#555555"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm  f/{aperture}  {shutter}  ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0.03,
        "y": -0.05
      }
    }
  ]
}
