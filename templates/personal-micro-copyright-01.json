{
  "meta": {
    "id": "personal-micro-copyright-01",
    "name": "Micro Copyright",
    "nameI18n": {
      "zh": "版权微字",
      "en": "Micro Copyright"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.08,
      "bottom": 0.2,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.01,
    "shadow": {
      "enabled": true,
      "blur": 0.045,
      "opacity": 0.14,
      "offsetX": 0,
      "offsetY": 0.01
    }
  },
  "layers": [],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#373A40",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('© YYYY COPYRIGHT', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
