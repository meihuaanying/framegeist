{
  "meta": {
    "id": "minimal-corner-mono",
    "name": "Corner Mono",
    "nameI18n": {
      "zh": "角落打字机",
      "en": "Corner Mono"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "overlay",
    "background": {
      "type": "none"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0156,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "opacity": 0.85,
      "content": [
        {
          "expr": "fmt('{focal}MM · F{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
