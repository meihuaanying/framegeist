{
  "meta": {
    "id": "phone-paper-spec-01",
    "name": "Paper Spec",
    "nameI18n": { "zh": "纸感规格", "en": "Paper Spec" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "phone"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.07, "right": 0.08, "bottom": 0.26, "left": 0.08 },
    "background": { "type": "solid", "color": "#FAF8F3" }
  },
  "layers": [
    {
      "type": "text",
      "id": "topnote",
      "anchor": "top-left",
      "offset": { "x": 0.069, "y": 0.032 },
      "font": { "family": ["Inter"], "size": 0.01, "color": "#9AA0A6" },
      "letterSpacing": 0.2,
      "content": [
        { "expr": "'MOBILE IMAGING'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "tdate",
      "anchor": "top-right",
      "offset": { "x": -0.069, "y": 0.032 },
      "font": { "family": ["JetBrains Mono"], "size": 0.01, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "align": "right",
      "content": [
        { "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }
      ]
    },
    {
      "type": "shape",
      "id": "specline",
      "anchor": "bottom-left",
      "offset": { "x": 0.069, "y": -0.171 },
      "shape": "line",
      "size": { "width": 1.0, "height": 0.0015 },
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "dot",
      "anchor": "bottom-left",
      "offset": { "x": 0.069, "y": -0.1368 },
      "shape": "ellipse",
      "size": { "width": 0.011, "height": 0.014 },
      "color": "#E10600"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.0886, "y": -0.1323 },
      "font": { "family": ["Inter"], "size": 0.018, "color": "#1A1A1A" },
      "letterSpacing": 0.02,
      "content": [
        { "expr": "if_empty(exif.model_pretty, 'MOBILE CAMERA')", "fallback": "MOBILE CAMERA" }
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.069, "y": -0.1045 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "content": [
        { "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "shape",
      "id": "rule1",
      "anchor": "bottom-left",
      "offset": { "x": 0.5991, "y": -0.0752 },
      "shape": "rect",
      "size": { "width": 0.0008, "height": 0.062 },
      "color": "#DADDE2"
    },
    {
      "type": "shape",
      "id": "rule2",
      "anchor": "bottom-left",
      "offset": { "x": 0.6939, "y": -0.0752 },
      "shape": "rect",
      "size": { "width": 0.0008, "height": 0.062 },
      "color": "#DADDE2"
    },
    {
      "type": "shape",
      "id": "rule3",
      "anchor": "bottom-left",
      "offset": { "x": 0.7888, "y": -0.0752 },
      "shape": "rect",
      "size": { "width": 0.0008, "height": 0.062 },
      "color": "#DADDE2"
    },
    {
      "type": "text",
      "id": "v1",
      "anchor": "bottom-left",
      "offset": { "x": 0.5172, "y": -0.124 },
      "font": { "family": ["JetBrains Mono"], "size": 0.014, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "fmt('{focal}mm', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "v2",
      "anchor": "bottom-left",
      "offset": { "x": 0.6121, "y": -0.124 },
      "font": { "family": ["JetBrains Mono"], "size": 0.014, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "fmt('f/{aperture}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "v3",
      "anchor": "bottom-left",
      "offset": { "x": 0.7069, "y": -0.124 },
      "font": { "family": ["JetBrains Mono"], "size": 0.014, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "exif.shutter", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "v4",
      "anchor": "bottom-left",
      "offset": { "x": 0.8017, "y": -0.124 },
      "font": { "family": ["JetBrains Mono"], "size": 0.014, "color": "#1A1A1A" },
      "letterSpacing": 0.03,
      "content": [
        { "expr": "fmt('ISO{iso}', exif)", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "l1",
      "anchor": "bottom-left",
      "offset": { "x": 0.5172, "y": -0.099 },
      "font": { "family": ["Inter"], "size": 0.0085, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "content": [
        { "expr": "'FOCAL'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "l2",
      "anchor": "bottom-left",
      "offset": { "x": 0.6121, "y": -0.099 },
      "font": { "family": ["Inter"], "size": 0.0085, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "content": [
        { "expr": "'APERTURE'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "l3",
      "anchor": "bottom-left",
      "offset": { "x": 0.7069, "y": -0.099 },
      "font": { "family": ["Inter"], "size": 0.0085, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "content": [
        { "expr": "'SHUTTER'", "fallback": null }
      ]
    },
    {
      "type": "text",
      "id": "l4",
      "anchor": "bottom-left",
      "offset": { "x": 0.8017, "y": -0.099 },
      "font": { "family": ["Inter"], "size": 0.0085, "color": "#9AA0A6" },
      "letterSpacing": 0.14,
      "content": [
        { "expr": "'ISO'", "fallback": null }
      ]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" },
    "date": { "type": "string", "source": "exif" }
  }
