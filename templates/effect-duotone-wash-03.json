{
  "meta": {
    "id": "effect-duotone-wash-03",
    "name": "Duotone Wash",
    "nameI18n": { "zh": "双色晕染", "en": "Duotone Wash" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "effect"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.10, "right": 0.08, "bottom": 0.22, "left": 0.08 },
    "background": { "type": "tint" },
    "radius": 0.03,
    "shadow": { "enabled": true, "blur": 0.10, "opacity": 0.28, "offsetX": 0, "offsetY": 0.025 }
  },
  "layers": [
    {
      "type": "shape",
      "id": "wash-a",
      "anchor": "middle-center",
      "offset": { "x": 0.08, "y": 0 },
      "shape": "ellipse",
      "size": { "width": 0.75, "height": 0.85 },
      "color": "#1F5C4C",
      "opacity": 0.20
    },
    {
      "type": "shape",
      "id": "wash-b",
      "anchor": "middle-center",
      "offset": { "x": -0.15, "y": 0.10 },
      "shape": "ellipse",
      "size": { "width": 0.50, "height": 0.50 },
      "color": "#D97757",
      "opacity": 0.14
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-left",
      "offset": { "x": 0.05, "y": 0.04 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "auto" },
      "letterSpacing": 0.14,
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": { "x": -0.05, "y": 0.036 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.016 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.052 },
      "font": { "family": ["Inter"], "size": 0.019, "color": "auto" },
      "letterSpacing": 0.04,
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": { "x": 0.05, "y": -0.028 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0115, "color": "auto" },
      "letterSpacing": 0.05,
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "bottom-right",
      "offset": { "x": -0.05, "y": -0.030 },
      "font": { "family": ["Inter"], "size": 0.0135, "color": "auto" },
      "letterSpacing": 0.03,
      "align": "right",
      "content": [{ "expr": "exif.lens", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
