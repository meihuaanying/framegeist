{
  "meta": {
    "id": "classic-watermark-red-dot",
    "name": "Vermilion Dot Bar",
    "nameI18n": {
      "zh": "朱点白条",
      "en": "Vermilion Dot Bar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "classic-watermark"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0,
      "right": 0,
      "bottom": 0.08,
      "left": 0
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "dot",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.031
      },
      "shape": "ellipse",
      "size": {
        "width": 0.01,
        "height": 0.0133
      },
      "color": "#E10600"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
