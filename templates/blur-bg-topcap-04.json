{
  "meta": {
    "id": "blur-bg-topcap-04",
    "name": "Top Cap",
    "nameI18n": {
      "zh": "顶部题头",
      "en": "Top Cap"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "blur-bg"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.26,
      "right": 0.09,
      "bottom": 0.12,
      "left": 0.09
    },
    "background": {
      "type": "blur",
      "blur": 75,
      "scale": 1.25
    },
    "shadow": {
      "enabled": false
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.05,
        "y": -0.04
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
