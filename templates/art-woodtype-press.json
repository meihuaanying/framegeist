{
  "meta": {
    "id": "art-woodtype-press",
    "name": "Woodtype Press",
    "nameI18n": {
      "zh": "木刻活字",
      "en": "Woodtype Press"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.055,
      "right": 0.055,
      "bottom": 0.2,
      "left": 0.055
    },
    "background": {
      "type": "solid",
      "color": "#F2EAD9"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "wood-rule-a",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.148
      },
      "shape": "line",
      "size": {
        "width": 0.5,
        "height": 0.0016
      },
      "color": "#241C12",
      "opacity": 0.9,
      "double": true,
      "gap": 0.005
    },
    {
      "type": "shape",
      "id": "wood-rule-b",
      "anchor": "bottom-center",
      "offset": {
        "x": 0.004,
        "y": -0.151
      },
      "shape": "line",
      "size": {
        "width": 0.49,
        "height": 0.0016
      },
      "color": "#5A4A38",
      "opacity": 0.5
    },
    {
      "type": "shape",
      "id": "wood-accent",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.012
      },
      "shape": "line",
      "size": {
        "width": 0.09,
        "height": 0.0035
      },
      "color": "#A63B2A",
      "opacity": 1
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-right",
      "corner": "bottom-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#241C12",
    "font": {
      "family": [
        "Inter",
        "Fraunces"
      ]
    },
    "lines": [
      {
        "expr": "'Woodtype'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'Slow Press · Small Batch'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Bench No. 09')",
        "fallback": "Bench No. 09",
        "role": "detail"
      }
    ]
  }
}
