{
  "meta": {
    "id": "os-card-frame-v1",
    "name": "Card · Frame",
    "nameI18n": {
      "zh": "卡片·框线",
      "en": "Card · Frame"
    },
    "version": "0.3.0",
    "minEngineVersion": "0.1.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "classic-white"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.06,
      "bottom": 0.18,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#F7F5F0"
    }
  },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.024,
        "weight": 600,
        "color": "#2A2A2A"
      },
      "content": [
        {
          "expr": "exif.model_pretty",
          "fallback": "Unknown Camera"
        },
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.085
      }
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-center",
      "font": {
        "family": [
          "JetBrains Mono"
        ],
        "size": 0.015,
        "weight": 400,
        "color": "#7A7A74"
      },
      "content": [
        {
          "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
          "fallback": "framegeist"
        }
      ],
      "offset": {
        "x": 0,
        "y": -0.045
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.018
      },
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.012
      },
      "tint": "dark"
    }
  ]
}
