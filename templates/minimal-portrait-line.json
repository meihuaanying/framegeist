{
  "meta": {
    "id": "minimal-portrait-line",
    "name": "Portrait Line",
    "nameI18n": {
      "zh": "竖构图单行",
      "en": "Portrait Line"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.05,
      "right": 0.05,
      "bottom": 0.075,
      "left": 0.05
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#373A40",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "fmt('{model_pretty} — {focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
