{
  "meta": {
    "id": "borderless-right-roll-01",
    "name": "Right Roll",
    "nameI18n": {
      "zh": "右列参数",
      "en": "Right Roll"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "borderless"
  },
  "canvas": {
    "mode": "overlay"
  },
  "layers": [
    {
      "type": "text",
      "id": "model",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.055
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0192,
        "color": "auto",
        "weight": 500
      },
      "letterSpacing": 0.15,
      "opacity": 0.9,
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.03,
        "y": -0.055
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto",
      "attachTo": "model",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "roll",
      "anchor": "top-right",
      "offset": {
        "x": -0.03,
        "y": 0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0168,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "lineHeight": 1.55,
      "opacity": 0.88,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}MM', exif)",
          "fallback": null
        },
        {
          "expr": "fmt('F{aperture}', exif)",
          "fallback": null
        },
        {
          "expr": "exif.shutter",
          "fallback": null
        },
        {
          "expr": "fmt('ISO{iso}', exif)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.03,
        "y": -0.032
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0138,
        "color": "auto",
        "weight": 400
      },
      "letterSpacing": 0,
      "opacity": 0.8,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  }
}
