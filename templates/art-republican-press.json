{
  "meta": {
    "id": "art-republican-press",
    "name": "Republican Letterpress",
    "nameI18n": {
      "zh": "民国杂志铅字",
      "en": "Republican Letterpress"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.06,
      "bottom": 0.2,
      "left": 0.06
    },
    "background": {
      "type": "solid",
      "color": "#F5F1E8"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rep-red-block",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.02
      },
      "shape": "rect",
      "size": {
        "width": 0.045,
        "height": 0.008
      },
      "color": "#B3271E",
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "rep-red-rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.85
      },
      "shape": "line",
      "size": {
        "width": 0.1,
        "height": 0.003
      },
      "color": "#B3271E",
      "opacity": 1
    },
    {
      "type": "shape",
      "id": "rep-divider",
      "anchor": "middle-left",
      "offset": {
        "x": 0.385,
        "y": 0.414
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.16
      },
      "color": "#C9C2B4",
      "opacity": 1,
      "autoHide": true
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#23201B",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'拾光画报'",
        "fallback": null,
        "role": "display"
      },
      {
        "expr": "'一台旧相机，一卷慢风景；把光收进纸页，留给以后慢慢翻看。'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "'The Light Pictorial · Monthly'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
