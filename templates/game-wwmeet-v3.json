{
  "meta": {
    "id": "game-wwmeet-v3",
    "name": "Where Winds Meet · Poster Card",
    "nameI18n": {
      "zh": "燕云十六声 · 海报卡",
      "en": "Where Winds Meet · Poster Card"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "framegeist",
    "license": "CC0-1.0",
    "category": "game",
    "notice": "Unofficial fan-made design; game names and trademarks belong to their respective owners."
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.16,
      "right": 0.09,
      "bottom": 0.2,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#F4EFE6"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "game-mark",
      "asset": "@builtin/game/wwmeet",
      "size": {
        "height": 0.065
      },
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.05
      }
    },
    {
      "type": "image",
      "id": "brand",
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      }
    }
  ],
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#2B2B2B",
    "font": {
      "family": [
        "Bricolage Grotesque",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "exif.model_pretty · exif.lens",
        "fallback": "Camera",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm f/{aperture} {shutter} ISO{iso}', exif)",
        "fallback": "framegeist",
        "role": "detail"
      }
    ]
  }
}
