{
  "meta": {
    "id": "portfolio-marginalia-01",
    "name": "Marginal Notes",
    "nameI18n": {
      "zh": "左右侧注",
      "en": "Marginal Notes"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "portfolio"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.17,
      "bottom": 0.16,
      "left": 0.17
    },
    "background": {
      "type": "solid",
      "color": "#FAFAF8"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rail-left",
      "anchor": "middle-left",
      "offset": {
        "x": 0.115,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.62
      },
      "color": "#DAD5CB"
    },
    {
      "type": "shape",
      "id": "rail-right",
      "anchor": "middle-right",
      "offset": {
        "x": -0.127,
        "y": 0
      },
      "shape": "line",
      "size": {
        "width": 0.0012,
        "height": 0.62
      },
      "color": "#DAD5CB"
    },
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "top-right",
      "corner": "top-right",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#373A40",
    "font": {
      "family": [
        "Noto Serif SC",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'静物系列'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "'摄影 FrameGeist'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
