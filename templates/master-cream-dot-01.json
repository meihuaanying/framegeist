          "Inter"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.18,
      "content": [
        {
          "expr": "'FL'"
        }
      ]
    },
    {
      "type": "text",
