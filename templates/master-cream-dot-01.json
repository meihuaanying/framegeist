      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#E10600"
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.07265,
        "y": 0.03
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0132,
        "color": "#6B7280",
        "weight": 400
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07265,
        "y": -0.18
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0014
      },
      "color": "#E4E6EA"
    },
