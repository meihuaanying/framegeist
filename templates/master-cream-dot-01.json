{
  "meta": {
    "id": "master-cream-dot-01",
    "name": "Cream Dot",
    "nameI18n": {
      "zh": "奶油朱点",
      "en": "Cream Dot"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "master"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.085,
      "bottom": 0.3,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "reddot",
      "anchor": "top-right",
      "offset": {
        "x": -0.148,
        "y": 0.038
      },
      "shape": "ellipse",
      "size": {
        "width": 0.005,
        "height": 0.0067
      },
      "color": "#E10600"
    },
    {
      "type": "shape",
      "id": "rule",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07265,
        "y": -0.18
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0014
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "seal",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.07265,
        "y": -0.05
      },
      "asset": "@builtin/frame/seal-red",
      "size": {
        "height": 0.05
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'Signature'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "fmt('{focal}MM', exif)",
        "fallback": "--",
        "role": "support"
      },
      {
        "expr": "fmt('F{aperture}', exif)",
        "fallback": "--",
        "role": "support"
      }
    ]
  }
}
