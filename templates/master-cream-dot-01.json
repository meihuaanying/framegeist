{
  "meta": {
    "id": "master-cream-dot-01",
    "name": "Cream Dot",
    "nameI18n": {
      "zh": "奶油朱点",
      "en": "Cream Dot"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "master"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.085,
      "bottom": 0.3,
      "left": 0.085
