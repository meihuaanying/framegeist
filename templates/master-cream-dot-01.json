    "background": {
      "type": "solid",
      "color": "#FAF8F3"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "script",
      "anchor": "top-center",
      "offset": {
        "x": 0,
        "y": 0.07
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0264,
        "color": "#1A1A1A",
        "weight": 500
      },
      "align": "center",
      "content": [
        {
          "expr": "'Signature'"
        }
      ],
      "letterSpacing": 0
    },
    {
      "type": "shape",
      "id": "reddot",
      "anchor": "top-right",
      "offset": {
        "x": -0.148,
        "y": 0.038
