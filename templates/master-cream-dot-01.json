        "x": 0.07265,
        "y": -0.098
      },
      "font": {
        "family": [
          "Inter"
        ],
        "size": 0.0228,
        "color": "#1A1A1A",
        "weight": 500
      },
      "content": [
        {
          "expr": "fmt('{focal}MM', exif)",
          "fallback": "--"
        }
