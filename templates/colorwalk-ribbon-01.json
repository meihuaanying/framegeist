{
  "meta": {
    "id": "colorwalk-ribbon-01",
    "name": "Ink Ribbon",
    "nameI18n": {
      "zh": "墨色横带",
      "en": "Ink Ribbon"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "colorwalk"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.06,
      "bottom": 0.25,
      "left": 0.06
    },
    "background": {
      "type": "tint"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "band",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0536,
        "y": -0.06
      },
      "shape": "rect",
      "size": {
        "width": 1,
        "height": 0.13
      },
      "color": "#17181A",
      "opacity": 0.96,
      "radius": 0.045
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.082,
        "y": -0.1
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.weekday, 'UNDATED')",
        "fallback": "UNDATED",
        "role": "detail"
      }
    ]
  }
}
