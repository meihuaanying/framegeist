{
  "meta": {
    "id": "sports-ride-stats-01",
    "name": "Ride Stats",
    "nameI18n": {
      "zh": "骑行数据行",
      "en": "Ride Stats"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "sports"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.06,
      "right": 0.08,
      "bottom": 0.15,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-right",
      "offset": {
        "x": -0.069,
        "y": 0.0231
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "rule1",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.25,
        "y": -0.0661
      },
      "shape": "rect",
      "size": {
        "width": 0.0008,
        "height": 0.03
      },
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "rule2",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.47,
        "y": -0.0661
      },
      "shape": "rect",
      "size": {
        "width": 0.0008,
        "height": 0.03
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#373A40",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": "RIDE DAY",
        "role": "detail"
      },
      {
        "expr": "'AVG 32.6 KM/H'",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "'CLIMB 1250 M'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
