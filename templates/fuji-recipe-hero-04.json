{
  "meta": {
    "id": "fuji-recipe-hero-04",
    "name": "Recipe Hero",
    "nameI18n": {
      "zh": "奶白配方卡",
      "en": "Recipe Hero"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "fuji"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.09,
      "right": 0.08,
      "bottom": 0.36,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#F5F1E8"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "card",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.069,
        "y": -0.045
      },
      "shape": "rect",
      "size": {
        "width": 0.88,
        "height": 0.3
      },
      "color": "#FFFFFF"
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.08,
        "y": 0.028
      },
      "asset": "@builtin/brand/fujifilm",
      "size": {
        "height": 0.06
      }
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#17181A",
    "font": {
      "family": [
        "Geist",
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'VELVIA'",
        "fallback": "RECIPE",
        "role": "display"
      },
      {
        "expr": "exif.iso",
        "fallback": "200",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
