{
  "meta": {
    "id": "personal-avatar-ring-01",
    "name": "Avatar Ring",
    "nameI18n": {
      "zh": "头像圆环",
      "en": "Avatar Ring"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.085,
      "bottom": 0.3,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.015,
    "shadow": {
      "enabled": true,
      "blur": 0.05,
      "opacity": 0.15,
      "offsetX": 0,
      "offsetY": 0.012
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.07265,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "avatar",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.07265,
        "y": -0.105
      },
      "shape": "ellipse",
      "size": {
        "width": 0.075,
        "height": 0.099
      },
      "color": "#C4C9D0",
      "strokeWidth": 0.0018
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'YOUR NAME'",
        "fallback": "YOUR NAME",
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
