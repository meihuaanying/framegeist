{
  "meta": {
    "id": "calendar-split-columns-01",
    "name": "Split Calendar",
    "nameI18n": {
      "zh": "双栏日历",
      "en": "Split Calendar"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "calendar"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.08,
      "right": 0.08,
      "bottom": 0.3,
      "left": 0.08
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.045,
        "y": -0.2
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0015
      },
      "color": "#E4E6EA",
      "autoHide": true
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.045
      },
      "shape": "line",
      "size": {
        "width": 0.0015,
        "height": 0.165
      },
      "color": "#E0E0E0"
    },
    {
      "type": "calendar",
      "id": "daycard",
      "anchor": "bottom-center",
      "offset": {
        "x": -0.25,
        "y": -0.015
      },
      "size": 0.19,
      "dateSource": "exif",
      "year": 2026,
      "month": 9,
      "view": "day",
      "color": "#6B7280",
      "accent": "#1A1A1A",
      "fontFamily": [
        "Inter"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#373A40",
    "font": {
      "family": [
        "LXGW WenKai",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('YYYY年MM月DD日', exif.datetime)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "exif.weekday_cn",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      }
    ]
  }
}
