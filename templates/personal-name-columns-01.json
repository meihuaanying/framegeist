{
  "meta": {
    "id": "personal-name-columns-01",
    "name": "Name Columns",
    "nameI18n": {
      "zh": "三栏名录",
      "en": "Name Columns"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.09,
      "bottom": 0.3,
      "left": 0.09
    },
    "background": {
      "type": "solid",
      "color": "#F2F0EC"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "brand",
      "anchor": "top-left",
      "offset": {
        "x": 0.0763,
        "y": 0.026
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "shape",
      "id": "divider-a",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.37,
        "y": -0.093
      },
      "shape": "rect",
      "size": {
        "width": 0.0012,
        "height": 0.075
      },
      "color": "#E4E6EA"
    },
    {
      "type": "shape",
      "id": "divider-b",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.625,
        "y": -0.093
      },
      "shape": "rect",
      "size": {
        "width": 0.0012,
        "height": 0.075
      },
      "color": "#E4E6EA"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'YOUR NAME'",
        "fallback": "YOUR NAME",
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
