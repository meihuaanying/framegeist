{
  "meta": {
    "id": "film-mono-roll-06",
    "name": "Mono Roll",
    "nameI18n": {
      "zh": "机型卷轴",
      "en": "Mono Roll"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.09,
      "bottom": 0.1,
      "left": 0.28
    },
    "background": {
      "type": "solid",
      "color": "#0D0D0D"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "perf-right",
      "anchor": "middle-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/frame/film-strip-v",
      "size": {
        "width": 0.0825
      }
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "top-left",
      "offset": {
        "x": 0.045,
        "y": 0.16
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#EFE9DC",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'FG 100'",
        "fallback": "FILM",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      },
      {
        "expr": "exif.lens",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
