{
  "meta": {
    "id": "personal-polaroid-script-01",
    "name": "Polaroid Script",
    "nameI18n": {
      "zh": "拍立得题字",
      "en": "Polaroid Script"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "personal"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.12,
      "bottom": 0.32,
      "left": 0.12
    },
    "background": {
      "type": "solid",
      "color": "#FFFFFF"
    },
    "radius": 0.005,
    "shadow": {
      "enabled": true,
      "blur": 0.06,
      "opacity": 0.16,
      "offsetX": 0,
      "offsetY": 0.015
    }
  },
  "layers": [],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "center",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Great Vibes",
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'YOUR NAME'",
        "fallback": "YOUR NAME",
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "date('LOCAL', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
