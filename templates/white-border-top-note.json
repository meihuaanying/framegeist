{
  "meta": {
    "id": "white-border-top-note",
    "name": "Top Note",
    "nameI18n": {
      "zh": "顶部微注",
      "en": "Top Note"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "white-border"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.13,
      "right": 0.075,
      "bottom": 0.22,
      "left": 0.075
    },
    "background": {
      "type": "solid",
      "color": "#F2F0EC"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "hairline",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0652,
        "y": -0.125
      },
      "shape": "line",
      "size": {
        "width": 1,
        "height": 0.0016
      },
      "color": "#E4E6EA"
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "attachGap": 0.014
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.weekday, 'ARCHIVE FRAME')",
        "fallback": "ARCHIVE FRAME",
        "role": "detail"
      }
    ]
  }
}
