{
  "meta": {
    "id": "film-sprocket-02",
    "name": "Vertical Perfs",
    "nameI18n": {
      "zh": "竖齿孔",
      "en": "Vertical Perfs"
    },
    "version": "1.3.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.085,
      "bottom": 0.17,
      "left": 0.085
    },
    "background": {
      "type": "solid",
      "color": "#0E0E0E"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "perf-left",
      "anchor": "middle-left",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/frame/film-strip-v",
      "size": {
        "width": 0.0873
      }
    },
    {
      "type": "image",
      "id": "perf-right",
      "anchor": "middle-right",
      "offset": {
        "x": 0,
        "y": 0
      },
      "asset": "@builtin/frame/film-strip-v",
      "size": {
        "width": 0.0873
      }
    },
    {
      "type": "text",
      "id": "safety",
      "anchor": "top-left",
      "offset": {
        "x": 0.0727,
        "y": 0.03
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#7A756C",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'SAFETY FILM · 35MM'",
          "fallback": "FILM"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": {
        "x": -0.0727,
        "y": 0.03
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0132,
        "color": "#7A756C",
        "weight": 500
      },
      "letterSpacing": 0.12,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
          "fallback": "CAMERA"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0727,
        "y": -0.0787
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#8C877D",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    },
    {
      "type": "text",
      "id": "stock",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0727,
        "y": -0.0165
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0308,
        "color": "#EFE9DC",
        "weight": 500
      },
      "letterSpacing": 0.1,
      "content": [
        {
          "expr": "'FG 800'",
          "fallback": "FILM"
        }
      ]
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0727,
        "y": -0.0165
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachTo": "stock",
      "attachGap": 0.012
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.0727,
        "y": -0.0787
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#8C877D",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  }
}
