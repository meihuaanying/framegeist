{
  "meta": {
    "id": "camera-series-emblem-07",
    "name": "Series Emblem",
    "nameI18n": {
      "zh": "机身系列徽章",
      "en": "Series Emblem"
    },
    "version": "1.2.0",
    "minEngineVersion": "0.7.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.24,
      "right": 0.07,
      "bottom": 0.28,
      "left": 0.07
    },
    "background": {
      "type": "solid",
      "color": "#FBF8F1"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.04
      },
      "asset": "@builtin/frame/camera-body",
      "size": {
        "height": 0.17
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": {
        "x": -0.06,
        "y": 0.05
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0228,
        "color": "#1A1A1A",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "if_empty(exif.model_pretty, 'Camera')",
          "fallback": "Camera"
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-right",
      "offset": {
        "x": -0.06,
        "y": 0.085
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0144,
        "color": "#6B7280",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "exif.lens",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": {
        "x": -0.06,
        "y": 0.112
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.0132,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0,
      "align": "right",
      "content": [
        {
          "expr": "date('LOCAL', exif.datetime)",
          "fallback": null
        }
      ],
      "features": [
        "tnum"
      ]
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.115
      },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "series-label",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.085
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.012,
        "color": "#9AA0A6",
        "weight": 500
      },
      "letterSpacing": 0.2,
      "content": [
        {
          "expr": "'LENS SERIES'",
          "fallback": null
        }
      ]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.06,
        "y": -0.105
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.045
      },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": {
        "x": -0.06,
        "y": -0.05
      },
      "font": {
        "family": [
          "Geist Mono"
        ],
        "size": 0.015,
        "color": "#373A40",
        "weight": 500
      },
      "letterSpacing": 0.08,
      "align": "right",
      "content": [
        {
          "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
          "fallback": null
        }
      ]
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    }
  }
}
