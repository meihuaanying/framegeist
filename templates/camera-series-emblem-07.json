{
  "meta": {
    "id": "camera-series-emblem-07",
    "name": "Series Emblem",
    "nameI18n": { "zh": "机身系列徽章", "en": "Series Emblem" },
    "version": "1.0.0",
    "minEngineVersion": "0.4.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "camera"
  },
  "canvas": {
    "mode": "extend",
    "padding": { "top": 0.24, "right": 0.07, "bottom": 0.28, "left": 0.07 },
    "background": { "type": "solid", "color": "#FBF8F1" }
  },
  "layers": [
    {
      "type": "image",
      "id": "body",
      "anchor": "top-left",
      "offset": { "x": 0.06, "y": 0.040 },
      "asset": "@builtin/frame/camera-body",
      "size": { "height": 0.17 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "model",
      "anchor": "top-right",
      "offset": { "x": -0.06, "y": 0.050 },
      "font": { "family": ["Inter"], "size": 0.019, "color": "#1A1A1A" },
      "letterSpacing": 0.06,
      "align": "right",
      "content": [{ "expr": "if_empty(exif.model_pretty, 'Camera')", "fallback": "Camera" }]
    },
    {
      "type": "text",
      "id": "lens",
      "anchor": "top-right",
      "offset": { "x": -0.06, "y": 0.085 },
      "font": { "family": ["JetBrains Mono"], "size": 0.012, "color": "#6B7280" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "exif.lens", "fallback": null }]
    },
    {
      "type": "text",
      "id": "date",
      "anchor": "top-right",
      "offset": { "x": -0.06, "y": 0.112 },
      "font": { "family": ["JetBrains Mono"], "size": 0.011, "color": "#9AA0A6" },
      "letterSpacing": 0.12,
      "align": "right",
      "content": [{ "expr": "date('YYYY.MM.DD', exif.datetime)", "fallback": null }]
    },
    {
      "type": "image",
      "id": "series",
      "anchor": "bottom-left",
      "offset": { "x": 0.06, "y": -0.115 },
      "asset": "@builtin/series/{exif.lens_series}",
      "size": { "height": 0.060 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "series-label",
      "anchor": "bottom-left",
      "offset": { "x": 0.06, "y": -0.085 },
      "font": { "family": ["JetBrains Mono"], "size": 0.010, "color": "#9AA0A6" },
      "letterSpacing": 0.20,
      "content": [{ "expr": "'LENS SERIES'", "fallback": null }]
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-right",
      "offset": { "x": -0.06, "y": -0.105 },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": { "height": 0.016 },
      "tint": "auto"
    },
    {
      "type": "text",
      "id": "params",
      "anchor": "bottom-right",
      "offset": { "x": -0.06, "y": -0.050 },
      "font": { "family": ["JetBrains Mono"], "size": 0.0125, "color": "#373A40" },
      "letterSpacing": 0.04,
      "align": "right",
      "content": [{ "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)", "fallback": null }]
    }
  ],
  "fields": {
    "model": { "type": "string", "source": "exif", "transform": "model_pretty" },
    "params": { "type": "string", "source": "exif" }
  }
}
