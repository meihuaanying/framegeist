{
  "meta": {
    "id": "magazine-gallery-left-01",
    "name": "Gallery Column",
    "nameI18n": {
      "zh": "左文画廊",
      "en": "Gallery Column"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "magazine"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.12,
      "right": 0.08,
      "bottom": 0.15,
      "left": 0.34
    },
    "background": {
      "type": "solid",
      "color": "#F7F4EE"
    }
  },
  "layers": [
    {
      "type": "shape",
      "id": "rule",
      "anchor": "top-left",
      "offset": {
        "x": 0.0493,
        "y": 0.21
      },
      "shape": "line",
      "size": {
        "width": 0.26,
        "height": 0.0016
      },
      "color": "#1A1A1A",
      "opacity": 0.7
    },
    {
      "type": "image",
      "id": "brand",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.0493,
        "y": -0.0709
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto"
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "'THE QUIET' · 'FRAME'",
        "fallback": null,
        "role": "support"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'Unknown Camera')",
        "fallback": "Camera",
        "role": "detail"
      },
      {
        "expr": "'A study of light, glass and' · 'patient seeing — one frame,' · 'held still until the world' · 'agrees to stand quietly.'",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
