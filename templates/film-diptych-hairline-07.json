{
  "meta": {
    "id": "film-diptych-hairline-07",
    "name": "Diptych Hairline",
    "nameI18n": {
      "zh": "双联细线",
      "en": "Diptych Hairline"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "film"
  },
  "canvas": {
    "mode": "extend",
    "padding": {
      "top": 0.1,
      "right": 0.075,
      "bottom": 0.2,
      "left": 0.075
    },
    "background": {
      "type": "solid",
      "color": "#F5F0E8"
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "edgecode",
      "anchor": "top-left",
      "offset": {
        "x": 0.06,
        "y": 0.032
      },
      "asset": "@builtin/frame/film-edge",
      "size": {
        "width": 0.45
      },
      "opacity": 0.5
    },
    {
      "type": "shape",
      "id": "divider",
      "anchor": "bottom-center",
      "offset": {
        "x": 0,
        "y": -0.132
      },
      "shape": "line",
      "size": {
        "width": 0.86,
        "height": 0.0015
      },
      "color": "#D8D2C6"
    },
    {
      "type": "image",
      "id": "brandmark",
      "anchor": "bottom-left",
      "offset": {
        "x": 0.06,
        "y": -0.0069
      },
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "attachGap": 0.012
    },
    {
      "type": "shape",
      "id": "split",
      "anchor": "middle-center",
      "offset": {
        "x": 0,
        "y": -0.0385
      },
      "shape": "line",
      "size": {
        "width": 0.0015,
        "height": 1
      },
      "color": "#1A1A1A",
      "opacity": 0.28
    }
  ],
  "fields": {
    "model": {
      "type": "string",
      "source": "exif",
      "transform": "model_pretty"
    },
    "params": {
      "type": "string",
      "source": "exif"
    },
    "date": {
      "type": "string",
      "source": "exif"
    },
    "stock": {
      "type": "string",
      "source": "constant"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "left",
    "color": "#1A1A1A",
    "font": {
      "family": [
        "Geist Mono"
      ]
    },
    "lines": [
      {
        "expr": "'FG 200'",
        "fallback": "FILM",
        "role": "support"
      },
      {
        "expr": "fmt('{focal}mm · f/{aperture} · {shutter} · ISO{iso}', exif)",
        "fallback": null,
        "role": "detail"
      },
      {
        "expr": "if_empty(exif.model_pretty, 'UNKNOWN CAMERA')",
        "fallback": "CAMERA",
        "role": "detail"
      }
    ]
  }
}
