{
  "meta": {
    "id": "minimal-copyright",
    "name": "Quiet Copyright",
    "nameI18n": {
      "zh": "仅版权微字",
      "en": "Quiet Copyright"
    },
    "version": "1.4.0",
    "minEngineVersion": "1.0.0",
    "author": "FrameGeist",
    "license": "CC0-1.0",
    "category": "minimal"
  },
  "canvas": {
    "mode": "extend",
    "background": {
      "type": "solid",
      "color": "#101418"
    },
    "padding": {
      "bottom": 0.26
    }
  },
  "layers": [
    {
      "type": "image",
      "id": "v7-brand-badge",
      "anchor": "bottom-left",
      "corner": "bottom-left",
      "margin": 0.035,
      "asset": "@builtin/brand/{exif.brand_slug}",
      "size": {
        "height": 0.06
      },
      "tint": "auto",
      "contrast": "auto",
      "z": 100
    }
  ],
  "fields": {
    "date": {
      "type": "string",
      "source": "exif"
    }
  },
  "infoBlock": {
    "side": "bottom",
    "align": "right",
    "color": "auto",
    "font": {
      "family": [
        "Inter"
      ]
    },
    "lines": [
      {
        "expr": "date('(C) YYYY', exif.datetime)",
        "fallback": null,
        "role": "detail"
      }
    ]
  }
}
